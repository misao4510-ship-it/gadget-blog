# Pinterest API v5 認証設定 (cmd_207)
# https://developers.pinterest.com/docs/api/v5/ でDeveloper Appを登録後に設定
#
# OAuth2トークン取得手順:
#   1. https://developers.pinterest.com/ でアプリを作成
#   2. OAuth2フローでアクセストークンを取得
#   3. 以下に貼り付ける
#
# ボードIDの確認方法:
#   python3 scripts/pinterest_post.py --list-boards --no-delay
#   (PINTEREST_ACCESS_TOKENを設定後に実行)

PINTEREST_ACCESS_TOKEN=
PINTEREST_REFRESH_TOKEN=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# ボードID設定（python3 scripts/pinterest_post.py --list-boards で確認）
PINTEREST_DEFAULT_BOARD_ID=

# カテゴリ別ボードID（省略時はDEFAULT_BOARD_IDを使用）
