---
const currentPath = Astro.url.pathname;
// /en/ または /zh/ プレフィックスを除去してベースパスを取得
const basePath = currentPath.replace(/^\/(en|zh)(\/|$)/, '/');
const isJa = !currentPath.match(/^\/(en|zh)(\/|$)/);
const isEn = currentPath.startsWith('/en');
const isZh = currentPath.startsWith('/zh');
---
<div class="lang-switcher">
  <a href={basePath} class:list={['lang-btn', { active: isJa }]} aria-label="日本語">🇯🇵 JP</a>
  <a href={`/en${basePath === '/' ? '' : basePath}`} class:list={['lang-btn', { active: isEn }]} aria-label="English">🇺🇸 EN</a>
  <a href={`/zh${basePath === '/' ? '' : basePath}`} class:list={['lang-btn', { active: isZh }]} aria-label="中文">🇨🇳 ZH</a>
</div>
<style>
  .lang-switcher { display: flex; gap: .4rem; align-items: center; }
  .lang-btn {
    font-size: .75rem; font-weight: 700; padding: .25rem .55rem;
    border-radius: 6px; text-decoration: none !important;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    transition: background .15s, color .15s;
  }
  .lang-btn:hover { background: var(--color-primary-light); color: var(--color-primary-dark); }
  .lang-btn.active { background: var(--color-primary); color: #fff; border-color: var(--color-primary); }
</style>
