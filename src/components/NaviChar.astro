        '選んで正解だったと思える理由がここにありますよ。',
      ],
      demerit: [
        '気になるデメリット、正直にお伝えしますね。',
        '事前に知っておくと後悔のない買い物ができますよ。',
        'この点、使い方次第で気にならなくなることも多いですよ。',
        '購入前に許容できるか確認しておきましょう。',
        'デメリットと上手く付き合う工夫も一緒に探してみてください。',
        '他の製品も同じ課題を持っていることが多いですよ。',
        '使用環境によって影響の大きさが変わることもありますよ。',
        'メリットと比べて、トータルでどうかが大切ですよ。',
        '改善策や周辺アイテムでカバーできることもありますよ。',
        'どんな製品も完璧ではないので、優先順位を決めて選ぶといいですよ。',
      ],
      review: [
        '実際に使った人の声は、とても参考になりますよ。',
        'スペック表だけでは分からないことが、ここに書かれていますよ。',
        '使い始めの印象と数週間後の評価、両方チェックしてみてください。',
        '自分の使い方に近いレビュアーの意見が特に参考になりますよ。',
        '星の数だけでなく、コメント内容もしっかり読んでみてください。',
        'ネガティブなレビューも大切な情報源ですよ。',
        '複数のレビューを見比べると、より正確な評価が見えてきますよ。',
        '長期レビューは特に信頼性が高いですよ。',
        'レビュー数が多いほど、評価の精度も上がりますよ。',
        'この製品、使ってみたくなってきませんか？',
      ],
      ranking: [
        'ランキング上位には、それだけの理由がありますよ。',
        '多くの方に支持されている理由、気になりますよね。',
        '自分の用途と予算に合った順位の製品を探してみてください。',
        'ランキングの選出基準も一緒に確認してみてください。',
        '同価格帯の中でも特におすすめの製品ですよ。',
        '口コミ数が多いほど、評価の信頼性も高まりますよ。',
        '時期によってランキングが変わることもあるので、最新情報も確認してみてください。',
        '上位製品はアフターサポートも充実していることが多いですよ。',
        '1位と2位の差、ぜひ詳しく比べてみてください。',
        '自分にぴったりの1台が見つかることを願っていますよ。',
      ],
      default: [
        'ここまで読んでいただき、ありがとうございますよ！',
        '気になる製品は比較検討してから選ぶといいですよ。',
        '購入後に後悔しないよう、じっくり検討してくださいね。',
        'わからないことがあれば、公式サイトも確認してみてください。',
        'サクラをタップするたびにヒントをお伝えしますよ！',
        'ぜひ記事全体を通して参考にしてみてください。',
        'お気に入りのガジェットが見つかりますように！',
        '迷ったときは、用途を整理して考えてみてください。',
        '最終的には自分の直感も大切にしてみてください。',
        '良いお買い物になることを応援していますよ！',
      ],
    };

    // ── キーワード抽出ユニークコメント生成 (subtask_029d) ──────────────

    /** 見出しの次の兄弟要素群（最大5個）のinnerTextを結合して返す */
    function getSectionText(heading: Element): string {
      let text = '';
      let el = heading.nextElementSibling;
      let count = 0;
      while (el && !['H2', 'H3'].includes(el.tagName) && count < 5) {
        text += (el as HTMLElement).innerText + ' ';
        el = el.nextElementSibling;
        count++;
      }
      return text;
    }

    /** セクション本文テキストから数値・ブランド・規格名を抽出 */
    function extractKeywords(text: string) {
      const valueMatches = [...text.matchAll(/([0-9,]+(?:\.[0-9]+)?)\s*(mAh|Wh|W|V|A|GB|TB|MHz|GHz|kg|g|mm|cm|m)/g)];
      const priceMatches = [...text.matchAll(/([0-9,]+)円/g)];
      const brandList = ['Anker', 'Apple', 'Samsung', 'Sony', 'Panasonic', 'Sharp', 'バンブー', 'Bambu'];
      const standardList = ['USB-C', 'USB-A', 'USB4', 'Qi', 'MagSafe', 'Wi-Fi 6', 'Bluetooth 5'];
      return {
        values: valueMatches.map((m) => m[1] + m[2]),
        prices: priceMatches.map((m) => m[1] + '円'),
        brands: brandList.filter((b) => text.includes(b)),
        standards: standardList.filter((s) => text.includes(s)),
      };
    }

    /** セクション種別とキーワードを組み合わせてユニークコメントを生成。失敗時はnull */
    function generateUniqueComment(
      sectionType: string,
      kw: ReturnType<typeof extractKeywords>
    ): string | null {
      const pick = <T>(arr: T[]): T => arr[Math.floor(Math.random() * arr.length)];
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      if (sectionType === 'price' && kw.prices.length > 0) {
        return isDark
          ? pick([
              `${kw.prices[0]}…コスパ◎…ですよ…zzz`,
              `${kw.prices[0]}…この品質で…この価格…買い…ですよ…ふぁ`,
              `${kw.prices[0]}…今が…買い時…zzz`,
            ])
          : pick([
              `${kw.prices[0]}ならコスパ◎ですよ！`,
              `${kw.prices[0]}、この品質でこの価格は買いですよ！`,
              `${kw.prices[0]}、今が買い時ですよ！`,
            ]);
      }
      if (kw.prices.length > 0) {
        return isDark
          ? pick([
              `${kw.prices[0]}…コスパ◎…zzz`,
              `${kw.prices[0]}…この品質で…この価格…いいですよ…ふぁ`,
            ])
          : pick([
              `${kw.prices[0]}ならコスパ◎ですよ！`,
              `${kw.prices[0]}、この品質でこの価格は買いですよ！`,
            ]);
      }
      if (kw.values.length > 0) {
        return isDark
          ? pick([
              `${kw.values[0]}…他と比べて…優秀…ですよ…zzz`,
              `${kw.values[0]}…なかなかの…数値…ですよね…ふぁ`,
              `${kw.values[0]}…実用…十分…zzz`,
            ])
          : pick([
              `${kw.values[0]}というスペック、他製品と比べて優秀ですよ！`,
              `${kw.values[0]}、なかなかの数値ですよね！`,
              `${kw.values[0]}なら実用十分ですよ！`,
            ]);
      }
      if (kw.brands.length > 0) {
        return isDark
          ? pick([
              `${kw.brands[0]}製…安心…ですよ…zzz`,
              `${kw.brands[0]}の…クオリティ…さすが…ふぁ〜`,
            ])
          : pick([
              `${kw.brands[0]}製なら安心して使えますよ！`,
              `${kw.brands[0]}のクオリティ、さすがですよね！`,
            ]);
      }
      if (kw.standards.length > 0) {
        return isDark
          ? pick([
              `${kw.standards[0]}対応…将来性◎…ですよ…zzz`,
              `${kw.standards[0]}…高速転送…快適…ふぁ`,
            ])
          : pick([
              `${kw.standards[0]}対応、最新規格で将来性◎ですよ！`,
              `${kw.standards[0]}なら高速転送も快適ですよ！`,
            ]);
      }
      return null;
    }

    /** 見出しテキストからセクション種別文字列を返す */
    function detectSectionType(headingText: string): string {
      const lower = headingText.toLowerCase();
      if (['価格', '値段', 'コスパ', '価格比較', '最安値', '円'].some((k) => lower.includes(k.toLowerCase()))) return 'price';
      if (['スペック', '仕様', 'spec', '基本情報', '製品情報'].some((k) => lower.includes(k.toLowerCase()))) return 'spec';
      if (['メリット', '良い点', 'おすすめポイント', '強み'].some((k) => lower.includes(k.toLowerCase()))) return 'merit';
      if (['デメリット', '注意点', '気になる点', '弱点'].some((k) => lower.includes(k.toLowerCase()))) return 'demerit';
      return 'other';
    }

    function getActiveSectionTemplates() {
      const theme = document.documentElement.getAttribute('data-theme');
      return theme === 'dark' ? darkSectionTemplates : sectionTemplates;
    }

    function getActiveDefaultMessages() {
      const theme = document.documentElement.getAttribute('data-theme');
      return theme === 'dark' ? darkDefaultMessages : defaultMessages;
    }

    function detectSectionComment(text: string): string | null {
      const lower = text.toLowerCase();
      const templates = getActiveSectionTemplates();
      for (const section of templates) {
        for (const kw of section.keywords) {
          if (lower.includes(kw.toLowerCase())) {
            const idx = Math.floor(Math.random() * section.templates.length);
            return section.templates[idx];
          }
        }
      }
      return null;
    }

    // テーマに応じたコメントプール取得
    function getActivePool(sectionType: string): string[] {
      const theme = document.documentElement.getAttribute('data-theme');
      const pool = theme === 'dark' ? darkTapCommentPool : tapCommentPool;
      return pool[sectionType] ?? pool.default;
    }

    // 自動タイマー設定
    const AUTO_INTERVAL_MS = 4000;
    let autoTimer: ReturnType<typeof setInterval> | null = null;

    function startAutoTimer() {
      stopAutoTimer();
      autoTimer = setInterval(() => {
        const pool = getActivePool(currentSectionType);
        tapIndex = (tapIndex + 1) % pool.length;
        currentMsg = '';
        setMessage(pool[tapIndex]);
      }, AUTO_INTERVAL_MS);
    }

    function stopAutoTimer() {
      if (autoTimer !== null) {
        clearInterval(autoTimer);
        autoTimer = null;
      }
    }

    let defaultMsgIdx = 0;
    let currentMsg = '';
    let fadeTimer: ReturnType<typeof setTimeout> | null = null;
    let currentSectionType = 'default';
    let tapIndex = 0;

    function setMessage(msg: string) {
      if (msg === currentMsg) return;
      currentMsg = msg;
      if (fadeTimer) clearTimeout(fadeTimer);
      speechBubble.classList.add('fade-out');
      fadeTimer = setTimeout(() => {
        speechText.textContent = msg;
        speechBubble.classList.remove('fade-out');
      }, 350);
    }

    // 表示/非表示の初期化
    function init() {
      if (sessionStorage.getItem(STORAGE_KEY) === '1') {
        (wrapper as HTMLElement).style.display = 'none';
        (reopenBtn as HTMLElement).style.display = 'block';
      } else {
        (wrapper as HTMLElement).style.display = '';
        (reopenBtn as HTMLElement).style.display = 'none';
        setupObserver();
        startAutoTimer();
      }
    }

    // 閉じるボタン
    closeBtn.addEventListener('click', () => {
      stopAutoTimer();
      (wrapper as HTMLElement).style.display = 'none';
      (reopenBtn as HTMLElement).style.display = 'block';
      sessionStorage.setItem(STORAGE_KEY, '1');
    });

    // 再表示ボタン
    reopenBtn.addEventListener('click', () => {
      (wrapper as HTMLElement).style.display = '';
      (reopenBtn as HTMLElement).style.display = 'none';
      sessionStorage.removeItem(STORAGE_KEY);
      setupObserver();
      startAutoTimer();
    });

    // IntersectionObserver でセクション検知
    function setupObserver() {
      // data-sakura-comment属性を持つ要素（明示的指定、最優先）
      const explicitTargets = document.querySelectorAll<HTMLElement>('[data-sakura-comment]');

      // 観測対象: Element → message | null (nullはh2動的生成)
      const observed = new Map<Element, string | null>();

      // 明示的属性を優先登録
      explicitTargets.forEach((el) => {
        const comment = el.getAttribute('data-sakura-comment');
        if (comment) observed.set(el, comment);
      });

      // h2/h3要素を観測対象に追加（セクション種別動的判定）
      const h2Elements = document.querySelectorAll<HTMLElement>('h2, h3');
      h2Elements.forEach((h) => {
        if (!observed.has(h)) {
          observed.set(h, null); // null = テキストから動的生成
        }
      });

      // h2もexplicitもなければセクションセレクタフォールバック
      if (observed.size === 0) {
        const sectionMap: Array<{ selector: string; msg: string }> = [
          { selector: '.hero, [data-section="hero"], header', msg: getSectionMessage('hero') },
          { selector: '[data-section="ranking"], .ranking-section, #ranking', msg: getSectionMessage('ranking') },
          { selector: '[data-section="sale"], .sale-section, #sale', msg: getSectionMessage('sale') },
          { selector: '[data-section="review"], .review-section, #review', msg: getSectionMessage('review') },
        ];
        sectionMap.forEach(({ selector, msg }) => {
          try {
            const el = document.querySelector(selector);
            if (el && !observed.has(el)) observed.set(el, msg);
          } catch (_) {}
        });
      }

      // 初期メッセージ（テーマ対応）
      setMessage(getSectionMessage('hero'));

      if (observed.size === 0) return;

      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const stored = observed.get(entry.target);
            let msg: string;
            if (stored !== null && stored !== undefined) {
              // 明示メッセージまたはセクションマップ（最優先）
              msg = stored;
            } else if (entry.target.tagName === 'H2' || entry.target.tagName === 'H3') {
              // セクション本文からキーワード抽出→ユニークコメント生成 (subtask_029d)
              const headingText = (entry.target as HTMLElement).textContent?.trim() ?? '';
              const sectionType = detectSectionType(headingText);
              currentSectionType = sectionType;
              stopAutoTimer();
              tapIndex = 0;
              startAutoTimer();
              // h2テキストが変わるたびに必ず更新されるようcurrentMsgをリセット
              currentMsg = '';
              const bodyText = getSectionText(entry.target);
              const kw = extractKeywords(bodyText);
              const uniqueComment = generateUniqueComment(sectionType, kw);
              // h2テキストを短縮してコメントに組み込む（必ずユニークにする）
              const headingShort = headingText.length > 18 ? headingText.slice(0, 18) + '…' : headingText;
              if (uniqueComment) {
                msg = uniqueComment;
              } else {
                const sectionComment = headingText ? detectSectionComment(headingText) : null;
                if (sectionComment) {
                  msg = sectionComment;
                } else if (headingText) {
                  // h2テキストを直接組み込んでユニークコメント生成（確実に変化させる）
                  const isDarkFb = document.documentElement.getAttribute('data-theme') === 'dark';
                  msg = isDarkFb
                    ? `「${headingShort}」…のセクション…ですよ…zzz`
                    : `「${headingShort}」のセクションです。ぜひ参考にしてみてください！`;
                } else {
                  // セクション不明: デフォルトメッセージを循環
                  const dms = getActiveDefaultMessages();
                  msg = dms[defaultMsgIdx % dms.length];
                }
              }
            } else {
              const dms = getActiveDefaultMessages();
              msg = dms[defaultMsgIdx % dms.length];
            }
            defaultMsgIdx++;
            setMessage(msg);
          });
        },
        {
          threshold: 0.1,
          rootMargin: '0px 0px 0px 0px',
        }
      );

      observed.forEach((_, el) => io.observe(el));

      // 30秒ごとにデフォルトメッセージを循環（特定セクション非検知時）
      setInterval(() => {
        const dms = getActiveDefaultMessages();
        if (dms.includes(currentMsg) || defaultMessages.includes(currentMsg) || darkDefaultMessages.includes(currentMsg)) {
          const next = dms[defaultMsgIdx % dms.length];
          defaultMsgIdx++;
          setMessage(next);
        }
      }, 30000);
    }

    // サクラ画像タップ/クリックでコメント切り替え (subtask_029f)
    const sakuraImg = wrapper.querySelector<HTMLImageElement>('.navi-char-img');
    if (sakuraImg) {
      sakuraImg.addEventListener('click', () => {
        stopAutoTimer();
        const pool = getActivePool(currentSectionType);
        tapIndex = (tapIndex + 1) % pool.length;
        // setMessageの重複スキップを回避するため一時的にcurrentMsgをクリア
        currentMsg = '';
        setMessage(pool[tapIndex]);
        // タップで立ち絵も切り替え
        cycleNaviImage();
        startAutoTimer();
      });
    }

    // テーマ別立ち絵切り替え
    let darkImageIndex = 0;
    let lightImageIndex = 0;
    const naviImg = wrapper.querySelector<HTMLImageElement>('.navi-char-img');
    const darkImages = (naviImg?.dataset.darkSrc ?? '').split(',').filter(Boolean);
    const lightImages = (naviImg?.dataset.lightSrc ?? '').split(',').filter(Boolean);

    function updateNaviImage() {
      if (!naviImg) return;
      const theme = document.documentElement.getAttribute('data-theme');
      const src = theme === 'dark'
        ? (darkImages[darkImageIndex % darkImages.length] ?? lightImages[0])
        : (lightImages[lightImageIndex % lightImages.length] ?? lightImages[0]);
      if (src && naviImg.src !== new URL(src, location.href).href) naviImg.src = src;
    }

    // タップで立ち絵切り替え（ライト/ダーク両対応）
    function cycleNaviImage() {
      const theme = document.documentElement.getAttribute('data-theme');
      if (theme === 'dark' && darkImages.length > 1) {
        darkImageIndex = (darkImageIndex + 1) % darkImages.length;
      } else if (theme !== 'dark' && lightImages.length > 1) {
        lightImageIndex = (lightImageIndex + 1) % lightImages.length;
      }
      updateNaviImage();
    }

    // テーマ変更を監視
    const themeObserver = new MutationObserver(() => updateNaviImage());
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    updateNaviImage();

    init();
  })();
</script>
