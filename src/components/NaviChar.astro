---
// src/components/NaviChar.astro
// カイナ: スクロール追従、右下固定表示
---

<div class="navi-char-wrapper" id="navi-char">
  <img
    src="/images/navi-char.png"
    alt="カイナ"
    class="navi-char-img"
    loading="lazy"
    decoding="async"
  />
</div>

<style>
  .navi-char-wrapper {
    position: fixed;
    bottom: 20px;
    right: 20px;
    z-index: 100;
    width: 160px;
    pointer-events: none;
  }

  .navi-char-img {
    width: 100%;
    height: auto;
    display: block;
    /* 登場アニメーション */
    animation: navi-appear 0.5s ease-out;
  }

  @keyframes navi-appear {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* モバイル: 小サイズ右下固定（768px以下） */
  @media (max-width: 768px) {
    .navi-char-wrapper {
      width: 110px;
      bottom: 80px;
      right: 10px;
      opacity: 0.90;
    }
  }

  /* タブレット: 小さく表示（769px〜1024px） */
  @media (min-width: 769px) and (max-width: 1024px) {
    .navi-char-wrapper {
      width: 110px;
      bottom: 15px;
      right: 15px;
    }
  }
</style>
