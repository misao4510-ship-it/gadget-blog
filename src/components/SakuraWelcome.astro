---
---
<div id="sakura-welcome" class="sakura-overlay">
  <div class="sakura-overlay-inner">
    <button id="sakura-welcome-close" class="sakura-close-btn" aria-label="閉じる">×</button>
    <div class="sakura-bubble" id="sakura-bubble-text"></div>
    <img src="/images/sakura-welcome.png" alt="サクラ" class="sakura-overlay-img" loading="lazy" />
    <label class="sakura-skip-label">
      <input type="checkbox" id="sakura-skip-today" />
      本日は表示しない
    </label>
  </div>
</div>

<style>
  .sakura-overlay {
    display: none; /* JSが実行されるまでレンダリングしない */
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    align-items: center;
    justify-content: center;
    z-index: 9999;
    opacity: 0;
    transition: opacity 0.8s ease;
  }
  .sakura-overlay.visible {
    display: flex;
    opacity: 1;
    pointer-events: auto;
  }

  .sakura-overlay-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 400px;
    width: 90%;
  }

  .sakura-close-btn {
    position: absolute;
    top: -40px;
    right: 0;
    background: rgba(255,255,255,0.9);
    border: none;
    border-radius: 50%;
    width: 36px; height: 36px;
    font-size: 20px;
    cursor: pointer;
    line-height: 1;
    color: #333;
  }

  .sakura-bubble {
    background: #ffffff !important;
    color: #333333 !important;
    border: 2px solid #ffb7c5;
    border-radius: 16px;
    padding: 14px 20px;
    margin-bottom: 16px;
    font-size: 15px;
    line-height: 1.6;
    text-align: center;
    box-shadow: 0 4px 16px rgba(0,0,0,0.15);
    position: relative;
  }
  .sakura-bubble::after {
    content: '';
    position: absolute;
    bottom: -12px;
    left: 50%;
    transform: translateX(-50%);
    border: 6px solid transparent;
    border-top-color: #ffb7c5;
  }

  .sakura-overlay-img {
    height: 580px;
    width: auto;
    display: block;
    filter: drop-shadow(0 8px 24px rgba(0,0,0,0.3));
  }

  .sakura-skip-label {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 10px;
    font-size: 12px;
    color: rgba(255,255,255,0.8);
    cursor: pointer;
    user-select: none;
  }
  .sakura-skip-label input[type="checkbox"] {
    width: 14px;
    height: 14px;
    accent-color: #ffb7c5;
    cursor: pointer;
  }

  [data-theme=dark] .sakura-skip-label {
    color: rgba(255,255,255,0.7);
  }

  @media (max-width: 640px) {
    .sakura-overlay-img { height: 340px; }
    .sakura-bubble { font-size: 13px; padding: 10px 14px; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // トップページ(/)のみ表示
    if (window.location.pathname !== '/') return;

    const STORAGE_KEY = 'sakura_skip_date';
    const today = new Date().toISOString().slice(0, 10); // YYYY-MM-DD
    if (localStorage.getItem(STORAGE_KEY) === today) return;

    const messages = [
      'こんにちは！サクラです✨<br>ゆっくり見ていってね！',
      'いらっしゃい！今日もいいガジェット見つけよう✨',
      'あ、来てくれたんだ！嬉しい～♪',
      'こんにちは！気になる商品あったら教えてね！',
      '今日のおすすめ、チェックしていってね✨',
      'やっほー！サクラだよ♪ ゆっくりしていってね！',
      'お買い物のヒント、見つかるといいな✨',
      'いらっしゃいませ！サクラがご案内しますね♪',
      '今日も来てくれてありがとう✨',
      'こんにちは！新しいレビュー書いたよ、見てね♪',
    ];

    const el = document.getElementById('sakura-welcome');
    const bubble = document.getElementById('sakura-bubble-text');
    const skipCheckbox = document.getElementById('sakura-skip-today') as HTMLInputElement | null;
    if (!el || !bubble) return;

    bubble.innerHTML = messages[Math.floor(Math.random() * messages.length)];

    setTimeout(() => {
      el.style.display = 'flex';
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          el.classList.add('visible');
        });
      });
    }, 300);

    const timer = setTimeout(() => dismiss(), 10300);

    function dismiss() {
      clearTimeout(timer);
      el.classList.remove('visible');
      setTimeout(() => { el.style.display = 'none'; }, 800);
      if (skipCheckbox?.checked) {
        localStorage.setItem(STORAGE_KEY, today);
      }
    }

    document.getElementById('sakura-welcome-close')?.addEventListener('click', dismiss);
    el.addEventListener('click', (e) => {
      if (e.target === el) dismiss();
    });
  });
</script>
