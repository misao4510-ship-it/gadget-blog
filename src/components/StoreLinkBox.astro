---
interface Props { productId: string; }
const { productId } = Astro.props;
const { products } = await import('../../data/products.json');
const product = products.find(p => p.id === productId);
if (!product) return;

const productImage = product?.image ?? null;
const productName = product?.name ?? productId;
const amazonUrl = product.affiliate_links?.amazon?.url ?? product.affiliate_links?.amazon?.url_template?.replace('{asin}', product.asin).replace('{tag}', product.affiliate_links?.amazon?.tag) ?? '#';
const rakutenUrl = product.affiliate_links?.rakuten?.url ?? '#';
---
<div class="store-link-box">
  <div class="store-link-box__header">
    {productImage && (
      <img src={productImage} alt={productName} class="store-link-box__img" width="80" height="80" loading="lazy" />
    )}
    <div class="store-link-box__info">
      <p class="store-link-box__name">{productName}</p>
      <p class="store-link-box__micro-top">送料無料・ポイント還元あり</p>
    </div>
  </div>
  <div class="store-link-box__buttons">
    <a href={amazonUrl} rel="nofollow sponsored" target="_blank" class="store-btn store-btn--amazon">
      Amazonで最新価格をチェック
    </a>
    <a href={rakutenUrl} rel="nofollow sponsored" target="_blank" class="store-btn store-btn--rakuten">
      楽天市場で見る
    </a>
  </div>
  <p class="store-link-box__micro-bottom">※ 価格は変動します。リンク先で最新価格をご確認ください</p>
</div>

<style>
  .store-link-box {
    background: var(--color-surface);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
    margin: 1.5rem 0;
  }
  .store-link-box__header {
    display: flex; align-items: center; gap: .75rem;
    margin-bottom: 1rem;
  }
  .store-link-box__img {
    width: 64px; height: 64px; object-fit: contain;
    border-radius: var(--radius); background: var(--color-surface-raised);
    flex-shrink: 0;
  }
  .store-link-box__info { flex: 1; }
  .store-link-box__name {
    font-size: .95rem; font-weight: 700; color: var(--color-text);
    margin: 0 0 .2rem; line-height: 1.3;
  }
  .store-link-box__micro-top {
    font-size: .75rem; color: var(--color-cheapest); font-weight: 600; margin: 0;
  }
  .store-link-box__buttons {
    display: flex; flex-direction: column; gap: .5rem;
  }
  .store-btn {
    display: block; text-align: center; padding: .75rem 1rem;
    border-radius: var(--radius); font-weight: 700; font-size: .9rem;
    text-decoration: none; transition: opacity .15s, transform .1s;
  }
  .store-btn:hover { opacity: .9; transform: translateY(-1px); }
  .store-btn:active { transform: translateY(0); }
  .store-btn--amazon {
    background: #22c55e; color: white;
  }
  .store-btn--rakuten {
    background: #dc2626; color: white;
  }
  .store-link-box__micro-bottom {
    font-size: .7rem; color: var(--color-text-muted);
    text-align: center; margin: .75rem 0 0;
  }
  @media (min-width: 480px) {
    .store-link-box__buttons {
      flex-direction: row;
    }
    .store-btn { flex: 1; }
  }
</style>
