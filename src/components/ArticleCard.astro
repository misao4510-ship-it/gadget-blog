---
interface Props {
  title: string;
  description: string;
  slug: string;
  category: string;
  publishDate: string;
  ogImage?: string;
  type: string;
}
const { title, description, slug, category, publishDate, ogImage = '/images/og-default.svg', type } = Astro.props;
const typeLabels: Record<string, string> = {
  review: 'レビュー', comparison: '比較', roundup: 'まとめ'
};
const categoryLabels: Record<string, string> = {
  'mobile-battery': 'モバイルバッテリー',
  'usb-hub': 'USB-Cハブ',
  'earphones': 'イヤホン',
  'charger': '充電器',
  'sale-guide': 'セール情報'
};
---
<article class="article-card">
  <a href={`/posts/${slug}/`} class="article-card__image-link">
    <img
      src={ogImage}
      alt={title}
      class="article-card__image"
      width="400"
      height="210"
      loading="lazy"
    />
  </a>
  <div class="article-card__body">
    <div class="article-card__meta">
      <span class="badge badge--category">{categoryLabels[category] ?? category}</span>
      <span class="badge badge--type">{typeLabels[type] ?? type}</span>
    </div>
    <h2 class="article-card__title">
      <a href={`/posts/${slug}/`}>{title}</a>
    </h2>
    <p class="article-card__desc">{description}</p>
    <div class="article-card__footer">
      <time class="article-card__date">{publishDate}</time>
      <a href={`/posts/${slug}/`} class="article-card__cta">続きを読む →</a>
    </div>
  </div>
</article>

<style>
  .article-card {
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition: transform .2s, box-shadow .2s;
    display: flex;
    flex-direction: column;
  }
  .article-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-hover);
  }
  .article-card__image-link { display: block; overflow: hidden; }
  .article-card__image {
    width: 100%; height: 210px; object-fit: cover;
    transition: transform .3s;
  }
  .article-card:hover .article-card__image { transform: scale(1.03); }
  .article-card__body { padding: 1.25rem; flex: 1; display: flex; flex-direction: column; gap: .6rem; }
  .article-card__meta { display: flex; gap: .4rem; flex-wrap: wrap; }
  .badge--type { background: #fff7ed; color: #c2410c; }
  .article-card__title { font-size: 1rem; font-weight: 700; line-height: 1.4; margin: 0; }
  .article-card__title a { color: var(--color-text); text-decoration: none; }
  .article-card__title a:hover { color: var(--color-primary); }
  .article-card__desc { font-size: .875rem; color: var(--color-text-muted); flex: 1; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .article-card__footer { display: flex; justify-content: space-between; align-items: center; margin-top: auto; }
  .article-card__date { font-size: .8rem; color: var(--color-text-muted); }
  .article-card__cta { font-size: .85rem; font-weight: 600; color: var(--color-primary); text-decoration: none; }
  .article-card__cta:hover { color: var(--color-primary-dark); }
</style>
