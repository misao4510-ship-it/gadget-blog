---
import { readFileSync } from 'fs';
import { join } from 'path';
import { getPriceTrend } from '../utils/priceTrend';
import type { TrendResult } from '../utils/priceTrend';
import StarRating from './StarRating.astro';
import { Image } from 'astro:assets';

interface Props {
  title: string;
  description: string;
  slug: string;
  category: string;
  publishDate: string;
  ogImage?: string;
  type: string;
  productId?: string;
  recommendation?: number | null;
}
const { title, description, slug, category, publishDate, ogImage = '/images/og-default.svg', type, productId, recommendation } = Astro.props;

let trend: TrendResult | null = null;
if (productId) {
  try {
    const raw = readFileSync(join(process.cwd(), 'data/prices', `${productId}.json`), 'utf-8');
    const data = JSON.parse(raw);
    const pricePoints = (data.history ?? [])
      .map((h: { date: string; amazon?: number; rakuten?: number }) => {
        const price = Math.min(h.amazon ?? Infinity, h.rakuten ?? Infinity);
        return isFinite(price) ? { date: h.date, price } : null;
      })
      .filter(Boolean);
    trend = getPriceTrend(pricePoints);
  } catch {
    // 価格データなし → バッジ非表示
  }
}
const typeLabels: Record<string, string> = {
  review: 'レビュー', comparison: '比較', roundup: 'まとめ'
};
const categoryLabels: Record<string, string> = {
  'mobile-battery': 'モバイルバッテリー',
  'usb-hub': 'USB-Cハブ',
  'earphones': 'イヤホン',
  'charger': '充電器',
  'sale-guide': 'セール情報',
  'iphone-case': 'iPhoneケース',
  'robot-vacuum': 'ロボット掃除機',
  'air-purifier': '空気清浄機',
  'electric-kettle': '電気ケトル',
  'hair-dryer': 'ヘアドライヤー',
  'circulator': 'サーキュレーター',
};
---
<article class="article-card">
  <a href={`/posts/${slug}/`} class="article-card__image-link">
    <Image
      src={ogImage}
      alt={title}
      class="article-card__image"
      width={400}
      height={210}
      loading="lazy"
      decoding="async"
      format="webp"
    />
  </a>
  <div class="article-card__body">
    <div class="article-card__meta">
      <span class="badge badge--category">{categoryLabels[category] ?? category}</span>
      <span class="badge badge--type">{typeLabels[type] ?? type}</span>
      {trend && (
        <span class={`price-badge ${trend.color}`}>{trend.label}</span>
      )}
    </div>
    <h2 class="article-card__title">
      <a href={`/posts/${slug}/`}>{title}</a>
    </h2>
    <p class="article-card__desc">{description}</p>
    {recommendation !== undefined && recommendation !== null && (
      <StarRating rating={recommendation} compact={true} />
    )}
    <div class="article-card__footer">
      <time class="article-card__date">{publishDate}</time>
      <a href={`/posts/${slug}/`} class="article-card__cta">続きを読む →</a>
    </div>
  </div>
</article>

<style>
  .article-card {
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition: transform .2s, box-shadow .2s;
    display: flex;
    flex-direction: column;
  }
  .article-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-hover);
  }
  .article-card__image-link { display: block; overflow: hidden; }
  .article-card__image {
    width: 100%; height: 210px; object-fit: cover;
    transition: transform .3s;
  }
  .article-card:hover .article-card__image { transform: scale(1.03); }
  .article-card__body { padding: 1.25rem; flex: 1; display: flex; flex-direction: column; gap: .6rem; }
  .article-card__meta { display: flex; gap: .4rem; flex-wrap: wrap; }
  .badge--type { background: #fff3e0; color: #e65100; }
  .price-badge { font-size: 0.7rem; padding: 2px 6px; border-radius: 4px; font-weight: bold; }
  .price-badge.pink { background: #fce7f3; color: #be185d; }
  .price-badge.green { background: #dcfce7; color: #166534; }
  .price-badge.orange { background: #ffedd5; color: #c2410c; }
  .article-card__title { font-size: 1rem; font-weight: 700; line-height: 1.4; margin: 0; }
  .article-card__title a { color: var(--color-text); text-decoration: none; }
  .article-card__title a:hover { color: var(--color-primary); }
  .article-card__desc { font-size: .875rem; color: var(--color-text-muted); flex: 1; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .article-card__footer { display: flex; justify-content: space-between; align-items: center; margin-top: auto; }
  .article-card__date { font-size: .8rem; color: var(--color-text-muted); }
  .article-card__cta { font-size: .85rem; font-weight: 600; color: var(--color-primary); text-decoration: none; }
  .article-card__cta:hover { color: var(--color-primary-dark); }
</style>
