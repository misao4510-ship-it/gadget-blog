---
interface Props { productId: string; }
const { productId } = Astro.props;
const priceData = await import(`../../data/prices/${productId}.json`);
const history = JSON.stringify(priceData.history);
---
<div
  class="price-chart-container"
  data-price-history={history}
  data-product-id={productId}
>
  <h3>価格推移グラフ</h3>
  <div class="chart-wrapper">
    <div id={`chart-${productId}`} style="height: 300px;"></div>
    <div class="chart-legend">
      <span class="chart-legend__item">
        <span class="chart-legend__dot" style="background:#e63946;"></span>Amazon
      </span>
      <span class="chart-legend__item">
        <span class="chart-legend__dot" style="background:#2dc653;"></span>楽天
      </span>
    </div>
  </div>
</div>

<script>
  import { createChart, ColorType, LineSeries } from 'lightweight-charts';

  document.querySelectorAll('.price-chart-container').forEach(container => {
    const historyRaw = container.getAttribute('data-price-history') || '[]';
    const productId = container.getAttribute('data-product-id');
    if (!productId) return;

    let history: any[] = [];
    try { history = JSON.parse(historyRaw); } catch { return; }
    if (!history.length) return;

    const chartEl = container.querySelector(`#chart-${productId}`) as HTMLElement;
    if (!chartEl) return;

    // width取得: offsetWidth使用 (clientWidthが0になる場合の対策)
    const width = chartEl.offsetWidth || chartEl.parentElement?.offsetWidth || 600;

    const chart = createChart(chartEl, {
      layout: {
        background: { type: ColorType.Solid, color: '#ffffff' },
        textColor: '#334155',
      },
      grid: {
        vertLines: { color: '#f1f5f9' },
        horzLines: { color: '#f1f5f9' },
      },
      width,
      height: 280,
      timeScale: { timeVisible: false, borderColor: '#e2e8f0' },
      rightPriceScale: { borderColor: '#e2e8f0' },
      crosshair: { mode: 1 },
    });

    // Amazon series (赤) — v5 API
    const amazonSeries = chart.addSeries(LineSeries, {
      color: '#e63946',
      lineWidth: 2,
      title: 'Amazon',
      priceFormat: { type: 'price', precision: 0, minMove: 1 },
    });
    const amazonData = history
      .filter((d: any) => typeof d.amazon === 'number')
      .map((d: any) => ({ time: d.date as string, value: d.amazon as number }));
    if (amazonData.length) amazonSeries.setData(amazonData);

    // 楽天 series (緑) — v5 API
    const rakutenSeries = chart.addSeries(LineSeries, {
      color: '#16a34a',
      lineWidth: 2,
      title: '楽天',
      priceFormat: { type: 'price', precision: 0, minMove: 1 },
    });
    const rakutenData = history
      .filter((d: any) => typeof d.rakuten === 'number')
      .map((d: any) => ({ time: d.date as string, value: d.rakuten as number }));
    if (rakutenData.length) rakutenSeries.setData(rakutenData);

    chart.timeScale().fitContent();

    // レスポンシブ対応
    const resizeObserver = new ResizeObserver(() => {
      const newWidth = chartEl.offsetWidth;
      if (newWidth > 0) chart.applyOptions({ width: newWidth });
    });
    resizeObserver.observe(chartEl);
  });
</script>

<style>
  .price-chart-container {
    margin: 1rem 0;
    font-family: var(--font-sans, sans-serif);
  }
  .price-chart-container h3 {
    font-size: 1rem; font-weight: 700; margin-bottom: .75rem;
    color: #0f172a; display: flex; align-items: center; gap: .4rem;
  }
  .price-chart-container h3::before { content: "📈"; }
  .chart-wrapper {
    border: 1px solid #e2e8f0; border-radius: var(--radius, 8px);
    overflow: hidden; background: white;
  }
  .chart-legend {
    display: flex; gap: 1rem; padding: .5rem .75rem; font-size: .8rem;
    border-top: 1px solid #e2e8f0; background: #f8fafc;
  }
  .chart-legend__item { display: flex; align-items: center; gap: .3rem; font-weight: 600; }
  .chart-legend__dot { width: 10px; height: 10px; border-radius: 50%; }
</style>
