---
// src/components/SakuraBot.astro
// サクラFAQ Bot — キーワードマッチ方式（外部API不要）
// z-index: 1002（NaviChar 999より上）
---

<!-- フローティングボタン -->
<button class="sakura-bot-trigger" id="sakura-bot-trigger" aria-label="サクラに質問する">
  🌸
</button>

<!-- チャットウィンドウ -->
<div class="sakura-bot-window" id="sakura-bot-window" aria-hidden="true">
  <!-- ヘッダー -->
  <div class="sakura-bot-header">
    <div class="sakura-bot-header__avatar">🌸</div>
    <div class="sakura-bot-header__info">
      <span class="sakura-bot-header__name">サクラ</span>
      <span class="sakura-bot-header__sub">ナビキャラクター</span>
    </div>
    <button class="sakura-bot-close" id="sakura-bot-close" aria-label="チャットを閉じる">×</button>
  </div>

  <!-- メッセージエリア -->
  <div class="sakura-bot-messages" id="sakura-bot-messages">
    <div class="sakura-bot-msg sakura-bot-msg--bot">
      <div class="sakura-bot-msg__bubble">こんにちは！わたしはサクラ🌸 ガジェットのことなら何でも聞いてくださいね！</div>
    </div>
  </div>

  <!-- 入力エリア -->
  <div class="sakura-bot-input-area">
    <div class="sakura-bot-select-row">
      <select class="sakura-bot-select" id="sakura-bot-select">
        <option value="">質問を選んでください...</option>
        <optgroup label="挨拶・基本">
          <option value="こんにちは！">こんにちは！</option>
          <option value="サクラって何者？">サクラって何者？</option>
          <option value="ありがとう">ありがとう</option>
        </optgroup>
        <optgroup label="おすすめガジェット">
          <option value="おすすめのモバイルバッテリーは？">おすすめのモバイルバッテリーは？</option>
          <option value="おすすめのワイヤレスイヤホンは？">おすすめのワイヤレスイヤホンは？</option>
          <option value="おすすめの充電器は？">おすすめの充電器は？</option>
          <option value="おすすめのキーボードは？">おすすめのキーボードは？</option>
          <option value="おすすめのスマートウォッチは？">おすすめのスマートウォッチは？</option>
        </optgroup>
        <optgroup label="価格・セール">
          <option value="セールはいつがお得？">セールはいつがお得？</option>
          <option value="価格グラフの見方を教えて">価格グラフの見方を教えて</option>
        </optgroup>
        <optgroup label="スペック・技術">
          <option value="GaN充電器って何？">GaN充電器って何？</option>
          <option value="ノイズキャンセリング（ANC）って何？">ノイズキャンセリング（ANC）って何？</option>
          <option value="USB PDって何？">USB PDって何？</option>
          <option value="Qiワイヤレス充電って何？">Qiワイヤレス充電って何？</option>
          <option value="防水のIPX規格を教えて">防水のIPX規格を教えて</option>
          <option value="Bluetoothの違いを教えて">Bluetoothの違いを教えて</option>
          <option value="mAhって何？">mAhって何？</option>
        </optgroup>
        <optgroup label="使い方・選び方">
          <option value="ガジェットの選び方を教えて">ガジェットの選び方を教えて</option>
        </optgroup>
        <optgroup label="ブログ案内">
          <option value="このブログについて教えて">このブログについて教えて</option>
          <option value="おみくじページはどこ？">おみくじページはどこ？</option>
          <option value="相性診断はどこ？">相性診断はどこ？</option>
          <option value="ゲームページはどこ？">ゲームページはどこ？</option>
          <option value="またね！">またね！</option>
        </optgroup>
      </select>
      <button class="sakura-bot-send sakura-bot-send--select" id="sakura-bot-send-select" aria-label="選択した質問を送信">
        ➤
      </button>
    </div>
    <div class="sakura-bot-text-row">
      <input
        type="text"
        class="sakura-bot-input"
        id="sakura-bot-input"
        placeholder="または自由に入力…"
        autocomplete="off"
        maxlength="200"
      />
      <button class="sakura-bot-send" id="sakura-bot-send" aria-label="送信">
        ➤
      </button>
    </div>
  </div>
</div>

<style>
  /* ===== フローティングボタン ===== */
  .sakura-bot-trigger {
    position: fixed;
    bottom: 20px;
    right: 20px;
    z-index: 1002;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: none;
    background: linear-gradient(135deg, #ff9ab5 0%, #ffb3c6 100%);
    font-size: 1.6rem;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(255, 100, 140, 0.4);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .sakura-bot-trigger:hover {
    transform: scale(1.1);
    box-shadow: 0 6px 20px rgba(255, 100, 140, 0.5);
  }
  .sakura-bot-trigger.open {
    transform: rotate(20deg) scale(1.05);
  }

  /* ===== チャットウィンドウ ===== */
  .sakura-bot-window {
    position: fixed;
    bottom: 90px;
    right: 20px;
    z-index: 1001;
    width: 320px;
    max-height: 480px;
    border-radius: 16px;
    background: var(--sakura-bot-bg, #fff);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.18);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--sakura-bot-border, #ffd6e7);
    /* 開閉アニメーション */
    opacity: 0;
    transform: translateY(16px) scale(0.96);
    pointer-events: none;
    transition: opacity 0.22s ease, transform 0.22s ease;
  }
  .sakura-bot-window.open {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  /* ダークモード */
  [data-theme="dark"] .sakura-bot-window {
    --sakura-bot-bg: #1e293b;
    --sakura-bot-border: #4a5568;
  }
  [data-theme="dark"] .sakura-bot-header {
    background: linear-gradient(135deg, #7c3d6e 0%, #5a2a50 100%);
  }
  [data-theme="dark"] .sakura-bot-msg--bot .sakura-bot-msg__bubble {
    background: #3d3d3d;
    color: #f0f0f0;
  }
  [data-theme="dark"] .sakura-bot-input-area {
    background: #2d2d2d;
    border-top-color: #4a5568;
  }
  [data-theme="dark"] .sakura-bot-input {
    background: #2d2d2d;
    color: #f0f0f0;
    border-color: #6b7280;
  }
  [data-theme="dark"] .sakura-bot-input::placeholder {
    color: #9ca3af;
  }
  [data-theme="dark"] .sakura-bot-messages {
    background: #1e293b;
  }
  [data-theme="dark"] .sakura-bot-msg--user .sakura-bot-msg__bubble {
    background: #3b82f6;
    color: #ffffff;
  }
  [data-theme="dark"] .sakura-bot-select {
    background: #2d2d2d;
    color: #f0f0f0;
    border-color: #6b7280;
  }
  [data-theme="dark"] .sakura-bot-select option,
  [data-theme="dark"] .sakura-bot-select optgroup {
    background: #2d2d2d;
    color: #f0f0f0;
  }

  /* ===== ヘッダー ===== */
  .sakura-bot-header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    background: linear-gradient(135deg, #ff9ab5 0%, #ffb3c6 100%);
    flex-shrink: 0;
  }
  .sakura-bot-header__avatar {
    font-size: 1.5rem;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255,255,255,0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .sakura-bot-header__info {
    flex: 1;
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }
  .sakura-bot-header__name {
    font-size: 0.95rem;
    font-weight: 700;
    color: #fff;
  }
  .sakura-bot-header__sub {
    font-size: 0.72rem;
    color: rgba(255,255,255,0.85);
  }
  .sakura-bot-close {
    background: rgba(255,255,255,0.3);
    border: none;
    color: #fff;
    font-size: 1.1rem;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    flex-shrink: 0;
    transition: background 0.15s;
  }
  .sakura-bot-close:hover {
    background: rgba(255,255,255,0.5);
  }

  /* ===== メッセージエリア ===== */
  .sakura-bot-messages {
    flex: 1;
    overflow-y: auto;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: #fff9fb;
    scroll-behavior: smooth;
  }
  .sakura-bot-msg {
    display: flex;
    gap: 6px;
  }
  .sakura-bot-msg--bot {
    justify-content: flex-start;
  }
  .sakura-bot-msg--user {
    justify-content: flex-end;
  }
  .sakura-bot-msg__bubble {
    max-width: 82%;
    padding: 9px 13px;
    border-radius: 16px;
    font-size: 0.875rem;
    line-height: 1.5;
    word-break: break-word;
  }
  .sakura-bot-msg--bot .sakura-bot-msg__bubble {
    background: #ffe0ed;
    color: #5a1a32;
    border-bottom-left-radius: 4px;
  }
  .sakura-bot-msg--user .sakura-bot-msg__bubble {
    background: #ff9ab5;
    color: #fff;
    border-bottom-right-radius: 4px;
  }

  /* タイピングアニメーション */
  .sakura-bot-typing {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 10px 13px;
    background: #ffe0ed;
    border-radius: 16px;
    border-bottom-left-radius: 4px;
    width: fit-content;
  }
  [data-theme="dark"] .sakura-bot-typing {
    background: #3d3d3d;
  }
  .sakura-bot-typing__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #ff6a9b;
    animation: sakura-dot-bounce 1.2s infinite ease-in-out;
  }
  .sakura-bot-typing__dot:nth-child(2) { animation-delay: 0.2s; }
  .sakura-bot-typing__dot:nth-child(3) { animation-delay: 0.4s; }
  @keyframes sakura-dot-bounce {
    0%, 80%, 100% { transform: translateY(0); opacity: 0.5; }
    40% { transform: translateY(-6px); opacity: 1; }
  }

  /* ===== 入力エリア ===== */
  .sakura-bot-input-area {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 10px 12px;
    background: #fff;
    border-top: 1px solid #ffd6e7;
    flex-shrink: 0;
  }
  .sakura-bot-select-row,
  .sakura-bot-text-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .sakura-bot-select {
    flex: 1;
    border: 1px solid #ffc0d6;
    border-radius: 20px;
    padding: 8px 14px;
    font-size: 0.8rem;
    outline: none;
    background: #fff9fb;
    color: #333;
    cursor: pointer;
    transition: border-color 0.15s;
    appearance: auto;
  }
  .sakura-bot-select:focus {
    border-color: #ff9ab5;
    box-shadow: 0 0 0 2px rgba(255, 154, 181, 0.2);
  }
  .sakura-bot-input {
    flex: 1;
    border: 1px solid #ffc0d6;
    border-radius: 20px;
    padding: 8px 14px;
    font-size: 0.875rem;
    outline: none;
    background: #fff9fb;
    color: #333;
    transition: border-color 0.15s;
  }
  .sakura-bot-input:focus {
    border-color: #ff9ab5;
    box-shadow: 0 0 0 2px rgba(255, 154, 181, 0.2);
  }
  .sakura-bot-send {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: none;
    background: linear-gradient(135deg, #ff9ab5, #ffb3c6);
    color: #fff;
    font-size: 0.9rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .sakura-bot-send:hover {
    transform: scale(1.1);
    box-shadow: 0 2px 8px rgba(255, 100, 140, 0.4);
  }

  /* ===== レスポンシブ ===== */
  @media (max-width: 480px) {
    .sakura-bot-window {
      width: 90vw;
      right: 5vw;
      bottom: 80px;
    }
    .sakura-bot-trigger {
      right: 16px;
      bottom: 16px;
    }
  }
</style>

<script>
(function() {
  // ===== FAQ データ =====
  const FAQ = [
    // 挨拶系
    {
      patterns: [/こんにちは|はじめまして|やあ|こんばんは|おはよう/i],
      responses: [
        'こんにちは！サクラです🌸 何でも聞いてくださいね！',
        'こんにちは！ガジェットのこと、何でも聞いてくださいよ🌸',
      ],
    },
    {
      patterns: [/ありがとう|ありがとございます|サンクス|助かりました/i],
      responses: [
        'どういたしまして！お役に立てて嬉しいです✨',
        'よかったです！他にも何かあれば聞いてくださいね🌸',
      ],
    },
    {
      patterns: [/さようなら|バイバイ|またね|またいつか|bye/i],
      responses: [
        'またいつでも来てくださいね🌸',
        'またいつでもどうぞ！良いガジェットライフを✨',
      ],
    },

    // おすすめ系
    {
      patterns: [/おすすめ.*(モバイルバッテリー|充電池|バッテリー)/i],
      responses: [
        'Ankerのモバイルバッテリーがおすすめですよ！10000mAh以上でType-C対応のものが便利です🔋',
        '容量重視なら20000mAh、軽さ重視なら10000mAhのAnker製品がおすすめです🔋',
      ],
    },
    {
      patterns: [/おすすめ.*(イヤホン|ヘッドホン|ヘッドフォン)/i],
      responses: [
        'ノイズキャンセリング付きのSONY WF-1000XM5やAirPods Proが人気ですよ🎧',
        'Sony WF-1000XM5は音質・ANC性能ともにトップクラスです🎧',
      ],
    },
    {
      patterns: [/おすすめ.*(充電器|アダプター|アダプタ)/i],
      responses: [
        'GaN充電器がコンパクトで高出力でおすすめです！Ankerの65W以上のものが良いですよ⚡',
        'GaN素材のAnkerやUGREENの充電器はコンパクトで使いやすいですよ⚡',
      ],
    },
    {
      patterns: [/おすすめ.*(キーボード|キーボ)/i],
      responses: [
        '用途によりますが、テレワークならメカニカルキーボードが打ちやすくておすすめです⌨️',
        'コンパクトが好みならLogicoolのMX Keys Mini、打鍵感重視ならメカニカルがおすすめです⌨️',
      ],
    },
    {
      patterns: [/おすすめ.*(スマホ|スマートフォン|携帯)/i],
      responses: [
        'iPhone 15かPixel 8がバランス良くておすすめです📱 予算と用途で選ぶのがポイントですよ！',
        'コスパ重視ならPixel 8a、ブランド重視ならiPhone 15がおすすめです📱',
      ],
    },

    // 価格・セール系
    {
      patterns: [/セール|お得|安い|値下がり|割引/i],
      responses: [
        'Amazonはプライムデー（7月）とブラックフライデー（11月）が激安ですよ！楽天はお買い物マラソンが狙い目です🛒',
        '年に2回のAmazonプライムデーとブラックフライデーは本当にお得ですよ！事前にウィッシュリストに入れておくと便利です🛒',
      ],
    },
    {
      patterns: [/価格|いくら|値段|費用|コスパ/i],
      responses: [
        '価格は商品ページの価格グラフをご確認ください📊 底値に近い時期が買い時ですよ！',
        'Keepa（価格追跡ツール）でAmazonの価格推移を確認するのもおすすめです📊',
      ],
    },

    // スペック・機能系
    {
      patterns: [/GaN|ガリウム|ガン充電/i],
      responses: [
        'GaNは窒化ガリウムという素材で、従来のシリコンより小型・軽量・高出力な充電器が作れるんです⚡',
        'GaN充電器は発熱が少なく、コンパクトなのに高出力なのが特徴ですよ⚡',
      ],
    },
    {
      patterns: [/ノイズキャンセリング|ANC|アクティブノイズ/i],
      responses: [
        'ANC（アクティブノイズキャンセリング）は周囲のノイズを電気的に打ち消す技術ですよ🎧',
        '電車や飛行機のノイズを90%以上カットできるモデルもありますよ🎧 集中作業にぴったりです！',
      ],
    },
    {
      patterns: [/USB.?PD|Power.?Delivery/i],
      responses: [
        'USB Power Deliveryの略で、最大100Wの急速充電規格です。対応機器で充電速度が段違いに速くなりますよ⚡',
        'USB PDはノートPCも充電できる規格です。65W以上対応充電器があると便利ですよ⚡',
      ],
    },
    {
      patterns: [/Qi|ワイヤレス充電|無線充電/i],
      responses: [
        'Qi（チー）は無線充電の国際規格です。置くだけで充電できて便利ですよ📱',
        'Qi2はさらに充電効率が上がった新規格です。対応機器なら充電速度も速くなりますよ📱',
      ],
    },
    {
      patterns: [/防水|IPX|IP[0-9]/i],
      responses: [
        'IPX7なら水深1mで30分耐えられます。雨や汗には十分な防水性能ですよ💧',
        'IP68が最高クラスの防水です。水回りでの使用が多い方はIP67以上がおすすめですよ💧',
      ],
    },
    {
      patterns: [/Bluetooth|ブルートゥース/i],
      responses: [
        'Bluetooth 5.0以降は通信距離が伸びて接続も安定しましたよ📡',
        'Bluetooth 5.3なら接続が一段と安定します。最新イヤホンはほとんど対応してますよ📡',
      ],
    },

    // 使い方・選び方系
    {
      patterns: [/選び方|どれがいい|何がいい|どれを買/i],
      responses: [
        '予算・用途・こだわりで選ぶのが基本です！迷ったら相性診断ページも使ってみてくださいね✨',
        '用途を教えてもらえると具体的におすすめできますよ！まずは予算と用途を決めるのが大事です✨',
      ],
    },
    {
      patterns: [/mAh|ミリアンペア|バッテリー容量/i],
      responses: [
        'mAh（ミリアンペア時）が容量の単位です。スマホ1回充電なら10000mAh、複数回なら20000mAh以上がおすすめですよ🔋',
        'スマホのバッテリーは大体3000〜5000mAhです。モバイルバッテリーはその2〜4倍あると安心ですよ🔋',
      ],
    },
    {
      patterns: [/スマートウォッチ|スマウォ|Apple Watch|Galaxy Watch/i],
      responses: [
        '健康管理・通知確認・決済など多機能ですよ。Apple WatchかGalaxy Watchが定番です⌚',
        'Apple WatchはiPhoneユーザー向け、Galaxy WatchはAndroidユーザー向けに最適ですよ⌚',
      ],
    },

    // ブログ案内系
    {
      patterns: [/このブログ|このサイト|ここは何/i],
      responses: [
        'ガジェット・家電・防災グッズのレビューとお得情報を発信してますよ🌸 ぜひ記事を読んでみてください！',
        '人生快適ブログです！ガジェットを賢く選んでライフスタイルをアップグレードするお手伝いをしてますよ🌸',
      ],
    },
    {
      patterns: [/サクラ|あなたは誰|なんですか|なに(者|もの)/i],
      responses: [
        'わたしはサクラ🌸 このブログのナビキャラクターですよ！ガジェットのことなら何でも聞いてくださいね',
        'サクラといいます🌸 ガジェット大好きなナビキャラです。何でも気軽に聞いてくださいね！',
      ],
    },
    {
      patterns: [/おみくじ/i],
      responses: [
        '今日のガジェット運を占うおみくじページがありますよ🎋 トップページから試してみてください！',
      ],
    },
    {
      patterns: [/診断|相性/i],
      responses: [
        'ガジェット相性診断で自分にピッタリのガジェットを見つけられますよ✨ /shindan/ から試せます！',
      ],
    },
    {
      patterns: [/ゲーム|ミニゲーム/i],
      responses: [
        'ミニゲームページがありますよ🎮 /games/ から5種類楽しめます！',
      ],
    },
    {
      patterns: [/工房|プロンプト|画像生成|Stable.?Diffusion|SD/i],
      responses: [
        'SDプロンプトビルダーがありますよ🎨 /prompt-builder/ でStable Diffusionのプロンプトを簡単に作れます！',
      ],
    },
    {
      patterns: [/防災|非常食|緊急/i],
      responses: [
        '防災グッズのレビュー記事もありますよ🆘 緊急時に役立つアイテムをまとめています！',
      ],
    },
  ];

  // フォールバック回答
  const FALLBACK = [
    'うーん、ちょっとわからないです…💦 記事を読んでみてくださいね！何か他に聞きたいことはありますか？',
    'それについては詳しくないですが、記事に情報があるかもしれませんよ📖 他に何かありますか？',
    'ごめんなさい、うまく答えられないです💦 別の質問もお気軽にどうぞ🌸',
  ];

  function getReply(text) {
    const normalized = text.trim();
    for (const entry of FAQ) {
      for (const pattern of entry.patterns) {
        if (pattern.test(normalized)) {
          const pool = entry.responses;
          return pool[Math.floor(Math.random() * pool.length)];
        }
      }
    }
    return FALLBACK[Math.floor(Math.random() * FALLBACK.length)];
  }

  // ===== DOM =====
  const trigger     = document.getElementById('sakura-bot-trigger');
  const win         = document.getElementById('sakura-bot-window');
  const closeBtn    = document.getElementById('sakura-bot-close');
  const input       = document.getElementById('sakura-bot-input');
  const sendBtn     = document.getElementById('sakura-bot-send');
  const selectEl    = document.getElementById('sakura-bot-select');
  const sendSelectBtn = document.getElementById('sakura-bot-send-select');
  const msgs        = document.getElementById('sakura-bot-messages');

  if (!trigger || !win || !closeBtn || !input || !sendBtn || !msgs) return;

  function openChat() {
    win.classList.add('open');
    win.setAttribute('aria-hidden', 'false');
    trigger.classList.add('open');
  }

  function closeChat() {
    win.classList.remove('open');
    win.setAttribute('aria-hidden', 'true');
    trigger.classList.remove('open');
  }

  trigger.addEventListener('click', () => {
    win.classList.contains('open') ? closeChat() : openChat();
  });
  closeBtn.addEventListener('click', closeChat);

  // Escキーで閉じる
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && win.classList.contains('open')) closeChat();
  });

  function addMessage(text, role) {
    const div = document.createElement('div');
    div.className = `sakura-bot-msg sakura-bot-msg--${role}`;
    const bubble = document.createElement('div');
    bubble.className = 'sakura-bot-msg__bubble';
    bubble.textContent = text;
    div.appendChild(bubble);
    msgs.appendChild(div);
    msgs.scrollTop = msgs.scrollHeight;
    return div;
  }

  function showTyping() {
    const div = document.createElement('div');
    div.className = 'sakura-bot-msg sakura-bot-msg--bot';
    div.id = 'sakura-typing-indicator';
    const typing = document.createElement('div');
    typing.className = 'sakura-bot-typing';
    for (let i = 0; i < 3; i++) {
      const dot = document.createElement('span');
      dot.className = 'sakura-bot-typing__dot';
      typing.appendChild(dot);
    }
    div.appendChild(typing);
    msgs.appendChild(div);
    msgs.scrollTop = msgs.scrollHeight;
  }

  function hideTyping() {
    const el = document.getElementById('sakura-typing-indicator');
    if (el) el.remove();
  }

  function dispatchReply(text) {
    addMessage(text, 'user');
    showTyping();
    const delay = 700 + Math.random() * 400;
    setTimeout(() => {
      hideTyping();
      const reply = getReply(text);
      addMessage(reply, 'bot');
    }, delay);
  }

  function handleSend() {
    const text = input.value.trim();
    if (!text) return;
    input.value = '';
    dispatchReply(text);
  }

  function handleSelectSend() {
    if (!selectEl) return;
    const text = selectEl.value;
    if (!text) return;
    selectEl.value = '';
    dispatchReply(text);
  }

  sendBtn.addEventListener('click', handleSend);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.isComposing) {
      e.preventDefault();
      handleSend();
    }
  });

  if (sendSelectBtn) {
    sendSelectBtn.addEventListener('click', handleSelectSend);
  }
})();
</script>
