---
export interface Props {
  headings: { depth: number; slug: string; text: string }[];
}
const { headings } = Astro.props;
const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);
---

{tocHeadings.length > 0 && (
  <nav class="toc" id="toc" aria-label="目次">
    <div class="toc__header">
      <span class="toc__icon">📋</span>
      <span class="toc__title">目次</span>
    </div>
    <ol class="toc__list">
      {tocHeadings.map(h => (
        <li class={`toc__item toc__item--depth-${h.depth}`}>
          <a href={`#${h.slug}`} class="toc__link" data-heading={h.slug}>
            {h.text}
          </a>
        </li>
      ))}
    </ol>
  </nav>
)}

<script>
  // Intersection Observer でアクティブ見出しをハイライト
  const links = document.querySelectorAll<HTMLAnchorElement>('.toc__link');
  const headingIds = Array.from(links).map(a => a.dataset.heading!);

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        const id = entry.target.id;
        const link = document.querySelector(`.toc__link[data-heading="${id}"]`);
        if (!link) return;
        if (entry.isIntersecting) {
          document.querySelectorAll('.toc__link').forEach(l => l.classList.remove('toc__link--active'));
          link.classList.add('toc__link--active');
        }
      });
    },
    { rootMargin: '-10% 0px -80% 0px', threshold: 0 }
  );

  headingIds.forEach(id => {
    const el = document.getElementById(id);
    if (el) observer.observe(el);
  });

  // スムーズスクロール
  links.forEach(link => {
    link.addEventListener('click', e => {
      e.preventDefault();
      const target = document.getElementById(link.dataset.heading!);
      if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>

<style>
  .toc {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
    position: sticky;
    top: 80px;
    max-height: calc(100vh - 100px);
    overflow-y: auto;
    font-size: .875rem;
  }
  .toc__header {
    display: flex; align-items: center; gap: .4rem;
    font-weight: 700; font-size: .9rem; color: var(--color-text);
    margin-bottom: .875rem; padding-bottom: .625rem;
    border-bottom: 2px solid var(--color-primary-light);
  }
  .toc__list {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-direction: column; gap: .1rem;
  }
  .toc__item--depth-3 { padding-left: 1rem; }
  .toc__link {
    display: block; padding: .3rem .5rem;
    color: var(--color-text-muted); text-decoration: none;
    border-radius: 6px; line-height: 1.4;
    transition: background .15s, color .15s;
    border-left: 2px solid transparent;
  }
  .toc__link:hover {
    background: var(--color-primary-light);
    color: var(--color-primary);
  }
  .toc__link--active {
    background: var(--color-primary-light);
    color: var(--color-primary);
    font-weight: 600;
    border-left-color: var(--color-primary);
  }
  /* スクロールバー細め */
  .toc::-webkit-scrollbar { width: 4px; }
  .toc::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 2px; }
</style>
