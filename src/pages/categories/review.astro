---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';

const posts = await getCollection('posts', ({ data }) => !data.draft);
const reviewPosts = posts.filter(p => {
  const isSale =
    p.data.category === 'sale' ||
    p.data.category === 'sale-guide' ||
    p.data.category === 'sale-info' ||
    p.data.title.includes('セール') ||
    p.data.title.includes('楽天') ||
    p.data.title.includes('Yahoo');
  if (isSale) return false;
  const isRanking =
    p.data.category === 'ranking' ||
    p.data.title.includes('ランキング') ||
    p.data.title.includes('以下') ||
    p.data.title.includes('おすすめ');
  return !isRanking;
}).sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime());
---
<BaseLayout
  title="個別レビュー"
  description="個別ガジェット・商品の徹底レビュー記事一覧。実際に使って分かった長所・短所を正直にレポート。"
>
  <section class="category-hero category-hero--review">
    <div class="container">
      <h1 class="category-hero__title">📝 個別レビュー</h1>
      <p class="category-hero__desc">個別ガジェット・商品の徹底レビュー。実際に使って分かった本音をレポート。</p>
      <span class="category-hero__count">{reviewPosts.length}件の記事</span>
    </div>
  </section>

  <section class="tab-filter">
    <div class="container">
      <div class="tab-list" role="tablist">
        <button class="tab-btn active" data-cat="all" role="tab" aria-selected="true">すべて</button>
        <button class="tab-btn" data-cat="gadget" role="tab" aria-selected="false">📱 ガジェット</button>
        <button class="tab-btn" data-cat="appliance" role="tab" aria-selected="false">🏠 家電</button>
        <button class="tab-btn" data-cat="disaster" role="tab" aria-selected="false">🆘 防災</button>
      </div>
    </div>
  </section>

  <section class="category-articles">
    <div class="container">
      {reviewPosts.length > 0 ? (
        <div class="articles__grid">
          {reviewPosts.map(post => (
            <div class="review-card" data-subcategory={post.data.subcategory || 'gadget'}>
              <ArticleCard
                title={post.data.title}
                description={post.data.description}
                slug={post.id}
                category={post.data.category}
                publishDate={post.data.publishDate}
                ogImage={post.data.ogImage || '/images/og-default.svg'}
                type={post.data.type}
                productId={post.data.products?.[0]}
                recommendation={post.data.recommendation}
              />
            </div>
          ))}
        </div>
      ) : (
        <p class="no-articles">記事はまだありません。</p>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .category-hero {
    padding: 3rem 0 2.5rem;
    color: white;
  }
  .category-hero--review {
    background: linear-gradient(135deg, #1e40af 0%, #2563eb 50%, #3b82f6 100%);
  }
  .category-hero__title { font-size: clamp(1.75rem, 4vw, 2.5rem); font-weight: 800; margin-bottom: .75rem; color: white; }
  .category-hero__desc { font-size: 1.05rem; color: rgba(255,255,255,.85); margin-bottom: 1rem; }
  .category-hero__count { background: rgba(255,255,255,.2); border: 1px solid rgba(255,255,255,.3); padding: .25em .8em; border-radius: 99px; font-size: .875rem; font-weight: 600; }

  .category-articles { padding: 3rem 0; }
  .articles__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.75rem;
  }
  .no-articles { color: var(--color-text-muted); text-align: center; padding: 3rem 0; }

  .tab-filter { padding: 1.5rem 0; background: #f8fafc; border-bottom: 1px solid #e2e8f0; }
  .tab-list { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .tab-btn {
    padding: 8px 16px;
    border-radius: 20px;
    cursor: pointer;
    border: 2px solid transparent;
    background: var(--color-surface, #fff);
    color: var(--color-text, #1f2937);
    font-size: 0.9rem;
    font-weight: 600;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }
  .tab-btn:hover {
    background: #eff6ff;
    border-color: #2563eb;
    color: #2563eb;
  }
  .tab-btn.active {
    background: var(--accent, #ec4899);
    color: white;
    border-color: transparent;
  }
  [data-theme="dark"] .tab-btn {
    background: var(--color-surface, #1e293b);
    color: var(--color-text, #e2e8f0);
  }
  [data-theme="dark"] .tab-btn:hover {
    background: rgba(37,99,235,0.2);
    border-color: #3b82f6;
    color: #93c5fd;
  }

  @media (max-width: 640px) {
    .articles__grid { grid-template-columns: 1fr; }
    .category-hero { padding: 2rem 0 1.75rem; }
  }
</style>

<script>
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const cat = (btn as HTMLElement).dataset.cat;
      document.querySelectorAll('.tab-btn').forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');
      document.querySelectorAll('.review-card').forEach(card => {
        const el = card as HTMLElement;
        if (cat === 'all' || el.dataset.subcategory === cat) {
          el.style.display = '';
        } else {
          el.style.display = 'none';
        }
      });
    });
  });
</script>
