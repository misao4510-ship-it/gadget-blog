---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleCard from '../../../components/ArticleCard.astro';

const MAJOR_CATEGORIES: Record<string, { icon: string; label: string; color: string; categories: string[] }> = {
  'charging': {
    icon: '🔋', label: '充電・バッテリー', color: '#059669',
    categories: ['charger', 'wireless-charger', 'mobile-battery'],
  },
  'pc-peripherals': {
    icon: '💻', label: 'PC・周辺機器', color: '#2563eb',
    categories: ['keyboard', 'monitor', 'portable-ssd', 'usb-hub'],
  },
  'audio': {
    icon: '🎧', label: 'オーディオ', color: '#db2777',
    categories: ['earphones', 'earphone'],
  },
  'gadget': {
    icon: '📱', label: 'ガジェット', color: '#7c3aed',
    categories: ['gadget', 'gadget-misc'],
  },
  'lifestyle': {
    icon: '🏠', label: '生活・ヘルス', color: '#0284c7',
    categories: ['生活', 'health', 'electric-kettle', 'ビジネス', 'review'],
  },
  'sale': {
    icon: '🏷️', label: 'セール情報', color: '#ea580c',
    categories: ['sale-info', 'sale-guide'],
  },
};

const CATEGORY_LABELS: Record<string, string> = {
  'charger': '充電器',
  'wireless-charger': 'ワイヤレス充電器',
  'mobile-battery': 'モバイルバッテリー',
  'earphones': 'イヤホン',
  'earphone': 'イヤホン',
  'keyboard': 'キーボード',
  'monitor': 'モニター',
  'portable-ssd': 'ポータブルSSD',
  'usb-hub': 'USBハブ',
  'gadget': 'ガジェット',
  'gadget-misc': 'ガジェット雑貨',
  'electric-kettle': '電気ケトル',
  'review': 'レビュー',
  'health': 'ヘルス',
  'sale-info': 'セール情報',
  'sale-guide': 'セールガイド',
  '生活': '生活',
  'ビジネス': 'ビジネス',
};

export async function getStaticPaths() {
  const slugs = ['charging', 'pc-peripherals', 'audio', 'gadget', 'lifestyle', 'sale'];
  return slugs.map(slug => ({
    params: { slug },
    props: { slug },
  }));
}

const { slug } = Astro.props;
const major = MAJOR_CATEGORIES[slug];

const allPosts = await getCollection('posts', ({ data }) => !data.draft && new Date(data.publishDate) <= new Date());
const categoryPosts = allPosts
  .filter(p => major.categories.includes(p.data.category))
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime());

// サブカテゴリの記事数を集計（記事があるものだけ表示）
const subCategoryCounts = major.categories
  .map(cat => ({ cat, count: categoryPosts.filter(p => p.data.category === cat).length }))
  .filter(sc => sc.count > 0);
---
<BaseLayout
  title={`${major.label}の記事一覧`}
  description={`${major.label}カテゴリの記事一覧。レビュー・比較・おすすめ情報をお届けします。`}
>
  <section class="category-hero" style={`background: linear-gradient(135deg, ${major.color} 0%, ${major.color}cc 100%);`}>
    <div class="container">
      <h1 class="category-hero__title">{major.icon} {major.label}</h1>
      <p class="category-hero__desc">{major.label}カテゴリの記事一覧です</p>
      <span class="category-hero__count">{categoryPosts.length}件の記事</span>
    </div>
  </section>

  {subCategoryCounts.length > 1 && (
    <section class="tab-filter">
      <div class="container">
        <div class="tab-list" role="tablist">
          <button class="tab-btn active" data-cat="all" role="tab" aria-selected="true">すべて</button>
          {subCategoryCounts.map(sc => (
            <button class="tab-btn" data-cat={sc.cat} role="tab" aria-selected="false">
              {CATEGORY_LABELS[sc.cat] || sc.cat}（{sc.count}）
            </button>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="category-articles">
    <div class="container">
      {categoryPosts.length > 0 ? (
        <div class="articles__grid">
          {categoryPosts.map(post => (
            <div class="filter-card" data-subcategory={post.data.category}>
              <ArticleCard
                title={post.data.title}
                description={post.data.description}
                slug={post.id}
                category={post.data.category}
                publishDate={post.data.publishDate}
                ogImage={post.data.ogImage || '/images/og-default.svg'}
                type={post.data.type}
                productId={post.data.products?.[0]}
                recommendation={post.data.recommendation}
              />
            </div>
          ))}
        </div>
      ) : (
        <p class="no-articles">このカテゴリの記事はまだありません。</p>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .category-hero {
    padding: 3rem 0 2.5rem;
    color: white;
  }
  .category-hero__title { font-size: clamp(1.75rem, 4vw, 2.5rem); font-weight: 800; margin-bottom: .75rem; color: white; }
  .category-hero__desc { font-size: 1.05rem; color: rgba(255,255,255,.85); margin-bottom: 1rem; }
  .category-hero__count { background: rgba(255,255,255,.2); border: 1px solid rgba(255,255,255,.3); padding: .25em .8em; border-radius: 99px; font-size: .875rem; font-weight: 600; }
  .category-articles { padding: 3rem 0; }
  .articles__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.75rem;
  }
  .no-articles { color: var(--color-text-muted); text-align: center; padding: 3rem 0; }

  .tab-filter { padding: 1.5rem 0; background: #f8fafc; border-bottom: 1px solid #e2e8f0; }
  .tab-list { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .tab-btn {
    padding: 8px 16px;
    border-radius: 20px;
    cursor: pointer;
    border: 2px solid transparent;
    background: var(--color-surface, #fff);
    color: var(--color-text, #1f2937);
    font-size: 0.9rem;
    font-weight: 600;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }
  .tab-btn:hover {
    background: #eff6ff;
    border-color: #2563eb;
    color: #2563eb;
  }
  .tab-btn.active {
    background: var(--accent, #ec4899);
    color: white;
    border-color: transparent;
  }
  [data-theme="dark"] .tab-filter { background: var(--color-surface, #1e293b); border-color: #334155; }
  [data-theme="dark"] .tab-btn {
    background: var(--color-surface, #1e293b);
    color: var(--color-text, #e2e8f0);
  }
  [data-theme="dark"] .tab-btn:hover {
    background: rgba(37,99,235,0.2);
    border-color: #3b82f6;
    color: #93c5fd;
  }

  @media (max-width: 640px) {
    .articles__grid { grid-template-columns: 1fr; }
    .category-hero { padding: 2rem 0 1.75rem; }
  }
</style>

<script>
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const cat = (btn as HTMLElement).dataset.cat;
      document.querySelectorAll('.tab-btn').forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');
      document.querySelectorAll('.filter-card').forEach(card => {
        const el = card as HTMLElement;
        if (cat === 'all' || el.dataset.subcategory === cat) {
          el.style.display = '';
        } else {
          el.style.display = 'none';
        }
      });
    });
  });
</script>
