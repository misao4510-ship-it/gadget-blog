---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleCard from '../../../components/ArticleCard.astro';

const posts = await getCollection('posts', ({ data }) => !data.draft && data.publishDate <= new Date().toLocaleDateString('sv-SE', {timeZone: 'Asia/Tokyo'}));
const gadgetPosts = posts.filter(p => p.data.subcategory === 'gadget')
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime());
---
<BaseLayout
  title="ガジェット レビュー"
  description="スマホアクセサリ・モバイルバッテリー・ワイヤレス充電・イヤホンなどのガジェット個別レビュー記事一覧。"
>
  <section class="category-hero category-hero--gadget">
    <div class="container">
      <p class="breadcrumb"><a href="/categories/review/">個別レビュー</a> &gt; ガジェット</p>
      <h1 class="category-hero__title">📱 ガジェット レビュー</h1>
      <p class="category-hero__desc">スマホアクセサリ・モバイルバッテリー・ワイヤレス充電・イヤホン等のレビュー。</p>
      <span class="category-hero__count">{gadgetPosts.length}件の記事</span>
    </div>
  </section>

  <section class="category-articles">
    <div class="container">
      {gadgetPosts.length > 0 ? (
        <div class="articles__grid">
          {gadgetPosts.map(post => (
            <ArticleCard
              title={post.data.title}
              description={post.data.description}
              slug={post.id}
              category={post.data.category}
              publishDate={post.data.publishDate}
              ogImage={post.data.ogImage || '/images/og-default.svg'}
              type={post.data.type}
              productId={post.data.products?.[0]}
              recommendation={post.data.recommendation}
            />
          ))}
        </div>
      ) : (
        <p class="no-articles">記事はまだありません。</p>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .breadcrumb { font-size: .875rem; color: rgba(255,255,255,.8); margin-bottom: .5rem; }
  .breadcrumb a { color: rgba(255,255,255,.9); text-decoration: underline; }

  .category-hero {
    padding: 3rem 0 2.5rem;
    color: white;
  }
  .category-hero--gadget {
    background: linear-gradient(135deg, #1e40af 0%, #2563eb 50%, #3b82f6 100%);
  }
  .category-hero__title { font-size: clamp(1.75rem, 4vw, 2.5rem); font-weight: 800; margin-bottom: .75rem; color: white; }
  .category-hero__desc { font-size: 1.05rem; color: rgba(255,255,255,.85); margin-bottom: 1rem; }
  .category-hero__count { background: rgba(255,255,255,.2); border: 1px solid rgba(255,255,255,.3); padding: .25em .8em; border-radius: 99px; font-size: .875rem; font-weight: 600; }

  .category-articles { padding: 3rem 0; }
  .articles__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.75rem;
  }
  .no-articles { color: var(--color-text-muted); text-align: center; padding: 3rem 0; }

  @media (max-width: 640px) {
    .articles__grid { grid-template-columns: 1fr; }
    .category-hero { padding: 2rem 0 1.75rem; }
  }
</style>
