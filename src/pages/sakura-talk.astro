---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="🌸 サクラとお話し"
  description="サクラとリアルタイム音声・テキストで会話できるページです！ガジェットの相談、なんでも聞いてくださいね✨"
>

<div class="talk-page">
  <div class="talk-header">
    <h1 class="talk-title">🌸 サクラとお話し</h1>
    <p class="talk-subtitle">音声またはテキストでサクラと会話できますよ！</p>
  </div>

  <div class="talk-layout">
    <!-- サクラキャラエリア -->
    <div class="sakura-area">
      <div class="chibi-wrapper" id="chibi-wrapper">
        <img
          id="sakura-chibi"
          class="chibi-light"
          src="/images/games/chibi/sakura_chibi_v2_01_nobg.png"
          alt="サクラ"
        />
        <img
          id="sakura-chibi-dark"
          class="chibi-dark"
          src="/images/games/chibi/black/sakura_chibi_black_01_nobg.png"
          alt="サクラ"
        />
      </div>
      <div class="status-badge" id="status-badge">
        <span class="status-dot" id="status-dot"></span>
        <span id="status-text">待機中</span>
      </div>
    </div>

    <!-- チャットエリア -->
    <div class="chat-area">
      <div class="chat-messages" id="chat-messages">
        <!-- メッセージはJSで追加 -->
      </div>

      <!-- 入力エリア -->
      <div class="input-area">
        <!-- マイクボタン -->
        <button class="mic-btn" id="mic-btn" title="マイクで話す">
          <span class="mic-icon" id="mic-icon">🎤</span>
        </button>

        <!-- テキスト入力 -->
        <div class="text-input-wrap">
          <input
            type="text"
            id="text-input"
            class="text-input"
            placeholder="メッセージを入力してくださいね..."
            maxlength="200"
            autocomplete="off"
          />
          <button class="send-btn" id="send-btn">送信</button>
        </div>
      </div>

      <!-- ブラウザ非対応メッセージ -->
      <div id="no-speech-msg" class="no-speech-msg" style="display:none">
        ⚠️ このブラウザは音声認識に非対応です。テキスト入力でご利用くださいね！
      </div>
    </div>
  </div>
</div>

</BaseLayout>

<script>
  const WORKER_URL = 'https://sakura-chat-api.misao-4510.workers.dev/chat';

  // チャット履歴（AIへ送るmessages配列）
  let chatHistory: {role: string, content: string}[] = [];

  const chatEl = document.getElementById('chat-messages')!;
  const micBtn = document.getElementById('mic-btn')!;
  const micIcon = document.getElementById('mic-icon')!;
  const textInput = document.getElementById('text-input') as HTMLInputElement;
  const sendBtn = document.getElementById('send-btn')!;
  const statusDot = document.getElementById('status-dot')!;
  const statusText = document.getElementById('status-text')!;
  const chibiLight = document.getElementById('sakura-chibi') as HTMLImageElement;
  const chibiDark = document.getElementById('sakura-chibi-dark') as HTMLImageElement;
  const noSpeechMsg = document.getElementById('no-speech-msg')!;
  const chibiWrapper = document.getElementById('chibi-wrapper')!;

  const CHIBI = {
    idle:    { l: '/images/games/chibi/sakura_chibi_v2_01_nobg.png',   d: '/images/games/chibi/black/sakura_chibi_black_01_nobg.png' },
    listen:  { l: '/images/games/chibi/sakura_chibi_v2_03_nobg.png',   d: '/images/games/chibi/black/sakura_chibi_black_03_nobg.png' },
    speak:   { l: '/images/games/chibi/sakura_chibi_v2_04_nobg.png',   d: '/images/games/chibi/black/sakura_chibi_black_04_nobg.png' },
    think:   { l: '/images/games/chibi/sakura_chibi_v2_06_nobg.png',   d: '/images/games/chibi/black/sakura_chibi_black_01_nobg.png' },
  };

  function setChibiPose(pose: keyof typeof CHIBI) {
    const p = CHIBI[pose];
    if (chibiLight) chibiLight.src = p.l;
    if (chibiDark) chibiDark.src = p.d;
  }

  function setStatus(text: string, type: 'idle' | 'listening' | 'thinking' | 'speaking') {
    if (statusText) statusText.textContent = text;
    statusDot.className = `status-dot status-dot--${type}`;
  }

  function addMessage(role: 'user' | 'sakura', text: string) {
    const wrap = document.createElement('div');
    wrap.className = `msg-wrap msg-wrap--${role}`;

    if (role === 'sakura') {
      const avatar = document.createElement('div');
      avatar.className = 'msg-avatar';
      avatar.textContent = '🌸';
      wrap.appendChild(avatar);
    }

    const bubble = document.createElement('div');
    bubble.className = `msg-bubble msg-bubble--${role}`;
    bubble.textContent = text;
    wrap.appendChild(bubble);

    chatEl.appendChild(wrap);
    chatEl.scrollTop = chatEl.scrollHeight;
  }

  function addThinking() {
    const wrap = document.createElement('div');
    wrap.className = 'msg-wrap msg-wrap--sakura';
    wrap.id = 'thinking-indicator';

    const avatar = document.createElement('div');
    avatar.className = 'msg-avatar';
    avatar.textContent = '🌸';
    wrap.appendChild(avatar);

    const bubble = document.createElement('div');
    bubble.className = 'msg-bubble msg-bubble--sakura msg-bubble--thinking';
    bubble.innerHTML = '<span class="dot-anim"></span><span class="dot-anim"></span><span class="dot-anim"></span>';
    wrap.appendChild(bubble);

    chatEl.appendChild(wrap);
    chatEl.scrollTop = chatEl.scrollHeight;
    return wrap;
  }

  // 音声読み上げ
  function speakText(text: string) {
    if (!window.speechSynthesis) return;
    window.speechSynthesis.cancel();

    const utt = new SpeechSynthesisUtterance(text);
    utt.lang = 'ja-JP';
    utt.rate = 1.05;
    utt.pitch = 1.2;

    // 日本語女性音声を優先
    const voices = window.speechSynthesis.getVoices();
    const jaVoice = voices.find(v =>
      v.lang.startsWith('ja') && /female|woman|girl|Kyoko|Otoya|Haruka/i.test(v.name)
    ) || voices.find(v => v.lang.startsWith('ja'));
    if (jaVoice) utt.voice = jaVoice;

    utt.onstart = () => {
      setChibiPose('speak');
      setStatus('話し中...', 'speaking');
    };
    utt.onend = () => {
      setChibiPose('idle');
      setStatus('待機中', 'idle');
    };

    window.speechSynthesis.speak(utt);
  }

  // AI呼び出し
  async function sendToAI(userText: string) {
    chatHistory.push({ role: 'user', content: userText });

    const thinkEl = addThinking();
    setChibiPose('think');
    setStatus('考え中...', 'thinking');

    try {
      const res = await fetch(WORKER_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: chatHistory }),
      });

      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json() as { reply?: string, error?: string };
      const reply = data.reply || 'すみません、うまく答えられませんでした💦';

      thinkEl.remove();
      chatHistory.push({ role: 'assistant', content: reply });
      addMessage('sakura', reply);
      speakText(reply);
    } catch (err) {
      thinkEl.remove();
      const errMsg = 'ごめんなさい、今ちょっと繋がりにくいみたいです💦 もう一度試してみてくださいね！';
      addMessage('sakura', errMsg);
      setChibiPose('idle');
      setStatus('待機中', 'idle');
    }
  }

  // メッセージ送信
  function handleSend(text: string) {
    const trimmed = text.trim();
    if (!trimmed) return;
    addMessage('user', trimmed);
    textInput.value = '';
    sendToAI(trimmed);
  }

  sendBtn.addEventListener('click', () => handleSend(textInput.value));
  textInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      handleSend(textInput.value);
    }
  });

  // 音声認識
  const SpeechRecognition = (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;
  let recognition: any = null;
  let isRecording = false;

  if (!SpeechRecognition) {
    noSpeechMsg.style.display = 'block';
    micBtn.style.display = 'none';
  } else {
    recognition = new SpeechRecognition();
    recognition.lang = 'ja-JP';
    recognition.interimResults = false;
    recognition.maxAlternatives = 1;

    recognition.onstart = () => {
      isRecording = true;
      micBtn.classList.add('mic-btn--recording');
      micIcon.textContent = '⏹️';
      setChibiPose('listen');
      setStatus('聞いています...', 'listening');
    };

    recognition.onresult = (event: any) => {
      const transcript = event.results[0][0].transcript;
      if (transcript) handleSend(transcript);
    };

    recognition.onerror = (event: any) => {
      console.warn('SpeechRecognition error:', event.error);
      stopRecording();
    };

    recognition.onend = () => {
      stopRecording();
    };
  }

  function stopRecording() {
    isRecording = false;
    micBtn.classList.remove('mic-btn--recording');
    micIcon.textContent = '🎤';
    setChibiPose('idle');
    setStatus('待機中', 'idle');
  }

  micBtn.addEventListener('click', () => {
    if (!recognition) return;
    if (isRecording) {
      recognition.stop();
    } else {
      window.speechSynthesis?.cancel();
      recognition.start();
    }
  });

  // 初期メッセージ
  function init() {
    const greeting = 'こんにちは！サクラです✨ ガジェットのことでも、なんでも聞いてくださいね！';
    addMessage('sakura', greeting);
    chatHistory.push({ role: 'assistant', content: greeting });

    // 音声は少し遅らせて読み上げ（voicesが読み込まれるのを待つ）
    setTimeout(() => speakText(greeting), 600);
  }

  // voicesが非同期で読み込まれる場合の対処
  if (window.speechSynthesis) {
    if (window.speechSynthesis.getVoices().length > 0) {
      init();
    } else {
      window.speechSynthesis.onvoiceschanged = () => init();
      setTimeout(init, 1000); // fallback
    }
  } else {
    init();
  }

  // ダークモード対応
  function updateChibiTheme() {
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    if (chibiLight) (chibiLight as HTMLElement).style.display = isDark ? 'none' : 'block';
    if (chibiDark) (chibiDark as HTMLElement).style.display = isDark ? 'block' : 'none';
  }
  updateChibiTheme();
  new MutationObserver(updateChibiTheme).observe(document.documentElement, {
    attributes: true, attributeFilter: ['data-theme']
  });
</script>

<style>
  .talk-page {
    max-width: 800px;
    margin: 0 auto;
    padding: 1.5rem 1rem 4rem;
  }

  .talk-header {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .talk-title {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-primary);
    margin-bottom: 0.25rem;
  }

  .talk-subtitle {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .talk-layout {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  /* サクラエリア */
  .sakura-area {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .chibi-wrapper {
    position: relative;
  }

  #sakura-chibi, #sakura-chibi-dark {
    width: 160px;
    height: auto;
    display: block;
    transition: transform 0.3s ease;
  }

  .chibi-dark { display: none; }
  [data-theme="dark"] .chibi-light { display: none; }
  [data-theme="dark"] .chibi-dark { display: block !important; }

  .chibi-wrapper.chibi-bounce {
    animation: chibi-talk 0.5s ease-in-out;
  }

  @keyframes chibi-talk {
    0%   { transform: translateY(0) rotate(0deg); }
    25%  { transform: translateY(-8px) rotate(-2deg); }
    75%  { transform: translateY(-4px) rotate(2deg); }
    100% { transform: translateY(0) rotate(0deg); }
  }

  /* ステータスバッジ */
  .status-badge {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    color: var(--color-text-muted);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: 99px;
    padding: 0.2rem 0.65rem;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #9ca3af;
    flex-shrink: 0;
  }

  .status-dot--idle { background: #9ca3af; }
  .status-dot--listening { background: #ef4444; animation: pulse-dot 1s ease-in-out infinite; }
  .status-dot--thinking { background: #f59e0b; animation: pulse-dot 1s ease-in-out infinite; }
  .status-dot--speaking { background: #10b981; animation: pulse-dot 0.8s ease-in-out infinite; }

  @keyframes pulse-dot {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.4); opacity: 0.7; }
  }

  /* チャットエリア */
  .chat-area {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
  }

  .chat-messages {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1rem;
    min-height: 320px;
    max-height: 420px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    scroll-behavior: smooth;
  }

  /* メッセージ吹き出し */
  .msg-wrap {
    display: flex;
    align-items: flex-end;
    gap: 0.5rem;
  }

  .msg-wrap--user {
    flex-direction: row-reverse;
  }

  .msg-avatar {
    font-size: 1.2rem;
    flex-shrink: 0;
    margin-bottom: 2px;
  }

  .msg-bubble {
    max-width: 75%;
    padding: 0.6rem 0.9rem;
    border-radius: 1rem;
    font-size: 0.9rem;
    line-height: 1.55;
    word-break: break-word;
  }

  .msg-bubble--sakura {
    background: var(--bubble-bg, #fff0f5);
    border: 1.5px solid #f9a8c9;
    border-bottom-left-radius: 0.25rem;
    color: var(--color-text);
  }

  .msg-bubble--user {
    background: var(--color-primary);
    color: #fff;
    border-bottom-right-radius: 0.25rem;
  }

  /* Thinking アニメーション */
  .msg-bubble--thinking {
    padding: 0.75rem 1.1rem;
    display: flex;
    gap: 5px;
    align-items: center;
  }

  .dot-anim {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #f9a8c9;
    animation: dot-bounce 1.2s ease-in-out infinite;
  }
  .dot-anim:nth-child(2) { animation-delay: 0.2s; }
  .dot-anim:nth-child(3) { animation-delay: 0.4s; }

  @keyframes dot-bounce {
    0%, 80%, 100% { transform: translateY(0); }
    40% { transform: translateY(-8px); }
  }

  /* 入力エリア */
  .input-area {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .mic-btn {
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 2px solid var(--color-border);
    background: var(--color-surface);
    font-size: 1.4rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s, border-color 0.15s, box-shadow 0.15s;
  }

  .mic-btn:hover {
    border-color: #f9a8c9;
    box-shadow: 0 0 0 3px rgba(249, 168, 201, 0.2);
  }

  .mic-btn--recording {
    background: #ef4444 !important;
    border-color: #ef4444 !important;
    animation: mic-pulse 1s ease-in-out infinite;
    box-shadow: 0 0 0 6px rgba(239, 68, 68, 0.2) !important;
  }

  @keyframes mic-pulse {
    0%, 100% { box-shadow: 0 0 0 4px rgba(239, 68, 68, 0.2); }
    50% { box-shadow: 0 0 0 10px rgba(239, 68, 68, 0.05); }
  }

  .text-input-wrap {
    flex: 1;
    display: flex;
    gap: 0.4rem;
  }

  .text-input {
    flex: 1;
    padding: 0.65rem 0.9rem;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius);
    font-size: 0.95rem;
    background: var(--color-surface);
    color: var(--color-text);
    outline: none;
    transition: border-color 0.15s;
    min-width: 0;
  }

  .text-input:focus {
    border-color: var(--color-primary);
  }

  .send-btn {
    padding: 0.65rem 1.1rem;
    background: linear-gradient(135deg, #f9a8c9, #f06090);
    color: #fff;
    font-weight: 700;
    font-size: 0.9rem;
    border: none;
    border-radius: var(--radius);
    cursor: pointer;
    white-space: nowrap;
    transition: filter 0.15s, transform 0.1s;
    flex-shrink: 0;
  }

  .send-btn:hover {
    filter: brightness(1.08);
    transform: translateY(-1px);
  }

  .no-speech-msg {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0.5rem 0.75rem;
  }

  /* レスポンシブ */
  @media (max-width: 600px) {
    .talk-layout {
      flex-direction: column;
      align-items: center;
    }

    .sakura-area {
      flex-direction: row;
      width: 100%;
      justify-content: center;
    }

    #sakura-chibi, #sakura-chibi-dark {
      width: 100px;
    }

    .chat-messages {
      min-height: 260px;
      max-height: 300px;
    }

    .talk-title { font-size: 1.4rem; }
  }
</style>
