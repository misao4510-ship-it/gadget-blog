---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="⌨️ ガジェットタイピング"
  description="ガジェット名をタイピング！60秒でいくつ正解できるかな？"
>
  <div class="game-page">
    <div class="game-header">
      <a href="/games/" class="back-link">← ゲームコーナーへ</a>
      <h1 class="game-title">⌨️ ガジェットタイピング</h1>
      <p class="game-subtitle">60秒で何問正解できるか挑戦！</p>
    </div>

    <div class="game-container">
      <!-- サクラキャラ -->
      <div class="sakura-area">
        <img src="/images/navi-char.png" alt="サクラ" class="sakura-img" />
        <div class="sakura-bubble">
          <p id="sakura-message">表示されたガジェット名を入力してね！🌸</p>
        </div>
      </div>

      <!-- スタート画面 -->
      <div class="screen" id="screen-start">
        <div class="start-card">
          <h2>ガジェットタイピング ⌨️</h2>
          <ul class="rule-list">
            <li>⏱ 制限時間：60秒</li>
            <li>📋 ガジェット名をローマ字で入力</li>
            <li>✅ 正解で次の問題へ自動進行</li>
          </ul>
          <button class="btn btn--primary" id="btn-start-typing">スタート！</button>
        </div>
      </div>

      <!-- プレイ画面 -->
      <div class="screen" id="screen-play" style="display:none">
        <div class="hud">
          <span class="hud-badge">⏱ <strong id="time-left">60</strong>秒</span>
          <span class="hud-badge">正解: <strong id="correct-count">0</strong></span>
          <span class="hud-badge">ミス: <strong id="miss-count">0</strong></span>
        </div>

        <div class="typing-card">
          <div class="word-display">
            <div class="word-ja" id="word-ja">ガジェット</div>
            <div class="word-hint" id="word-hint">（ローマ字で入力）</div>
          </div>

          <div class="input-area">
            <input
              type="text"
              id="typing-input"
              class="typing-input"
              placeholder="ここに入力..."
              autocomplete="off"
              autocorrect="off"
              autocapitalize="off"
              spellcheck="false"
            />
            <div class="input-feedback" id="input-feedback"></div>
          </div>
        </div>

        <div class="progress-wrap">
          <div class="progress-bar" id="progress-bar" style="width:100%"></div>
        </div>
      </div>

      <!-- 結果画面 -->
      <div class="screen" id="screen-result" style="display:none">
        <div class="result-card">
          <div class="result-emoji" id="result-emoji">🏆</div>
          <h2 class="result-title">タイムアップ！</h2>
          <div class="result-stats">
            <div class="stat-item">
              <span class="stat-num" id="result-correct">0</span>
              <span class="stat-label">正解</span>
            </div>
            <div class="stat-item">
              <span class="stat-num stat-num--miss" id="result-miss">0</span>
              <span class="stat-label">ミス</span>
            </div>
          </div>
          <p class="result-comment" id="result-comment"></p>
          <button class="btn btn--primary" id="btn-retry-typing">もう一度！🔄</button>
          <a href="/games/" class="btn btn--secondary">ゲーム一覧へ</a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const wordList = [
    { ja: 'スマートフォン',    roman: 'sumato fon' },
    { ja: 'モバイルバッテリー', roman: 'mobairu batterii' },
    { ja: 'イヤホン',         roman: 'iyahon' },
    { ja: 'スマートウォッチ',  roman: 'sumato wocchi' },
    { ja: 'ノイズキャンセリング', roman: 'noizu kyansering' },
    { ja: 'ワイヤレス充電',    roman: 'waiyaresu juuden' },
    { ja: 'ブルートゥース',    roman: 'burutuusu' },
    { ja: 'タブレット',        roman: 'taburetto' },
    { ja: 'キーボード',        roman: 'kiiboodo' },
    { ja: 'ウェブカメラ',      roman: 'webu kamera' },
    { ja: 'モバイルルーター',  roman: 'mobairu ruutaa' },
    { ja: 'ゲームパッド',      roman: 'geemu paddo' },
    { ja: 'SSDストレージ',     roman: 'SSD sutorееji' },
    { ja: 'メカニカルキーボード', roman: 'mekanikaru kiiboodo' },
    { ja: 'ドッキングステーション', roman: 'dokking suteeshon' },
    { ja: 'USB-Cハブ',         roman: 'USB C habu' },
    { ja: 'スピーカー',        roman: 'supiikaa' },
    { ja: 'プロジェクター',    roman: 'purojekutaa' },
    { ja: 'ドローン',          roman: 'doroon' },
    { ja: 'スマートスピーカー', roman: 'sumaato supiikaa' },
  ];

  const sakuraMessages = {
    start: ['表示されたガジェット名を入力してね！🌸'],
    playing: ['頑張って！💪', 'その調子！✨', '速い！すごい！🌸', 'いいリズム！', 'もっと行ける！💯'],
    correct: ['正解！🎉', '合ってる！✨', 'ナイス！🌸', 'パーフェクト！', 'やった！💪'],
    miss: ['惜しい！もう一度！', 'ちょっと違うよ！', 'もう少し！', 'ファイト！'],
    result: {
      high: ['すごい！タイピングの達人！✨ ガジェット名もバッチリ！🏆', '完璧なタイピング！さすが！🌸'],
      mid:  ['なかなかやるね！練習あるのみ！💪', 'いい感じ！次はもっと上を目指して！✨'],
      low:  ['ガジェット名の勉強と一緒にタイピング練習も！📚', 'ドンマイ！また挑戦してね！🔄'],
    },
  };

  function rand(arr) { return arr[Math.floor(Math.random() * arr.length)]; }
  function setSakura(msg) { document.getElementById('sakura-message').textContent = msg; }

  const GAME_TIME = 60;
  let timeLeft = GAME_TIME;
  let timerInterval = null;
  let correctCount = 0;
  let missCount = 0;
  let currentWord = null;
  let shuffledWords = [];
  let wordIdx = 0;
  let gameActive = false;

  function shuffle(arr) {
    const a = [...arr];
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  function showScreen(id) {
    ['screen-start', 'screen-play', 'screen-result'].forEach(s => {
      const el = document.getElementById(s);
      if (el) el.style.display = s === id ? '' : 'none';
    });
  }

  function startGame() {
    correctCount = 0;
    missCount = 0;
    timeLeft = GAME_TIME;
    wordIdx = 0;
    gameActive = true;
    shuffledWords = shuffle(wordList);

    showScreen('screen-play');
    document.getElementById('correct-count').textContent = '0';
    document.getElementById('miss-count').textContent = '0';
    document.getElementById('time-left').textContent = GAME_TIME;
    document.getElementById('progress-bar').style.width = '100%';
    document.getElementById('input-feedback').textContent = '';

    nextWord();
    document.getElementById('typing-input').value = '';
    document.getElementById('typing-input').focus();
    setSakura(rand(sakuraMessages.playing));

    timerInterval = setInterval(() => {
      timeLeft--;
      document.getElementById('time-left').textContent = timeLeft;
      document.getElementById('progress-bar').style.width = (timeLeft / GAME_TIME * 100) + '%';
      if (timeLeft <= 0) endGame();
    }, 1000);
  }

  function nextWord() {
    if (wordIdx >= shuffledWords.length) {
      // re-shuffle if exhausted
      shuffledWords = shuffle(wordList);
      wordIdx = 0;
    }
    currentWord = shuffledWords[wordIdx++];
    document.getElementById('word-ja').textContent = currentWord.ja;
    document.getElementById('word-hint').textContent = 'ヒント: ' + currentWord.roman;
    document.getElementById('typing-input').value = '';
    document.getElementById('input-feedback').textContent = '';
    document.getElementById('input-feedback').className = 'input-feedback';
  }

  function normalize(str) {
    return str.trim().toLowerCase().replace(/\s+/g, ' ');
  }

  document.getElementById('typing-input')?.addEventListener('input', (e) => {
    if (!gameActive) return;
    const val = normalize(e.target.value);
    const answers = currentWord.roman.split('|').map(normalize);
    const jaMatch = normalize(currentWord.ja) === val;

    if (answers.includes(val) || jaMatch) {
      correctCount++;
      document.getElementById('correct-count').textContent = correctCount;
      const fb = document.getElementById('input-feedback');
      fb.textContent = '✅ 正解！';
      fb.className = 'input-feedback feedback--correct';
      setSakura(rand(sakuraMessages.correct));
      setTimeout(nextWord, 300);
    }
  });

  document.getElementById('typing-input')?.addEventListener('keydown', (e) => {
    if (!gameActive) return;
    if (e.key === 'Enter') {
      const val = normalize(e.target.value);
      if (val.length > 0) {
        missCount++;
        document.getElementById('miss-count').textContent = missCount;
        const fb = document.getElementById('input-feedback');
        fb.textContent = '❌ ミス → 正解: ' + currentWord.roman;
        fb.className = 'input-feedback feedback--miss';
        setSakura(rand(sakuraMessages.miss));
        setTimeout(nextWord, 800);
      }
    }
  });

  function endGame() {
    gameActive = false;
    clearInterval(timerInterval);

    showScreen('screen-result');
    document.getElementById('result-correct').textContent = correctCount;
    document.getElementById('result-miss').textContent = missCount;

    let key = correctCount >= 12 ? 'high' : correctCount >= 6 ? 'mid' : 'low';
    const comment = rand(sakuraMessages.result[key]);
    document.getElementById('result-comment').textContent = comment;
    document.getElementById('result-emoji').textContent = correctCount >= 12 ? '🏆' : correctCount >= 6 ? '✨' : '📚';
    setSakura(comment);
  }

  document.getElementById('btn-start-typing')?.addEventListener('click', startGame);
  document.getElementById('btn-retry-typing')?.addEventListener('click', startGame);
</script>

<style>
  .game-page {
    max-width: 600px;
    margin: 0 auto;
    padding: 1.5rem 1rem 4rem;
  }

  .game-header { margin-bottom: 2rem; }

  .back-link {
    color: var(--color-primary);
    text-decoration: none;
    font-size: 0.875rem;
    display: inline-block;
    margin-bottom: 0.75rem;
  }
  .back-link:hover { text-decoration: underline; }

  .game-title {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-primary);
    margin-bottom: 0.25rem;
  }

  .game-subtitle { color: var(--color-text-muted); font-size: 0.9rem; }

  .sakura-area {
    display: flex;
    align-items: flex-end;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .sakura-img { width: 80px; height: auto; flex-shrink: 0; }

  .sakura-bubble {
    background: var(--bubble-bg, #fff0f5);
    border: 2px solid #f9a8c9;
    border-radius: 1rem;
    padding: 0.6rem 1rem;
    font-size: 0.9rem;
    color: var(--color-text);
    position: relative;
    max-width: 400px;
    line-height: 1.5;
  }

  .sakura-bubble::before {
    content: '';
    position: absolute;
    left: -14px; bottom: 16px;
    border: 7px solid transparent;
    border-right-color: #f9a8c9;
  }

  .sakura-bubble::after {
    content: '';
    position: absolute;
    left: -10px; bottom: 17px;
    border: 6px solid transparent;
    border-right-color: var(--bubble-bg, #fff0f5);
  }

  /* スタート */
  .start-card {
    background: var(--color-surface);
    border-radius: var(--radius-xl);
    padding: 2rem;
    box-shadow: var(--shadow-md);
    border: 2px solid #f9a8c9;
    text-align: center;
  }

  .start-card h2 {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  .rule-list {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    text-align: left;
    display: inline-block;
  }

  .rule-list li { padding: 0.3rem 0; font-size: 0.95rem; color: var(--color-text); }

  /* HUD */
  .hud {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .hud-badge {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.3rem 0.9rem;
    font-size: 0.875rem;
    color: var(--color-text);
  }

  .hud-badge strong { color: var(--color-primary); }

  /* タイピングカード */
  .typing-card {
    background: var(--color-surface);
    border: 2px solid #f9a8c9;
    border-radius: var(--radius-xl);
    padding: 2rem 1.5rem;
    margin-bottom: 1.25rem;
    text-align: center;
  }

  .word-display { margin-bottom: 1.5rem; }

  .word-ja {
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-primary);
    margin-bottom: 0.4rem;
    line-height: 1.3;
  }

  .word-hint { font-size: 0.85rem; color: var(--color-text-muted); }

  .typing-input {
    width: 100%;
    padding: 0.85rem 1rem;
    border: 2px solid var(--color-border);
    border-radius: var(--radius);
    font-size: 1.1rem;
    background: var(--color-surface-raised);
    color: var(--color-text);
    outline: none;
    transition: border-color 0.2s;
    box-sizing: border-box;
  }

  .typing-input:focus { border-color: #f9a8c9; }

  .input-feedback {
    margin-top: 0.6rem;
    font-size: 0.9rem;
    font-weight: 700;
    min-height: 1.4rem;
    transition: color 0.2s;
  }

  .feedback--correct { color: #059669; }
  .feedback--miss { color: #dc2626; }

  /* プログレス */
  .progress-wrap {
    height: 8px;
    background: var(--color-border);
    border-radius: 999px;
    overflow: hidden;
  }

  .progress-bar {
    height: 100%;
    background: linear-gradient(90deg, #f9a8c9, var(--color-primary));
    border-radius: 999px;
    transition: width 0.9s linear;
  }

  /* 結果 */
  .result-card {
    background: var(--color-surface);
    border-radius: var(--radius-xl);
    padding: 2.5rem 2rem;
    box-shadow: var(--shadow-md);
    border: 2px solid #f9a8c9;
    text-align: center;
  }

  .result-emoji { font-size: 3.5rem; margin-bottom: 0.5rem; }

  .result-title {
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  .result-stats {
    display: flex;
    justify-content: center;
    gap: 2.5rem;
    margin-bottom: 1rem;
  }

  .stat-item { display: flex; flex-direction: column; align-items: center; gap: 0.2rem; }

  .stat-num {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1;
  }

  .stat-num--miss { color: #f06090; }
  .stat-label { font-size: 0.8rem; color: var(--color-text-muted); font-weight: 600; }
  .result-comment { font-size: 0.95rem; color: var(--color-text-muted); margin-bottom: 1.25rem; }

  .btn {
    display: inline-block;
    padding: 0.75rem 1.75rem;
    border-radius: var(--radius);
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    border: none;
    text-decoration: none;
    transition: filter 0.15s, transform 0.1s;
    text-align: center;
    margin: 0.25rem;
  }

  .btn:hover { filter: brightness(1.08); transform: translateY(-2px); }

  .btn--primary {
    background: linear-gradient(135deg, #f9a8c9, #f06090);
    color: #fff;
    box-shadow: 0 4px 14px rgba(240,96,144,0.3);
  }

  .btn--secondary {
    background: var(--color-surface-raised);
    color: var(--color-text);
    border: 2px solid var(--color-border);
  }

  @media (max-width: 480px) {
    .game-title { font-size: 1.4rem; }
    .sakura-img { width: 60px; }
    .word-ja { font-size: 1.5rem; }
  }
</style>
