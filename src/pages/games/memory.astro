---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="🃏 ガジェット神経衰弱"
  description="ガジェットの絵文字と名前を合わせる神経衰弱ゲーム！6ペア全部揃えよう！"
>
  <div class="game-page">
    <div class="game-header">
      <a href="/games/" class="back-link">← ゲームコーナーへ</a>
      <h1 class="game-title">🃏 ガジェット神経衰弱</h1>
      <p class="game-subtitle">同じガジェットのペアを見つけよう！</p>
    </div>

    <div class="game-container">
      <!-- サクラキャラ -->
      <div class="sakura-area">
        <div class="chibi-wrapper">
          <img class="sakura-img chibi-light" src="/images/games/chibi/sakura_chibi_v2_01_nobg.png" alt="サクラ" />
          <img class="sakura-img chibi-dark" src="/images/games/chibi/black/sakura_chibi_black_01_nobg.png" alt="サクラ" />
        </div>
        <div class="sakura-bubble">
          <p id="sakura-message">カードをめくってペアを揃えてね！🌸</p>
        </div>
      </div>

      <!-- ゲーム情報 -->
      <div class="game-info" id="game-info">
        <span class="info-badge">手数: <strong id="moves">0</strong></span>
        <span class="info-badge">ペア: <strong id="pairs">0</strong> / 6</span>
        <button class="btn btn--sm btn--secondary" id="btn-restart">リプレイ 🔄</button>
      </div>

      <!-- カードグリッド -->
      <div class="card-grid" id="card-grid"></div>

      <!-- クリア画面 -->
      <div class="clear-screen" id="clear-screen" style="display:none">
        <div class="clear-card">
          <div class="clear-emoji">🎉</div>
          <h2 class="clear-title">クリア！</h2>
          <p class="clear-moves"><strong id="clear-moves">0</strong> 手でクリア！</p>
          <p class="clear-comment" id="clear-comment"></p>
          <button class="btn btn--primary" id="btn-play-again">もう一度！🔄</button>
          <a href="/games/" class="btn btn--secondary">ゲーム一覧へ</a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const cards = [
    { emoji: '📱', name: 'スマートフォン' },
    { emoji: '💻', name: 'ノートPC' },
    { emoji: '🎧', name: 'ヘッドホン' },
    { emoji: '🔋', name: 'モバイルバッテリー' },
    { emoji: '⌨️', name: 'キーボード' },
    { emoji: '🖱️', name: 'マウス' },
  ];

  const sakuraMessages = {
    flip: ['どれかな？🤔', 'いい感じ！', '覚えてる？✨', 'そこだ！', 'うーん…🌸'],
    match: ['やった！ペア！🎉', '合った！すごい！✨', 'パーフェクト！🌸', 'さすが！💯'],
    miss: ['あ〜惜しい！😅', 'もう一回！', 'うーん、違った…', '次は覚えたよ！📚'],
    clear: ['おめでとう！全部揃えたね！🎊', 'すごい！全ペア発見！✨', '完璧！ガジェット神経衰弱マスター！🏆'],
  };

  function rand(arr) { return arr[Math.floor(Math.random() * arr.length)]; }
  function setSakura(msg) { document.getElementById('sakura-message').textContent = msg; }

  const CHIBI = {
    idle:    { l: '/images/games/chibi/sakura_chibi_v2_01_nobg.png',   d: '/images/games/chibi/black/sakura_chibi_black_01_nobg.png' },
    think:   { l: '/images/games/chibi/sakura_chibi_v2_03_nobg.png',   d: '/images/games/chibi/black/sakura_chibi_black_03_nobg.png' },
    correct: { l: '/images/games/chibi/sakura_chibi_v2_01_nobg.png',   d: '/images/games/chibi/black/sakura_chibi_black_04_nobg.png' },
    wrong:   { l: '/images/games/chibi/sakura_chibi_v2_08_nobg.png',   d: '/images/games/chibi/black/sakura_chibi_black_08_nobg.png' },
    guts:    { l: '/images/games/chibi/sakura_chibi_v2_04_nobg.png',   d: '/images/games/chibi/black/sakura_chibi_black_04_nobg.png' },
  };

  function setChibiPose(pose) {
    const p = CHIBI[pose] || CHIBI.idle;
    const lImg = document.querySelector('.chibi-light');
    const dImg = document.querySelector('.chibi-dark');
    if (lImg) lImg.src = p.l;
    if (dImg) dImg.src = p.d;
  }

  let flipped = [];
  let matched = [];
  let moves = 0;
  let pairs = 0;
  let isLocked = false;

  function shuffle(arr) {
    const a = [...arr];
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  function buildDeck() {
    const deck = [];
    cards.forEach(c => {
      deck.push({ ...c, side: 'emoji', id: c.name + '_emoji' });
      deck.push({ ...c, side: 'name', id: c.name + '_name' });
    });
    return shuffle(deck);
  }

  function renderGrid() {
    const grid = document.getElementById('card-grid');
    grid.innerHTML = '';
    flipped = [];
    matched = [];
    moves = 0;
    pairs = 0;
    isLocked = false;
    updateInfo();
    document.getElementById('clear-screen').style.display = 'none';
    grid.style.display = '';

    const deck = buildDeck();
    deck.forEach((card, idx) => {
      const el = document.createElement('div');
      el.className = 'memory-card';
      el.dataset.key = card.name;
      el.dataset.idx = idx;
      el.innerHTML = `
        <div class="card-inner">
          <div class="card-front"><span class="card-back-deco">♦</span></div>
          <div class="card-back">${card.side === 'emoji' ? card.emoji : card.name}</div>
        </div>`;
      el.addEventListener('click', () => flipCard(el, card));
      grid.appendChild(el);
    });
    setSakura('カードをめくってペアを揃えてね！🌸');
    setChibiPose('idle');
  }

  function flipCard(el, card) {
    if (isLocked) return;
    if (el.classList.contains('flipped') || el.classList.contains('matched')) return;
    if (flipped.length >= 2) return;

    el.classList.add('flipped');
    flipped.push({ el, card });
    setSakura(rand(sakuraMessages.flip));
    setChibiPose('think');

    if (flipped.length === 2) {
      moves++;
      updateInfo();
      isLocked = true;
      const [a, b] = flipped;
      if (a.card.name === b.card.name && a.card.side !== b.card.side) {
        // match
        setTimeout(() => {
          a.el.classList.add('matched');
          b.el.classList.add('matched');
          pairs++;
          updateInfo();
          setSakura(rand(sakuraMessages.match));
          setChibiPose('correct');
          flipped = [];
          isLocked = false;
          if (pairs === 6) showClear();
        }, 500);
      } else {
        // mismatch
        setSakura(rand(sakuraMessages.miss));
        setChibiPose('wrong');
        setTimeout(() => {
          a.el.classList.remove('flipped');
          b.el.classList.remove('flipped');
          flipped = [];
          isLocked = false;
        }, 900);
      }
    }
  }

  function updateInfo() {
    document.getElementById('moves').textContent = moves;
    document.getElementById('pairs').textContent = pairs;
  }

  function showClear() {
    document.getElementById('card-grid').style.display = 'none';
    const cs = document.getElementById('clear-screen');
    cs.style.display = '';
    document.getElementById('clear-moves').textContent = moves;
    document.getElementById('clear-comment').textContent = rand(sakuraMessages.clear);
    setSakura(rand(sakuraMessages.clear));
    setChibiPose('guts');
  }

  document.getElementById('btn-restart')?.addEventListener('click', renderGrid);
  document.getElementById('btn-play-again')?.addEventListener('click', renderGrid);

  renderGrid();
</script>

<style>
  .game-page {
    max-width: 720px;
    margin: 0 auto;
    padding: 1.5rem 1rem 4rem;
  }

  .game-header { margin-bottom: 2rem; }

  .back-link {
    color: var(--color-primary);
    text-decoration: none;
    font-size: 0.875rem;
    display: inline-block;
    margin-bottom: 0.75rem;
  }
  .back-link:hover { text-decoration: underline; }

  .game-title {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-primary);
    margin-bottom: 0.25rem;
  }

  .game-subtitle {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .sakura-area {
    display: flex;
    align-items: flex-end;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .chibi-wrapper { flex-shrink: 0; }
  .chibi-dark { display: none; }
  [data-theme="dark"] .chibi-light { display: none; }
  [data-theme="dark"] .chibi-dark { display: block; }
  .sakura-img { width: 80px; height: auto; display: block; }

  .sakura-bubble {
    background: var(--bubble-bg, #fff0f5);
    border: 2px solid #f9a8c9;
    border-radius: 1rem;
    padding: 0.6rem 1rem;
    font-size: 0.9rem;
    color: var(--color-text);
    position: relative;
    max-width: 400px;
    line-height: 1.5;
  }

  .sakura-bubble::before {
    content: '';
    position: absolute;
    left: -14px;
    bottom: 16px;
    border: 7px solid transparent;
    border-right-color: #f9a8c9;
  }

  .sakura-bubble::after {
    content: '';
    position: absolute;
    left: -10px;
    bottom: 17px;
    border: 6px solid transparent;
    border-right-color: var(--bubble-bg, #fff0f5);
  }

  .game-info {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .info-badge {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.3rem 0.9rem;
    font-size: 0.875rem;
    color: var(--color-text);
  }

  .info-badge strong { color: var(--color-primary); }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .memory-card {
    aspect-ratio: 3/4;
    cursor: pointer;
    perspective: 600px;
  }

  .card-inner {
    width: 100%;
    height: 100%;
    position: relative;
    transform-style: preserve-3d;
    -webkit-transform-style: preserve-3d;
    transition: transform 0.4s;
    border-radius: 0.75rem;
  }

  .memory-card.flipped .card-inner,
  .memory-card.matched .card-inner {
    transform: rotateY(180deg);
  }

  .card-front, .card-back {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    border-radius: 0.75rem;
    font-size: 1.4rem;
    line-height: 1.3;
    text-align: center;
    padding: 0.25rem;
    word-break: break-all;
    border: 2px solid var(--color-border);
  }

  /* カード裏面（クリック前）: トランプ裏のようなデザイン */
  .card-front {
    background: linear-gradient(135deg, #c0392b, #8e1a1a);
    border: 3px solid #e74c3c;
    box-shadow: inset 0 0 0 4px rgba(255,255,255,0.15);
    overflow: hidden;
  }

  .card-front::before {
    content: '';
    position: absolute;
    inset: 6px;
    border: 2px solid rgba(255,255,255,0.4);
    border-radius: 0.4rem;
  }

  .card-back-deco {
    font-size: 2rem;
    color: rgba(255,255,255,0.7);
    text-shadow: 0 1px 4px rgba(0,0,0,0.4);
    position: relative;
    z-index: 1;
  }

  .card-back {
    background: var(--color-surface);
    color: var(--color-text);
    transform: rotateY(180deg);
    font-size: 1.1rem;
  }

  .memory-card.matched .card-back {
    background: #d1fae5;
    border-color: #34d399;
    color: #065f46;
  }

  [data-theme="dark"] .memory-card.matched .card-back {
    background: #064e3b;
    border-color: #34d399;
    color: #6ee7b7;
  }

  /* クリア画面 */
  .clear-screen {
    text-align: center;
    padding: 2rem 0;
  }

  .clear-card {
    background: var(--color-surface);
    border-radius: var(--radius-xl);
    padding: 2.5rem 2rem;
    box-shadow: var(--shadow-md);
    border: 2px solid #f9a8c9;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    max-width: 380px;
    width: 100%;
  }

  .clear-emoji { font-size: 3.5rem; }

  .clear-title {
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-primary);
    margin: 0;
  }

  .clear-moves { font-size: 1.1rem; color: var(--color-text); margin: 0; }
  .clear-moves strong { color: var(--color-primary); font-size: 1.5rem; }
  .clear-comment { font-size: 0.95rem; color: var(--color-text-muted); margin: 0; }

  .btn {
    display: inline-block;
    padding: 0.75rem 1.75rem;
    border-radius: var(--radius);
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    border: none;
    text-decoration: none;
    transition: filter 0.15s, transform 0.1s;
    text-align: center;
    margin: 0.25rem;
  }

  .btn:hover { filter: brightness(1.08); transform: translateY(-2px); }

  .btn--primary {
    background: linear-gradient(135deg, #f9a8c9, #f06090);
    color: #fff;
    box-shadow: 0 4px 14px rgba(240,96,144,0.3);
  }

  .btn--secondary {
    background: var(--color-surface-raised);
    color: var(--color-text);
    border: 2px solid var(--color-border);
  }

  .btn--sm { padding: 0.35rem 0.9rem; font-size: 0.8rem; }

  @media (max-width: 480px) {
    .card-grid { grid-template-columns: repeat(4, 1fr); gap: 0.4rem; }
    .game-title { font-size: 1.4rem; }
    .sakura-img { width: 60px; }
    .chibi-wrapper { flex-shrink: 0; }
    .card-back { font-size: 0.75rem; }
  }
</style>
