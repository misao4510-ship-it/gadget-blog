  let lastImageIdx = -1;
  const activeBubbles = [];

  // Anti-cheat
  let lastTapTime = 0;
  const MIN_TAP_INTERVAL = 50; // ms
  const MAX_TAPS_PER_SECOND = 20;
  let tapsThisSecond = 0;
  let secondTimer = null;
  let unlockShown = false;

  function isDark() {
    return document.documentElement.getAttribute('data-theme') === 'dark';
  }

  function getImageSet() {
    return isDark() ? DARK_IMAGES : LIGHT_IMAGES;
  }

  function initQueues() {
    commentQueue = shuffle(COMMENTS.map((_, i) => i));
    commentIndex = 0;
    const imgSet = getImageSet();
    imageQueue = shuffle(imgSet.map((_, i) => i));
    imageIndex = 0;
    currentImageSet = imgSet;
  }

  function nextComment() {
    if (commentIndex >= commentQueue.length) {
      const lastIdx = commentQueue[commentQueue.length - 1];
      commentQueue = shuffle(COMMENTS.map((_, i) => i).filter(i => i !== lastIdx));
      commentIndex = 0;
    }
    return COMMENTS[commentQueue[commentIndex++]];
  }

  function nextImage() {
    const imgSet = getImageSet();
    if (imgSet !== currentImageSet || imageIndex >= imageQueue.length) {
      currentImageSet = imgSet;
      imageQueue = shuffle(imgSet.map((_, i) => i).filter(i => i !== lastImageIdx));
      imageIndex = 0;
    }
    const idx = imageQueue[imageIndex++];
    lastImageIdx = idx;
    return currentImageSet[idx];
  }

  // ============================================================
  // DOM refs
  // ============================================================
  const tapArea = document.getElementById('tapArea');
  const sakuraImg = document.getElementById('sakuraImg');
  const tapCounter = document.getElementById('tapCounter');

  // ============================================================
  // Init
  // ============================================================
  initQueues();

  // ============================================================
  // 1万回達成演出
  // ============================================================
  function showUnlockMessage() {
    if (unlockShown) return;
    unlockShown = true;

    const overlay = document.createElement('div');
    overlay.className = 'sinv-overlay';
    overlay.innerHTML = `
      <div class="sinv-backdrop"></div>
      <div class="sinv-card">
        <div class="sinv-stars">✨🌸✨🌸✨</div>
        <div class="sinv-title">✨ 100回達成！✨</div>
        <div class="sinv-subtitle">すごい…信じられません！</div>
        <div class="sinv-envelope-wrap">
          <div class="sinv-envelope">
            <div class="sinv-envelope-flap">💗</div>
            <div class="sinv-letter">
              <div class="sinv-letter-header">🌸 ご招待状 🌸</div>
              <div class="sinv-letter-body">
                わ、わわわ！！<br>
                100回もタップしてくれたんですね…<br>
                こんなに愛でてくれたんですね…💗
              </div>
              <div class="sinv-letter-sign">— サクラ より —</div>
            </div>
          </div>
        </div>
        <div class="sinv-message">特別に、サクラの部屋への扉を開けてあげます🌸</div>
        <button class="sinv-btn" id="unlock-room-btn">🌸 サクラの部屋へ</button>
        <button class="sinv-close-btn" id="unlock-close-btn">閉じる</button>
      </div>
    `;
    document.body.appendChild(overlay);

    document.getElementById('unlock-room-btn').addEventListener('click', () => {
      sessionStorage.setItem('sakura_room_via_tap', 'true');
      window.location.href = '/sakura-room/';
    });
    document.getElementById('unlock-close-btn').addEventListener('click', () => {
      overlay.remove();
      unlockShown = false;
    });
  }

  // ============================================================
  // Tap handler
  // ============================================================
  function onTap(e) {
    e.preventDefault();
    const clientX = e.touches ? e.touches[0].clientX : e.clientX;
    const clientY = e.touches ? e.touches[0].clientY : e.clientY;

    // Anti-cheat: interval check
    const now = Date.now();
    if (now - lastTapTime < MIN_TAP_INTERVAL) return;

    // Anti-cheat: per-second limit
    if (tapsThisSecond >= MAX_TAPS_PER_SECOND) return;

    lastTapTime = now;
    tapsThisSecond++;
    if (!secondTimer) {
      secondTimer = setTimeout(() => {
        tapsThisSecond = 0;
        secondTimer = null;
      }, 1000);
    }

    tapCount++;

    // 100回達成チェック
    if (tapCount === 100) {
      showUnlockMessage();
    }

    // Counter update
    tapCounter.textContent = `♡ ${tapCount}回なでなで`;
    tapCounter.classList.remove('bump');
    void tapCounter.offsetWidth;
    tapCounter.classList.add('bump');
    setTimeout(() => tapCounter.classList.remove('bump'), 200);

    // Bounce animation
    sakuraImg.classList.remove('bounce');
    void sakuraImg.offsetWidth;
    sakuraImg.classList.add('bounce');
    setTimeout(() => sakuraImg.classList.remove('bounce'), 350);

    // Image switch every 10 taps
    if (tapCount % 10 === 0) {
      const newSrc = nextImage();
      sakuraImg.classList.remove('switch-anim');
      void sakuraImg.offsetWidth;
      sakuraImg.classList.add('switch-anim');
      setTimeout(() => {
        sakuraImg.src = newSrc;
      }, 160);
      setTimeout(() => sakuraImg.classList.remove('switch-anim'), 400);
    }

    // Ripple
    createRipple(clientX, clientY);

    // Speech bubble
    createBubble(clientX, clientY);
  }

  function createRipple(x, y) {
    const el = document.createElement('div');
    el.className = 'tap-effect';
    el.style.left = x + 'px';
    el.style.top = y + 'px';
    document.body.appendChild(el);
    el.addEventListener('animationend', () => el.remove());
  }

  function createBubble(x, y) {
    // Max 3 simultaneous bubbles
    if (activeBubbles.length >= 3) {
      const old = activeBubbles.shift();
      old.remove();
    }

    const text = nextComment();
    const el = document.createElement('div');
    el.className = 'tap-speech-bubble';
    el.textContent = text;

    // Position near tap but keep in viewport
    const bw = 220;
    const bh = 80;
    let bx = x + 10;
    let by = y - bh - 10;
    if (bx + bw > window.innerWidth) bx = x - bw - 10;
    if (by < 0) by = y + 20;

    el.style.left = bx + 'px';
    el.style.top = by + 'px';

    document.body.appendChild(el);
    activeBubbles.push(el);

    setTimeout(() => {
      el.remove();
      const idx = activeBubbles.indexOf(el);
      if (idx !== -1) activeBubbles.splice(idx, 1);
    }, 2000);
  }

  tapArea.addEventListener('click', onTap);
  tapArea.addEventListener('touchstart', onTap, { passive: false });

  // Re-init image queue on theme change
  const observer = new MutationObserver(() => {
    currentImageSet = getImageSet();
    imageQueue = shuffle(currentImageSet.map((_, i) => i));
    imageIndex = 0;
  });
  observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
</script>
