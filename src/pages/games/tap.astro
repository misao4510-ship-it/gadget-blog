---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="🌸 サクラを愛でる"
  description="サクラをタップして愛でよう！タップするたびにサクラがいろんなリアクションをしてくれるよ♪"
>
  <div class="tap-page">
    <div class="tap-header">
      <h1 class="tap-title">🌸 サクラを愛でる</h1>
      <div class="tap-counter" id="tapCounter">♡ 0回なでなで</div>
    </div>

    <div class="tap-area" id="tapArea">
      <div class="chibi-container" id="chibiContainer">
        <img id="sakuraImg" src="/images/games/chibi/sakura_chibi_v2_01_nobg.png" alt="サクラ" class="sakura-chibi" />
      </div>
    </div>

    <div class="tap-hint">タップ・クリックしてね！</div>
  </div>
</BaseLayout>

<style>
  .tap-page {
    max-width: 600px;
    margin: 0 auto;
    padding: 1.5rem 1rem 4rem;
    min-height: calc(100vh - 120px);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .tap-header {
    text-align: center;
    margin-bottom: 1rem;
    width: 100%;
  }

  .tap-title {
    font-family: var(--font-heading);
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  .tap-counter {
    display: inline-block;
    background: linear-gradient(135deg, #ffe0ef, #ffc0dc);
    color: #a0124c;
    font-weight: 700;
    font-size: 1.1rem;
    padding: 0.4rem 1.2rem;
    border-radius: 999px;
    border: 2px solid #f9a8c9;
    box-shadow: 0 2px 8px rgba(249, 168, 201, 0.4);
    transition: transform 0.15s;
  }

  [data-theme="dark"] .tap-counter {
    background: linear-gradient(135deg, #2a0a1e, #3a1030);
    color: #f9a8c9;
    border-color: #8a3060;
  }

  .tap-counter.bump {
    transform: scale(1.1);
  }

  .tap-area {
    flex: 1;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 320px;
    position: relative;
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
  }

  .chibi-container {
    position: relative;
    display: inline-block;
  }

  .sakura-chibi {
    width: 420px;
    max-width: 85vw;
    height: auto;
    display: block;
    transition: transform 0.15s ease;
    filter: drop-shadow(0 4px 16px rgba(249, 168, 201, 0.4));
  }

  .sakura-chibi.bounce {
    animation: bounceAnim 0.35s ease;
  }

  .sakura-chibi.switch-anim {
    animation: switchFade 0.4s ease;
  }

  @keyframes bounceAnim {
    0% { transform: scale(1); }
    40% { transform: scale(0.92) rotate(-3deg); }
    70% { transform: scale(1.06) rotate(2deg); }
    100% { transform: scale(1) rotate(0deg); }
  }

  @keyframes switchFade {
    0% { opacity: 1; transform: scale(1); }
    40% { opacity: 0; transform: scale(0.85); }
    60% { opacity: 0; transform: scale(0.85); }
    100% { opacity: 1; transform: scale(1); }
  }

  .tap-hint {
    margin-top: 0.5rem;
    color: var(--color-text-muted);
    font-size: 0.85rem;
    text-align: center;
    animation: hintPulse 2s ease-in-out infinite;
  }

  @keyframes hintPulse {
    0%, 100% { opacity: 0.6; }
    50% { opacity: 1; }
  }

  @media (max-width: 480px) {
    .tap-title { font-size: 1.4rem; }
    .sakura-chibi { width: 300px; }
  }
</style>

<!-- グローバルスタイル: JS動的生成要素はscopedスタイルが当たらないためis:globalで定義 -->
<style is:global>
  /* Ripple effect */
  .tap-effect {
    position: fixed;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(236, 72, 153, 0.4);
    animation: tapRipple 0.6s ease-out forwards;
    pointer-events: none;
    transform: translate(-50%, -50%);
    z-index: 9999;
  }

  @keyframes tapRipple {
    0% { transform: translate(-50%, -50%) scale(0); opacity: 1; }
    100% { transform: translate(-50%, -50%) scale(3); opacity: 0; }
  }

  /* Speech bubble */
  .tap-speech-bubble {
    position: fixed;
    background: #fff0f5;
    border: 2px solid #f9a8c9;
    border-radius: 1rem;
    padding: 0.6rem 1rem;
    max-width: 220px;
    font-size: 0.875rem;
    color: #333;
    line-height: 1.5;
    pointer-events: none;
    z-index: 9998;
    box-shadow: 0 4px 12px rgba(249, 168, 201, 0.3);
    animation: tapBubble 2s ease forwards;
    word-break: break-word;
  }

  [data-theme="dark"] .tap-speech-bubble {
    background: #1a0a14;
    border-color: #8a3060;
    color: #f0d0e0;
  }

  @keyframes tapBubble {
    0% { opacity: 0; transform: translateY(0) scale(0.8); }
    15% { opacity: 1; transform: translateY(-8px) scale(1); }
    70% { opacity: 1; transform: translateY(-12px) scale(1); }
    100% { opacity: 0; transform: translateY(-20px) scale(0.95); }
  }

</style>

