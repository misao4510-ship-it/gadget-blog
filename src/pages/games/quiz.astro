---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="🧠 ガジェットクイズ"
  description="ガジェットのスペック・用語・豆知識を4択クイズで試そう！10問モードと100問モードから選べる！"
>
  <div class="quiz-page">
    <div class="quiz-header">
      <a href="/games/" class="back-link">← ゲームコーナーへ</a>
      <h1 class="quiz-title">🧠 ガジェットクイズ</h1>
      <p class="quiz-subtitle">サクラがガジェットクイズを出題しますよ！</p>
    </div>

    <!-- クイズUI -->
    <div class="quiz-container" id="quiz-container">
      <!-- 正解/不正解オーバーレイ -->
      <div class="answer-overlay" id="answer-overlay" style="display:none"></div>
      <!-- サクラキャラ -->
      <div class="sakura-area">
        <div class="chibi-wrapper">
          <img class="sakura-img chibi-light" src="/images/games/chibi/sakura_chibi_v2_01_nobg.png" alt="サクラ" />
          <img class="sakura-img chibi-dark" src="/images/games/chibi/black/sakura_chibi_black_01_nobg.png" alt="サクラ" />
        </div>
        <div class="sakura-bubble" id="sakura-bubble">
          <p id="sakura-message">準備はよろしいですか？🌸 スタートボタンを押してみてくださいね！</p>
        </div>
      </div>

      <!-- スタート画面（モード選択） -->
      <div class="screen screen--start" id="screen-start">
        <div class="start-card">
          <h2>ガジェットクイズ 🎮</h2>
          <p class="mode-desc">モードを選んでね！</p>
          <div class="mode-grid">
            <button class="mode-btn" id="btn-mode-10">
              <span class="mode-icon">⚡</span>
              <span class="mode-name">サクッと10問</span>
              <span class="mode-detail">気軽に挑戦！</span>
            </button>
            <button class="mode-btn mode-btn--challenge" id="btn-mode-100">
              <span class="mode-icon">🔥</span>
              <span class="mode-name">本気の100問</span>
              <span class="mode-detail">ガジェット博士を目指せ！</span>
            </button>
          </div>
          <p class="quiz-total" id="quiz-total"></p>
        </div>
      </div>

      <!-- 連続正解表示 -->
      <div class="correct-streak-display" id="correct-streak-display"></div>

      <!-- 問題画面 -->
      <div class="screen screen--question" id="screen-question" style="display:none">
        <div class="progress-bar-wrap">
          <div class="progress-bar" id="progress-bar"></div>
        </div>
        <div class="question-info">
          <span class="question-number" id="question-number">問題 1 / 10</span>
          <span class="question-score" id="question-score">正解: 0</span>
        </div>
        <div class="question-card">
          <p class="question-text" id="question-text">問題文がここに入ります</p>
        </div>
        <div class="choices-grid" id="choices-grid">
          <!-- 選択肢はJSで生成 -->
        </div>
      </div>

      <!-- 結果画面 -->
      <div class="screen screen--result" id="screen-result" style="display:none">
        <div class="result-card">
          <div class="result-score-display">
            <span class="result-score-num" id="result-score-num">0</span>
            <span class="result-score-denom" id="result-score-denom"> / 10問正解</span>
          </div>
          <p class="result-message" id="result-message"></p>
          <div class="result-actions">
            <button class="btn btn--primary" id="btn-replay">もう一度チャレンジ！🔄</button>
            <a href="/games/" class="btn btn--secondary">ゲーム一覧へ</a>
          </div>
        </div>
        <div class="result-review" id="result-review">
          <h3>📝 解答まとめ</h3>
          <div id="review-list"></div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // ===== クイズデータ（外部JSONから読み込み）=====
  let quizData = [];
  async function loadQuizData() {
    const resp = await fetch('/data/quiz_questions.json');
    quizData = await resp.json();
    const totalEl = document.getElementById('quiz-total');
    if (totalEl) totalEl.textContent = `全${quizData.length}問から出題`;
  }
  loadQuizData();


  // ===== サクラのコメント =====
  const sakuraMessages = {
    start: ["準備はよろしいですか？🌸 スタートボタンを押してみてくださいね！"],
    question: ["じっくり考えてみてくださいね！🤔", "どれだと思いますか？✨", "落ち着いて考えてみてくださいね🌸", "難問ですよ〜！頑張ってください！💪", "自信を持って答えてみてくださいね！💪"],
    correct: ["やったー！正解です！🎉", "すごい！大正解ですよ！✨", "完璧です！さすがですね！🌸", "正解！ガジェット通ですね！💯", "その通りです！素晴らしいですよ！🙌"],
    wrong: ["あ〜、惜しかったですね！😅", "残念でした…次は頑張ってくださいね！💦", "うーん、これは難しかったですね🤔", "ドンマイです！次の問題にいきましょう！", "そうでしたか…でも勉強になりましたよ！📚"],
    result: {
      perfect: "満点！全問正解です！あなたはガジェット博士ですよ！🎓✨",
      great: "すごい！かなりのガジェット通ですね！🌸",
      good: "なかなかやりますね！もう少しで満点ですよ！💪",
      ok: "半分以上正解です！もう一度チャレンジしてみてくださいね！🔄",
      low: "ガジェットの世界は奥が深いですね！一緒に勉強しましょう！📚"
    }
  };

  function rand(arr) {
    return arr[Math.floor(Math.random() * arr.length)];
  }

  const CHIBI = {
    idle:    { l: '/images/games/chibi/sakura_chibi_v2_01_nobg.png',   d: '/images/games/chibi/black/sakura_chibi_black_01_nobg.png' },
    think:   { l: '/images/games/chibi/sakura_chibi_v2_03_nobg.png',   d: '/images/games/chibi/black/sakura_chibi_black_03_nobg.png' },
    correct: { l: '/images/games/chibi/sakura_chibi_v2_01_nobg.png',   d: '/images/games/chibi/black/sakura_chibi_black_04_nobg.png' },
    wrong:   { l: '/images/games/chibi/sakura_chibi_v2_08_nobg.png',   d: '/images/games/chibi/black/sakura_chibi_black_08_nobg.png' },
    guts:    { l: '/images/games/chibi/sakura_chibi_v2_04_nobg.png',   d: '/images/games/chibi/black/sakura_chibi_black_04_nobg.png' },
  };

  function setChibiPose(pose) {
    const p = CHIBI[pose] || CHIBI.idle;
    const lImg = document.querySelector('.chibi-light');
    const dImg = document.querySelector('.chibi-dark');
    if (lImg) lImg.src = p.l;
    if (dImg) dImg.src = p.d;
  }

  function showAnswerOverlay(isCorrect) {
    const el = document.getElementById('answer-overlay');
    if (!el) return;
    el.textContent = isCorrect ? '⭕' : '❌';
    el.className = 'answer-overlay answer-overlay--' + (isCorrect ? 'correct' : 'wrong');
    el.style.display = 'flex';
    setTimeout(() => { el.style.display = 'none'; }, isCorrect ? 1200 : 900);
  }

  function chibiBounce() {
    const wrapper = document.querySelector('.chibi-wrapper');
    if (!wrapper) return;
    wrapper.classList.remove('chibi-bounce');
    void wrapper.offsetWidth; // reflow
    wrapper.classList.add('chibi-bounce');
    setTimeout(() => wrapper.classList.remove('chibi-bounce'), 700);
  }

  // ===== 連続正解記録 (localStorage永続) =====
  let consecutiveCorrect = parseInt(localStorage.getItem('quiz_correct_streak') || '0');

  function saveCorrectStreak() {
    localStorage.setItem('quiz_correct_streak', String(consecutiveCorrect));
  }

  function updateCorrectStreakDisplay() {
    const el = document.getElementById('correct-streak-display');
    if (!el) return;
    if (consecutiveCorrect <= 0) {
      el.textContent = '';
      el.className = 'correct-streak-display';
    } else if (consecutiveCorrect >= 100) {
      el.textContent = `🏆 ${consecutiveCorrect}問連続正解！`;
      el.className = 'correct-streak-display correct-streak-display--max';
    } else {
      el.textContent = `🔥 ${consecutiveCorrect}問連続正解中`;
      el.className = consecutiveCorrect >= 50 ? 'correct-streak-display correct-streak-display--hot' : 'correct-streak-display correct-streak-display--on';
    }
  }

  function showQuizInvitation() {
    const inv = document.createElement('div');
    inv.className = 'sinv-overlay';
    inv.innerHTML = `
      <div class="sinv-backdrop"></div>
      <div class="sinv-card">
        <div class="sinv-stars">🧠✨🌸✨🏆</div>
        <div class="sinv-title">🎓 100問連続正解！ 🎓</div>
        <div class="sinv-subtitle">ガジェット博士に認定です！</div>
        <div class="sinv-envelope-wrap">
          <div class="sinv-envelope">
            <div class="sinv-envelope-flap">💌</div>
            <div class="sinv-letter">
              <div class="sinv-letter-header">🌸 ご招待状 🌸</div>
              <div class="sinv-letter-body">
                100問連続正解おめでとうございます！<br>
                サクラの秘密の部屋への<br>
                特別招待状をお届けします✨
              </div>
              <div class="sinv-letter-sign">— サクラ より —</div>
            </div>
          </div>
        </div>
        <div class="sinv-message">サクラの部屋への特別招待状が届きました！</div>
        <button class="sinv-btn" id="quiz-invite-btn">📩 招待状を開く</button>
        <button class="sinv-close-btn" id="quiz-invite-close">今は行かない</button>
      </div>
    `;
    document.body.appendChild(inv);
    consecutiveCorrect = 0;
    saveCorrectStreak();
    updateCorrectStreakDisplay();
    document.getElementById('quiz-invite-btn')?.addEventListener('click', () => {
      sessionStorage.setItem('sakura_room_via_redirect', 'true');
      window.location.href = '/sakura-room/';
    });
    document.getElementById('quiz-invite-close')?.addEventListener('click', () => {
      inv.remove();
    });
  }

  // ===== ゲーム状態 =====
  let currentQ = 0;
  let score = 0;
  let answered = false;
  let results = [];
  let shuffledData = [];
  let quizMode = 10; // 10 or 100

  function shuffleArray(arr) {
    const a = [...arr];
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  function setSakuraMessage(msg) {
    document.getElementById('sakura-message').textContent = msg;
  }

  function showScreen(id) {
    ['screen-start', 'screen-question', 'screen-result'].forEach(s => {
      const el = document.getElementById(s);
      if (el) el.style.display = s === id ? '' : 'none';
    });
  }

  function startQuiz() {
    currentQ = 0;
    score = 0;
    results = [];
    const count = Math.min(quizMode, quizData.length);
    shuffledData = shuffleArray(quizData).slice(0, count);
    setChibiPose('idle');
    showScreen('screen-question');
    showQuestion();
  }

  function showQuestion() {
    answered = false;
    const q = shuffledData[currentQ];
    const total = shuffledData.length;

    // プログレスバー
    document.getElementById('progress-bar').style.width = `${(currentQ / total) * 100}%`;
    document.getElementById('question-number').textContent = `問題 ${currentQ + 1} / ${total}`;
    document.getElementById('question-score').textContent = `正解: ${score}`;
    document.getElementById('question-text').textContent = q.q;

    // 選択肢をシャッフル（正解インデックスを保持）
    const choiceIndices = shuffleArray([0, 1, 2, 3]);
    const grid = document.getElementById('choices-grid');
    grid.innerHTML = '';

    choiceIndices.forEach(origIdx => {
      const btn = document.createElement('button');
      btn.className = 'choice-btn';
      btn.textContent = q.choices[origIdx];
      btn.dataset.index = origIdx;
      btn.addEventListener('click', () => selectAnswer(origIdx, btn));
      grid.appendChild(btn);
    });

    setSakuraMessage(rand(sakuraMessages.question));
    setChibiPose('think');
  }

  function selectAnswer(selectedIdx, btn) {
    if (answered) return;
    answered = true;

    const q = shuffledData[currentQ];
    const isCorrect = selectedIdx === q.answer;

    if (isCorrect) {
      score++;
      consecutiveCorrect++;
      saveCorrectStreak();
      updateCorrectStreakDisplay();
      btn.classList.add('choice-btn--correct');
      setSakuraMessage(rand(sakuraMessages.correct));
      setChibiPose('correct');
      showAnswerOverlay(true);
      chibiBounce();
      if (consecutiveCorrect >= 100) {
        setTimeout(showQuizInvitation, 1200);
      }
    } else {
      consecutiveCorrect = 0;
      saveCorrectStreak();
      updateCorrectStreakDisplay();
      btn.classList.add('choice-btn--wrong');
      setSakuraMessage(rand(sakuraMessages.wrong));
      setChibiPose('wrong');
      showAnswerOverlay(false);
      // 正解を緑表示
      document.querySelectorAll('.choice-btn').forEach(b => {
        if (parseInt(b.dataset.index) === q.answer) {
          b.classList.add('choice-btn--correct');
        }
      });
    }

    // 解説を表示
    const grid = document.getElementById('choices-grid');
    const exp = document.createElement('div');
    exp.className = 'explanation';
    exp.innerHTML = `<span class="${isCorrect ? 'exp--correct' : 'exp--wrong'}">${isCorrect ? '✅ 正解！' : '❌ 不正解…'}</span> ${q.explanation}`;
    grid.appendChild(exp);

    results.push({ q: q.q, correctIdx: q.answer, selectedIdx, isCorrect, explanation: q.explanation, choices: q.choices });

    document.getElementById('question-score').textContent = `正解: ${score}`;

    // 次へボタン追加
    const nextBtn = document.createElement('button');
    nextBtn.className = 'btn btn--next';
    nextBtn.textContent = currentQ < shuffledData.length - 1 ? '次の問題へ →' : '結果を見る 🏆';
    nextBtn.addEventListener('click', () => {
      currentQ++;
      if (currentQ < shuffledData.length) {
        showQuestion();
      } else {
        showResult();
      }
    });
    grid.appendChild(nextBtn);
  }

  function showResult() {
    showScreen('screen-result');
    const total = shuffledData.length;
    document.getElementById('result-score-num').textContent = score;
    document.getElementById('result-score-denom').textContent = ` / ${total}問正解`;

    const ratio = score / total;
    let msgKey;
    if (ratio === 1) msgKey = 'perfect';
    else if (ratio >= 0.8) msgKey = 'great';
    else if (ratio >= 0.6) msgKey = 'good';
    else if (ratio >= 0.5) msgKey = 'ok';
    else msgKey = 'low';

    document.getElementById('result-message').textContent = sakuraMessages.result[msgKey];
    setSakuraMessage(sakuraMessages.result[msgKey]);
    setChibiPose('guts');

    // 解答まとめ
    const reviewList = document.getElementById('review-list');
    reviewList.innerHTML = '';
    results.forEach((r, i) => {
      const item = document.createElement('div');
      item.className = `review-item ${r.isCorrect ? 'review-item--correct' : 'review-item--wrong'}`;
      item.innerHTML = `
        <div class="review-item__header">
          <span class="review-num">Q${i + 1}</span>
          <span class="review-result">${r.isCorrect ? '✅ 正解' : '❌ 不正解'}</span>
        </div>
        <p class="review-q">${r.q}</p>
        <p class="review-ans">正解: ${r.choices[r.correctIdx]}</p>
        <p class="review-exp">${r.explanation}</p>
      `;
      reviewList.appendChild(item);
    });

    document.getElementById('progress-bar').style.width = '100%';
  }

  // 初期化
  updateCorrectStreakDisplay();

  // ===== イベント =====
  document.getElementById('btn-mode-10')?.addEventListener('click', () => {
    quizMode = 10;
    startQuiz();
  });
  document.getElementById('btn-mode-100')?.addEventListener('click', () => {
    quizMode = 100;
    startQuiz();
  });
  document.getElementById('btn-replay')?.addEventListener('click', () => {
    showScreen('screen-start');
    setChibiPose('idle');
    setSakuraMessage(rand(sakuraMessages.start));
  });

  // ===== ちびキャラ ダーク/ライト切替（即時対応） =====
  function updateChibiTheme() {
    const lImg = document.querySelector('.chibi-light');
    const dImg = document.querySelector('.chibi-dark');
    if (!lImg || !dImg) return;
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    (lImg as HTMLElement).style.display = isDark ? 'none' : 'block';
    (dImg as HTMLElement).style.display = isDark ? 'block' : 'none';
  }
  updateChibiTheme();
  new MutationObserver(updateChibiTheme).observe(document.documentElement, {
    attributes: true, attributeFilter: ['data-theme']
  });
</script>

<style>
  /* 正解/不正解オーバーレイ */
  .answer-overlay {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 8rem;
    z-index: 200;
    pointer-events: none;
    animation: overlay-fade 0.2s ease-in;
  }

  .answer-overlay--correct { color: #e11d48; }
  .answer-overlay--wrong   { color: #374151; }

  @keyframes overlay-fade {
    from { opacity: 0; transform: scale(0.4); }
    to   { opacity: 1; transform: scale(1); }
  }

  /* chibi バウンスアニメーション */
  @keyframes chibi-bounce {
    0%   { transform: translateY(0); }
    30%  { transform: translateY(-18px) scale(1.1); }
    60%  { transform: translateY(-6px) scale(1.05); }
    100% { transform: translateY(0); }
  }

  .chibi-bounce { animation: chibi-bounce 0.6s ease-out; }

  .quiz-page {
    max-width: 720px;
    margin: 0 auto;
    padding: 1.5rem 1rem 4rem;
  }

  .quiz-header {
    margin-bottom: 2rem;
  }

  .back-link {
    color: var(--color-primary);
    text-decoration: none;
    font-size: 0.875rem;
    display: inline-block;
    margin-bottom: 0.75rem;
  }

  .back-link:hover { text-decoration: underline; }

  .quiz-title {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-primary);
    margin-bottom: 0.25rem;
  }

  .quiz-subtitle {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  /* サクラエリア */
  .sakura-area {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .chibi-wrapper { flex-shrink: 0; }

  .sakura-img {
    width: 160px;
    height: auto;
    display: block;
  }
  .chibi-dark { display: none; }
  [data-theme="dark"] .chibi-light { display: none; }
  [data-theme="dark"] .chibi-dark { display: block; }

  .sakura-bubble {
    background: var(--bubble-bg, #fff0f5);
    border: 2px solid #f9a8c9;
    border-radius: 1rem;
    padding: 0.6rem 1rem;
    font-size: 0.9rem;
    color: var(--color-text);
    position: relative;
    max-width: 400px;
    line-height: 1.5;
  }

  .sakura-bubble::before {
    content: '';
    position: absolute;
    left: -14px;
    bottom: 16px;
    border: 7px solid transparent;
    border-right-color: #f9a8c9;
  }

  .sakura-bubble::after {
    content: '';
    position: absolute;
    left: -10px;
    bottom: 17px;
    border: 6px solid transparent;
    border-right-color: var(--bubble-bg, #fff0f5);
  }

  /* プログレスバー */
  .progress-bar-wrap {
    height: 8px;
    background: var(--color-border);
    border-radius: 999px;
    overflow: hidden;
    margin-bottom: 1rem;
  }

  .progress-bar {
    height: 100%;
    background: linear-gradient(90deg, #f9a8c9, var(--color-primary));
    border-radius: 999px;
    transition: width 0.4s ease;
    width: 0%;
  }

  /* 問題情報 */
  .question-info {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .question-score { font-weight: 700; color: var(--color-primary); }

  /* 問題カード */
  .question-card {
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--color-border);
    margin-bottom: 1.25rem;
  }

  .question-text {
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.6;
    color: var(--color-text);
    margin: 0;
  }

  /* 選択肢 */
  .choices-grid {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .choice-btn {
    width: 100%;
    text-align: left;
    background: var(--color-surface);
    border: 2px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0.85rem 1.1rem;
    font-size: 0.95rem;
    color: var(--color-text);
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s, transform 0.1s;
    line-height: 1.4;
  }

  .choice-btn:hover:not(:disabled) {
    background: var(--color-primary-light);
    border-color: var(--color-primary);
    transform: translateX(4px);
  }

  .choice-btn--correct {
    background: #d1fae5 !important;
    border-color: #34d399 !important;
    color: #065f46 !important;
    font-weight: 700;
  }

  [data-theme="dark"] .choice-btn--correct {
    background: #064e3b !important;
    border-color: #34d399 !important;
    color: #6ee7b7 !important;
  }

  .choice-btn--wrong {
    background: #fee2e2 !important;
    border-color: #f87171 !important;
    color: #7f1d1d !important;
  }

  [data-theme="dark"] .choice-btn--wrong {
    background: #7f1d1d !important;
    border-color: #f87171 !important;
    color: #fca5a5 !important;
  }

  /* 解説 */
  .explanation {
    background: var(--color-surface-raised);
    border-left: 4px solid var(--color-primary);
