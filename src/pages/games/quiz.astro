---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="🧠 ガジェットクイズ"
  description="ガジェットのスペック・用語・豆知識を4択クイズで試そう！サクラが10問出題！"
>
  <div class="quiz-page">
    <div class="quiz-header">
      <a href="/games/" class="back-link">← ゲームコーナーへ</a>
      <h1 class="quiz-title">🧠 ガジェットクイズ</h1>
      <p class="quiz-subtitle">サクラが10問出題するよ！全問正解できるかな？</p>
    </div>

    <!-- クイズUI -->
    <div class="quiz-container" id="quiz-container">
      <!-- 正解/不正解オーバーレイ -->
      <div class="answer-overlay" id="answer-overlay" style="display:none"></div>
      <!-- サクラキャラ -->
      <div class="sakura-area">
        <div class="chibi-wrapper">
          <img class="sakura-img chibi-light" src="/images/games/chibi/sakura_chibi_v2_01_nobg.png" alt="サクラ" />
          <img class="sakura-img chibi-dark" src="/images/games/chibi/black/sakura_chibi_black_01_nobg.png" alt="サクラ" />
        </div>
        <div class="sakura-bubble" id="sakura-bubble">
          <p id="sakura-message">準備はいい？🌸 スタートボタンを押してね！</p>
        </div>
      </div>

      <!-- スタート画面 -->
      <div class="screen screen--start" id="screen-start">
        <div class="start-card">
          <h2>ガジェットクイズ 🎮</h2>
          <ul class="rule-list">
            <li>📋 全10問・4択形式</li>
            <li>⚡ ガジェットの用語・スペックが出題</li>
            <li>🏆 最後にスコアを表示</li>
          </ul>
          <button class="btn btn--primary" id="btn-start">スタート！</button>
        </div>
      </div>

      <!-- 問題画面 -->
      <div class="screen screen--question" id="screen-question" style="display:none">
        <div class="progress-bar-wrap">
          <div class="progress-bar" id="progress-bar"></div>
        </div>
        <div class="question-info">
          <span class="question-number" id="question-number">問題 1 / 10</span>
          <span class="question-score" id="question-score">正解: 0</span>
        </div>
        <div class="question-card">
          <p class="question-text" id="question-text">問題文がここに入ります</p>
        </div>
        <div class="choices-grid" id="choices-grid">
          <!-- 選択肢はJSで生成 -->
        </div>
      </div>

      <!-- 結果画面 -->
      <div class="screen screen--result" id="screen-result" style="display:none">
        <div class="result-card">
          <div class="result-score-display">
            <span class="result-score-num" id="result-score-num">0</span>
            <span class="result-score-denom"> / 10問正解</span>
          </div>
          <p class="result-message" id="result-message"></p>
          <div class="result-actions">
            <button class="btn btn--primary" id="btn-replay">もう一度チャレンジ！🔄</button>
            <a href="/games/" class="btn btn--secondary">ゲーム一覧へ</a>
          </div>
        </div>
        <div class="result-review" id="result-review">
          <h3>📝 解答まとめ</h3>
          <div id="review-list"></div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // ===== クイズデータ（10問）=====
  const quizData = [
    {
      q: "モバイルバッテリーの容量を表す単位は何？",
      choices: ["W（ワット）", "mAh（ミリアンペア時）", "GHz（ギガヘルツ）", "dB（デシベル）"],
      answer: 1,
      explanation: "mAh（ミリアンペア時）がバッテリー容量の単位。数値が大きいほどたくさん充電できるよ！"
    },
    {
      q: "「GaN充電器」のGaNが意味するものは？",
      choices: ["ゲルマニウム素子", "窒化ガリウム", "グラフェン層", "ガリウムナノ粒子"],
      answer: 1,
      explanation: "GaN＝Gallium Nitride（窒化ガリウム）。シリコンより高効率で熱が少なく、充電器を小型化できるよ！"
    },
    {
      q: "ワイヤレス充電の規格「Qi（チー）」を策定した団体は？",
      choices: ["IEEE", "Bluetooth SIG", "Wireless Power Consortium（WPC）", "USB-IF"],
      answer: 2,
      explanation: "Qi規格はWPC（ワイヤレスパワーコンソーシアム）が策定した国際標準規格だよ！"
    },
    {
      q: "ノイズキャンセリングの略称は？",
      choices: ["NR", "ANC", "ENC", "DNC"],
      answer: 1,
      explanation: "ANC＝Active Noise Canceling（アクティブノイズキャンセリング）。マイクで周囲音を拾い、逆位相の音で打ち消すよ！"
    },
    {
      q: "USB Type-Cケーブルで最大100Wの給電が可能な規格は？",
      choices: ["USB 3.2", "USB4", "USB Power Delivery（USB PD）", "Thunderbolt 3"],
      answer: 2,
      explanation: "USB PD（Power Delivery）は最大100W（USB PD 3.1では240W）の給電に対応した規格だよ！"
    },
    {
      q: "「IPX7」の防水等級が意味するものは？",
      choices: ["水滴の滴下に耐える", "水の噴射に耐える", "水深1mに30分浸水しても影響なし", "水深10mに1時間浸水しても影響なし"],
      answer: 2,
      explanation: "IPX7＝水深1mに最大30分間沈めても内部に浸水しない等級だよ！"
    },
    {
      q: "Bluetooth 5.0で大幅に改善された要素は？",
      choices: ["音質", "通信距離と速度", "消費電力のみ", "接続デバイス数"],
      answer: 1,
      explanation: "Bluetooth 5.0では通信距離が最大4倍、速度が最大2倍に向上したよ！"
    },
    {
      q: "M.2 SSDのインターフェースで最も高速なものは？",
      choices: ["SATA", "NVMe（PCIe）", "USB 3.2", "mSATA"],
      answer: 1,
      explanation: "NVMe（PCIe）接続のM.2 SSDは読み取り最大7,000MB/s以上。SATAの約7倍の速度だよ！"
    },
    {
      q: "「4K解像度」の画素数はおよそ何ピクセル？",
      choices: ["約100万", "約200万", "約830万", "約3300万"],
      answer: 2,
      explanation: "4K（3840×2160）は約830万ピクセル。フルHD（1920×1080）の約4倍だよ！"
    },
    {
      q: "TWS（True Wireless Stereo）イヤホンの「True」が意味するものは？",
      choices: ["音が真に高音質であること", "左右が完全に独立（コードなし）であること", "ノイズキャンセリングが真に機能すること", "バッテリーが真に長持ちすること"],
      answer: 1,
      explanation: "TWS＝True Wireless Stereo。左右のイヤホンが完全にコードレスで独立しているのが「True」の意味だよ！"
    },
    // ===== 充電・バッテリー追加問題 =====
    { q: "iPhoneのMagSafe充電の最大速度は？", choices: ["7.5W", "10W", "15W", "25W"], answer: 2, explanation: "MagSafeはiPhone 12以降で最大15Wのワイヤレス充電に対応。Qi通常の7.5Wより倍速だよ！" },
    { q: "「Qi2」規格の最大充電速度は？", choices: ["5W", "10W", "15W", "25W"], answer: 2, explanation: "Qi2はQi規格の後継で最大15W。MagSafeと同じ磁気アライメント技術を採用しているよ！" },
    { q: "USB PD 3.1で対応した最大出力は？", choices: ["100W", "140W", "200W", "240W"], answer: 3, explanation: "USB PD 3.1では最大240Wに対応。大型ノートPCも高速充電できるようになったよ！" },
    { q: "Samsungの急速充電規格「AFC」の最大出力は？", choices: ["9W", "15W", "25W", "45W"], answer: 1, explanation: "AFC（Adaptive Fast Charging）はSamsungの急速充電規格で最大15W（9V/1.67A）対応だよ！" },
    { q: "OPPOの急速充電規格の名称は？", choices: ["Warp Charge", "SuperVOOC", "TurboCharge", "Flash Charge"], answer: 1, explanation: "SuperVOOC（スーパーボーク）はOPPO/OnePlusの急速充電規格。最新モデルでは240Wにも対応しているよ！" },
    { q: "航空機内でのリチウムイオン電池持ち込み上限（一般的な目安）は？", choices: ["50Wh", "100Wh", "160Wh", "制限なし"], answer: 1, explanation: "多くの航空会社では100Wh以下が機内持ち込み可能。100〜160Whは事前申告が必要な場合が多いよ！" },
    { q: "リチウムイオン電池の公称電圧は何V？", choices: ["1.5V", "3.7V", "5.0V", "7.4V"], answer: 1, explanation: "リチウムイオン電池の公称電圧は3.7V。mAh×3.7÷1000でWh（ワット時）を計算できるよ！" },
    { q: "Qualcommの急速充電規格「Quick Charge 5」の最大出力は？", choices: ["18W", "45W", "65W", "100W"], answer: 3, explanation: "Quick Charge 5は最大100Wに対応。15分でスマートフォンを充電できる設計だよ！" },
    // ===== イヤホン・ヘッドホン追加問題 =====
    { q: "Bluetoothコーデック「aptX」を提供しているメーカーは？", choices: ["Sony", "Apple", "Qualcomm", "Samsung"], answer: 2, explanation: "aptXはQualcommが提供するBluetoothコーデック。有線に近い音質が特徴だよ！" },
    { q: "SonyのBluetoothコーデック「LDAC」の最大転送レートは？", choices: ["320kbps", "660kbps", "990kbps", "1320kbps"], answer: 2, explanation: "LDACの最大転送レートは990kbps。SBC（328kbps）の約3倍でハイレゾ相当の音質を伝送できるよ！" },
    { q: "ハイレゾ音源の一般的な最低サンプリングレートの目安は？", choices: ["44.1kHz", "48kHz", "96kHz", "192kHz"], answer: 2, explanation: "ハイレゾは一般的に96kHz/24bit以上が目安。CD音質（44.1kHz/16bit）を超える高音質だよ！" },
    { q: "骨伝導イヤホンの仕組みとして正しいものは？", choices: ["空気振動で音を伝える", "骨の振動を直接内耳に伝える", "レーザーで鼓膜を振動させる", "電磁波で神経を刺激する"], answer: 1, explanation: "骨伝導は頬骨などを振動させて内耳に直接音を伝える仕組み。耳を塞がないので周囲の音も聞こえるよ！" },
    { q: "「開放型（オープンバック）」ヘッドホンの特徴は？", choices: ["防水性が高い", "音漏れがほぼない", "自然な音場感が得られる", "ノイズキャンセリングが強力"], answer: 2, explanation: "開放型は音が外に漏れる代わりに自然で広がりのある音場感が特徴。主に室内での使用向けだよ！" },
    { q: "「密閉型（クローズドバック）」ヘッドホンの最大の特徴は？", choices: ["低音が出ない", "音漏れが少ない", "軽量で持ち運びやすい", "価格が安い"], answer: 1, explanation: "密閉型は外部に音が漏れにくく、外の騒音も遮断しやすい。外出先や騒がしい場所での使用に向いているよ！" },
    { q: "イヤホンの「感度（dB/mW）」が高い場合の特徴は？", choices: ["音質が良い", "低消費電力で大きな音が出る", "ノイズキャンセリングが強い", "有線専用である"], answer: 1, explanation: "感度が高いほど少ない電力で大きな音が出せる。スマホなど非力なプレイヤーでも十分な音量が得られるよ！" },
    { q: "「カナル型」イヤホンの特徴は？", choices: ["耳の入口に引っかける形式", "耳栓状のイヤーチップで耳道に挿入する形式", "ヘッドバンドで固定する", "骨を振動させる形式"], answer: 1, explanation: "カナル型はイヤーチップを耳道に深く挿入するタイプ。密閉感が高く遮音性・低音が優れているよ！" },
    { q: "Bluetooth LE Audioで採用された新コーデックは？", choices: ["aptX HD", "LDAC", "LC3", "AAC+"], answer: 2, explanation: "LC3（Low Complexity Communication Codec）はBluetooth LE Audio向けの新コーデック。低ビットレートでも高音質を実現するよ！" },
    // ===== スマートフォン・タブレット追加問題 =====
    { q: "AppleのM4チップが使用する製造プロセスは？", choices: ["5nm", "4nm", "3nm", "2nm"], answer: 2, explanation: "M4チップはTSMCの第2世代3nmプロセスで製造。高性能・低消費電力を両立しているよ！" },
    { q: "Snapdragon 8 Gen 3を開発したメーカーは？", choices: ["Intel", "MediaTek", "Qualcomm", "Samsung"], answer: 2, explanation: "Snapdragon 8 Gen 3はQualcomm製のフラッグシップSoC。Androidの高性能スマホに多く採用されているよ！" },
    { q: "iPhone 15 Proのメインカメラの画素数は？", choices: ["12MP", "24MP", "48MP", "108MP"], answer: 2, explanation: "iPhone 15 Proのメインカメラは48MPセンサーを搭載。通常撮影はピクセルビニングで12MP相当になるよ！" },
    { q: "「リフレッシュレート120Hz」のディスプレイが意味することは？", choices: ["画面輝度が120%向上", "1秒間に120回画面を更新できる", "色数が120倍になる", "省電力性が120%向上"], answer: 1, explanation: "リフレッシュレート120Hzは1秒間に120回画面を書き換えること。スクロールやアニメーションがより滑らかに見えるよ！" },
    { q: "「SoC（System on a Chip）」に通常統合されていないものは？", choices: ["CPU", "GPU", "メモリコントローラー", "ハードディスク"], answer: 3, explanation: "SoCにはCPU・GPU・メモリコントローラー・通信モジュールなどが統合されるが、ハードディスクは別デバイスだよ！" },
    { q: "iPhone 15シリーズで初めて採用されたポートは？", choices: ["Lightning", "USB-A", "USB-C", "micro USB"], answer: 2, explanation: "iPhone 15でAppleはLightningを廃止しUSB-Cを初採用。充電ケーブルの統一化が進んだよ！" },
    { q: "スマホのRAM規格「LPDDR5」の「LP」は何の略？", choices: ["Large Processor", "Low Power", "Long Performance", "Latest Protocol"], answer: 1, explanation: "LPはLow Power（低消費電力）の略。スマートフォン向けに省電力化されたモバイルDRAMの規格だよ！" },
    { q: "スマホカメラの「光学ズーム」と「デジタルズーム」の違いは？", choices: ["解像度の差はない", "光学は画質劣化なし、デジタルは拡大で劣化あり", "デジタルの方が高品質", "光学はソフトウェア処理"], answer: 1, explanation: "光学ズームはレンズを物理的に動かすため画質劣化なし。デジタルズームは画像を切り抜き拡大するため劣化するよ！" },
    { q: "折りたたみスマホで使われるディスプレイ素材の主流は？", choices: ["Gorilla Glass", "サファイアガラス", "折りたためる有機EL（OLED）", "液晶（LCD）"], answer: 2, explanation: "折りたたみスマホは曲げられる薄型有機EL（OLED）フィルムを使用。ガラスと異なり折り曲げに対応できるよ！" },
    // ===== PC周辺機器追加問題 =====
    { q: "ゲーミングマウスの「DPI」が高い場合の特徴は？", choices: ["ボタン数が増える", "少し動かすだけでカーソルが大きく動く", "クリック音が大きくなる", "バッテリーが長持ちする"], answer: 1, explanation: "DPI（Dots Per Inch）が高いほど感度が上がり、わずかな動きでカーソルが大きく移動するよ！" },
    { q: "メカニカルキーボードの「赤軸」の特徴は？", choices: ["クリック感あり・打鍵音大", "クリック感なし・軽いタッチ", "重いタッチ・スムーズ", "クリック感あり・打鍵音小"], answer: 1, explanation: "赤軸は線形スイッチでクリック感がなく、軽い力でスムーズに入力できる。静音性も比較的高いよ！" },
    { q: "HDR規格「HDR10」の最大輝度は？", choices: ["400nit", "600nit", "1000nit", "4000nit"], answer: 2, explanation: "HDR10の最大輝度は1000nit。SDRの最大100nitと比べ大幅に明るい映像表現が可能だよ！" },
    { q: "モニターパネル「VA」の最大の特徴は？", choices: ["応答速度が最速", "コントラスト比が高い", "視野角が最も広い", "最も価格が安い"], answer: 1, explanation: "VAパネルはコントラスト比が非常に高いのが特徴。黒の深さが際立ち映画鑑賞に向いているよ！" },
    { q: "USB 3.2 Gen 2の最大転送速度は？", choices: ["5Gbps", "10Gbps", "20Gbps", "40Gbps"], answer: 1, explanation: "USB 3.2 Gen 2は最大10Gbpsの転送速度に対応。旧称はUSB 3.1 Gen 2だよ！" },
    { q: "外付けGPU（eGPU）の接続に主に使われるインターフェースは？", choices: ["USB-A", "HDMI", "Thunderbolt", "DisplayPort"], answer: 2, explanation: "eGPUはThunderbolt（主にTB3/TB4）を使って接続。最大40GbpsのPCIe帯域幅を利用するよ！" },
    { q: "DDR5メモリのDDR4に対する主な改善点は？", choices: ["容量の上限が下がった", "消費電力が低下し帯域幅が向上", "クロック速度が低下", "物理サイズが大きくなった"], answer: 1, explanation: "DDR5はDDR4より電圧が低く（1.1V）消費電力が少ない。帯域幅も大幅に向上しているよ！" },
    { q: "PCの起動時に実行される「POST」とは？", choices: ["OSの起動処理", "ハードウェアの自己診断テスト", "BIOSのアップデート", "ネットワーク接続確認"], answer: 1, explanation: "POST（Power-On Self-Test）はPCが起動時にCPU・メモリ・ストレージなどを確認する自己診断テストだよ！" },
    { q: "4K/144Hzのモニターを使う場合に推奨される接続規格は？", choices: ["HDMI 1.4", "DisplayPort 1.2", "HDMI 2.1またはDisplayPort 1.4以降", "USB 3.2"], answer: 2, explanation: "4K/144Hzには高帯域幅が必要。HDMI 2.1（48Gbps）またはDisplayPort 1.4（32.4Gbps）以降が推奨されるよ！" },
    // ===== ネットワーク・通信追加問題 =====
    { q: "Wi-Fi 6の規格番号（IEEE）は？", choices: ["802.11ac", "802.11ax", "802.11n", "802.11be"], answer: 1, explanation: "Wi-Fi 6（および6E）は802.11axの規格。前世代のWi-Fi 5（802.11ac）から効率が大幅に向上したよ！" },
    { q: "5Gの「ミリ波（mmWave）」は主に何GHz帯？", choices: ["2.4GHz", "6GHz", "28GHz以上", "900MHz"], answer: 2, explanation: "ミリ波は28GHz以上の高周波帯域。超高速通信が可能だが距離が短く障害物に弱いのが特徴だよ！" },
    { q: "Wi-Fi 6Eが新たに対応した周波数帯は？", choices: ["2.4GHz", "5GHz", "6GHz", "60GHz"], answer: 2, explanation: "Wi-Fi 6Eは6GHz帯にも対応。新しい帯域なので混雑が少なく高速通信しやすいよ！" },
    { q: "IoT向け低消費電力・長距離通信規格「LoRa」の通信距離は？", choices: ["約100m", "約1km", "数〜15km（環境次第）", "約100km"], answer: 2, explanation: "LoRaは数km〜15km以上（見通し距離）の通信が可能なLPWAN規格。農業や物流向けIoTで多用されているよ！" },
    { q: "NFC通信の主な使用用途として正しくないものは？", choices: ["交通系ICカード", "スマホ決済", "長距離ファイル転送", "データ共有（名刺交換）"], answer: 2, explanation: "NFCは数cmの近距離通信専用。長距離ファイル転送はWi-FiやBluetoothが使われるよ！" },
    { q: "「Wi-Fi Direct」の特徴として正しいものは？", choices: ["インターネット接続が必須", "ルーターなしで機器同士が直接接続できる", "最大接続距離は1cm", "速度は最大1Mbps"], answer: 1, explanation: "Wi-Fi Directはルーター（アクセスポイント）なしで機器同士がWi-Fiで直接通信できる規格だよ！" },
    { q: "Bluetooth LEの「LE」は何の略？", choices: ["Large Extent", "Long Error", "Low Energy", "Latest Edition"], answer: 2, explanation: "LE＝Low Energy。消費電力を極力抑えたBluetoothの仕様で、ウェアラブルやセンサー機器に多用されているよ！" },
    { q: "「DNS」の主な役割は？", choices: ["データを暗号化する", "ドメイン名をIPアドレスに変換する", "Webページをキャッシュする", "パケットを最適なルートで転送する"], answer: 1, explanation: "DNS（Domain Name System）はgoogle.comのようなドメイン名をIPアドレスに変換するシステムだよ！" },
