  }

  function showAnswerOverlay(isCorrect) {
    const el = document.getElementById('answer-overlay');
    if (!el) return;
    el.textContent = isCorrect ? '⭕' : '❌';
    el.className = 'answer-overlay answer-overlay--' + (isCorrect ? 'correct' : 'wrong');
    el.style.display = 'flex';
    setTimeout(() => { el.style.display = 'none'; }, isCorrect ? 1200 : 900);
  }

  function chibiBounce() {
    const wrapper = document.querySelector('.chibi-wrapper');
    if (!wrapper) return;
    wrapper.classList.remove('chibi-bounce');
    void wrapper.offsetWidth; // reflow
    wrapper.classList.add('chibi-bounce');
    setTimeout(() => wrapper.classList.remove('chibi-bounce'), 700);
  }

  // ===== ゲーム状態 =====
  let currentQ = 0;
  let score = 0;
  let answered = false;
  let results = [];
  let shuffledData = [];

  function shuffleArray(arr) {
    const a = [...arr];
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  function setSakuraMessage(msg) {
    document.getElementById('sakura-message').textContent = msg;
  }

  function showScreen(id) {
    ['screen-start', 'screen-question', 'screen-result'].forEach(s => {
      const el = document.getElementById(s);
      if (el) el.style.display = s === id ? '' : 'none';
    });
  }

  function startQuiz() {
    currentQ = 0;
    score = 0;
    results = [];
    shuffledData = shuffleArray(quizData).slice(0, 10);
    setChibiPose('idle');
    showScreen('screen-question');
    showQuestion();
  }

  function showQuestion() {
    answered = false;
    const q = shuffledData[currentQ];
    const total = shuffledData.length;

    // プログレスバー
    document.getElementById('progress-bar').style.width = `${(currentQ / total) * 100}%`;
    document.getElementById('question-number').textContent = `問題 ${currentQ + 1} / ${total}`;
    document.getElementById('question-score').textContent = `正解: ${score}`;
    document.getElementById('question-text').textContent = q.q;

    // 選択肢をシャッフル（正解インデックスを保持）
    const choiceIndices = shuffleArray([0, 1, 2, 3]);
    const grid = document.getElementById('choices-grid');
    grid.innerHTML = '';

    choiceIndices.forEach(origIdx => {
      const btn = document.createElement('button');
      btn.className = 'choice-btn';
      btn.textContent = q.choices[origIdx];
      btn.dataset.index = origIdx;
      btn.addEventListener('click', () => selectAnswer(origIdx, btn));
      grid.appendChild(btn);
    });

    setSakuraMessage(rand(sakuraMessages.question));
    setChibiPose('think');
  }

  function selectAnswer(selectedIdx, btn) {
    if (answered) return;
    answered = true;

    const q = shuffledData[currentQ];
    const isCorrect = selectedIdx === q.answer;

    if (isCorrect) {
      score++;
      btn.classList.add('choice-btn--correct');
      setSakuraMessage(rand(sakuraMessages.correct));
      setChibiPose('correct');
      showAnswerOverlay(true);
      chibiBounce();
    } else {
      btn.classList.add('choice-btn--wrong');
      setSakuraMessage(rand(sakuraMessages.wrong));
      setChibiPose('wrong');
      showAnswerOverlay(false);
      // 正解を緑表示
      document.querySelectorAll('.choice-btn').forEach(b => {
        if (parseInt(b.dataset.index) === q.answer) {
          b.classList.add('choice-btn--correct');
        }
      });
    }

    // 解説を表示
    const grid = document.getElementById('choices-grid');
    const exp = document.createElement('div');
    exp.className = 'explanation';
    exp.innerHTML = `<span class="${isCorrect ? 'exp--correct' : 'exp--wrong'}">${isCorrect ? '✅ 正解！' : '❌ 不正解…'}</span> ${q.explanation}`;
    grid.appendChild(exp);

    results.push({ q: q.q, correctIdx: q.answer, selectedIdx, isCorrect, explanation: q.explanation, choices: q.choices });

    document.getElementById('question-score').textContent = `正解: ${score}`;

    // 次へボタン追加
    const nextBtn = document.createElement('button');
    nextBtn.className = 'btn btn--next';
    nextBtn.textContent = currentQ < shuffledData.length - 1 ? '次の問題へ →' : '結果を見る 🏆';
    nextBtn.addEventListener('click', () => {
      currentQ++;
      if (currentQ < shuffledData.length) {
        showQuestion();
      } else {
        showResult();
      }
    });
    grid.appendChild(nextBtn);
  }

  function showResult() {
    showScreen('screen-result');
    document.getElementById('result-score-num').textContent = score;

    let msg, msgKey;
    if (score === 10) msgKey = 'perfect';
    else if (score >= 8) msgKey = 'great';
    else if (score >= 6) msgKey = 'good';
    else if (score >= 5) msgKey = 'ok';
    else msgKey = 'low';

    document.getElementById('result-message').textContent = sakuraMessages.result[msgKey];
    setSakuraMessage(sakuraMessages.result[msgKey]);
    setChibiPose('guts');

    // 解答まとめ
    const reviewList = document.getElementById('review-list');
    reviewList.innerHTML = '';
    results.forEach((r, i) => {
      const item = document.createElement('div');
      item.className = `review-item ${r.isCorrect ? 'review-item--correct' : 'review-item--wrong'}`;
      item.innerHTML = `
        <div class="review-item__header">
          <span class="review-num">Q${i + 1}</span>
          <span class="review-result">${r.isCorrect ? '✅ 正解' : '❌ 不正解'}</span>
        </div>
        <p class="review-q">${r.q}</p>
        <p class="review-ans">正解: ${r.choices[r.correctIdx]}</p>
        <p class="review-exp">${r.explanation}</p>
      `;
      reviewList.appendChild(item);
    });

    document.getElementById('progress-bar').style.width = '100%';
  }

  // ===== イベント =====
  document.getElementById('btn-start')?.addEventListener('click', startQuiz);
  document.getElementById('btn-replay')?.addEventListener('click', () => {
    showScreen('screen-question');
    startQuiz();
  });

  // ===== ちびキャラ ダーク/ライト切替（即時対応） =====
  function updateChibiTheme() {
    const lImg = document.querySelector('.chibi-light');
    const dImg = document.querySelector('.chibi-dark');
    if (!lImg || !dImg) return;
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    (lImg as HTMLElement).style.display = isDark ? 'none' : 'block';
    (dImg as HTMLElement).style.display = isDark ? 'block' : 'none';
  }
  updateChibiTheme();
  new MutationObserver(updateChibiTheme).observe(document.documentElement, {
    attributes: true, attributeFilter: ['data-theme']
  });
</script>

