  function translateText(text) {
    let result = text;
    // 長いフレーズから順に置換（部分マッチ防止）
    const keys = Object.keys(JP_DICT).sort((a, b) => b.length - a.length);
    for (const jp of keys) {
      result = result.split(jp).join(JP_DICT[jp]);
    }
    return result;
  }

  // 変換ボタンのイベント委譲
  document.addEventListener('click', function(e) {
    const btn = e.target.closest('.trans-btn');
    if (!btn) return;
    const targetId = btn.dataset.target;
    const input = document.getElementById(targetId);
    if (!input) return;
    const original = input.value;
    const translated = translateText(original.trim());
    if (translated === original.trim()) {
      // 変換されなかった場合
      btn.textContent = '⚠️ 未対応';
      setTimeout(() => { btn.textContent = '📝 変換'; }, 1500);
    } else {
      input.value = translated;
      input.dispatchEvent(new Event('input'));
      // 変換フィードバック
      btn.classList.add('translated');
      btn.textContent = '✅ 変換済';
      setTimeout(() => {
        btn.classList.remove('translated');
        btn.textContent = '📝 変換';
      }, 1500);
    }
  });
})();

(function() {
  function val(id) {
    const el = document.getElementById(id);
    return el ? el.value.trim() : '';
  }
  function checked(id) {
    const el = document.getElementById(id);
    return el ? el.checked : false;
  }

  function buildPrompt() {
    const parts = [];

    // 品質タグ
    const qtags = Array.from(document.querySelectorAll('#pb-quality-tags input[type="checkbox"]:checked'))
      .map(cb => cb.value);
    if (qtags.length) parts.push(qtags.join(', '));

    // 性別・人数・年齢
    const gender = val('pb-gender');
    if (gender) parts.push(gender);
    const count = val('pb-count');
    if (count) parts.push(count);
    const age = val('pb-age');
    if (age) parts.push(age);
    const bust = val('pb-bust');
    if (bust) parts.push(bust);

    // 構図
    const composition = val('pb-composition');
    if (composition) parts.push(composition);

    // カメラアングル
    const angle = val('pb-angle-custom') || val('pb-angle');
    if (angle) parts.push(angle);

    // 各パーツ（プルダウン優先、手入力で上書き）
    const fields = [
      ['pb-hair', 'pb-hair-custom'],
      ['pb-haircolor', 'pb-haircolor-custom'],
      ['pb-hair-inner', 'pb-hair-inner-custom'],
      ['pb-hair-tip', 'pb-hair-tip-custom'],
      ['pb-eyes', 'pb-eyes-custom'],
      ['pb-eye-shape', 'pb-eye-shape-custom'],
      ['pb-eyebrow-shape', 'pb-eyebrow-shape-custom'],
      ['pb-eyebrow-color', 'pb-eyebrow-color-custom'],
      ['pb-expression', 'pb-expression-custom'],
      ['pb-outfit', 'pb-outfit-custom'],
      ['pb-outfit-color', 'pb-outfit-color-custom'],
      ['pb-pose', 'pb-pose-custom'],
      ['pb-bg', 'pb-bg-custom'],
    ];
    for (const [selId, custId] of fields) {
      const custom = val(custId);
      const sel = val(selId);
      const v = custom || sel;
      if (v) parts.push(v);
    }

    // NSFW
    if (checked('pb-nsfw')) parts.push('nsfw');

    // NSFW詳細カテゴリ（5種）
    const nsfwItems = Array.from(document.querySelectorAll('.pb-nsfw-item:checked'))
      .map(cb => cb.dataset.prompt)
      .filter(Boolean);
    if (nsfwItems.length) parts.push(nsfwItems.join(', '));

    // 追加指示
    const extra = val('pb-extra');
    if (extra) parts.push(extra);

    // LoRA
    if (checked('pb-lora-on')) {
      const strength = parseFloat(document.getElementById('pb-lora-strength').value).toFixed(2);
      parts.push(`<lora:kaina_v1:${strength}>`);
    }

    return parts.join(', ');
  }

  function updatePreview() {
    const prompt = buildPrompt();
    const el = document.getElementById('pb-prompt-preview');
    el.textContent = prompt || '（選択するとここに表示されます）';

    // ネガティブ
    const neg = val('pb-negative');
    document.getElementById('pb-neg-preview').textContent = neg;

    // LoRA強度表示
    const strength = parseFloat(document.getElementById('pb-lora-strength').value).toFixed(2);
    document.getElementById('pb-lora-value').textContent = strength;
  }

  // イベントリスナー
  const watchIds = [
    'pb-composition',
    'pb-gender', 'pb-age', 'pb-bust', 'pb-count',
    'pb-angle', 'pb-angle-custom',
    'pb-hair','pb-hair-custom','pb-haircolor','pb-haircolor-custom',
    'pb-hair-inner', 'pb-hair-inner-custom',
    'pb-hair-tip', 'pb-hair-tip-custom',
    'pb-eyes','pb-eyes-custom',
    'pb-eye-shape','pb-eye-shape-custom',
    'pb-eyebrow-shape','pb-eyebrow-shape-custom',
    'pb-eyebrow-color','pb-eyebrow-color-custom',
    'pb-expression','pb-expression-custom',
    'pb-outfit','pb-outfit-custom',
    'pb-outfit-color','pb-outfit-color-custom',
    'pb-pose','pb-pose-custom',
    'pb-bg','pb-bg-custom','pb-extra','pb-negative',
    'pb-lora-on','pb-lora-strength','pb-nsfw',
  ];
  for (const id of watchIds) {
    const el = document.getElementById(id);
    if (el) {
      el.addEventListener('input', updatePreview);
      el.addEventListener('change', updatePreview);
    }
  }
  document.querySelectorAll('#pb-quality-tags input[type="checkbox"]').forEach(cb => {
    cb.addEventListener('change', updatePreview);
  });
  document.querySelectorAll('.pb-nsfw-item').forEach(cb => {
    cb.addEventListener('change', updatePreview);
  });

  // コピーボタン
  document.getElementById('pb-copy-btn').addEventListener('click', async () => {
    const text = buildPrompt();
    try {
      await navigator.clipboard.writeText(text);
      const btn = document.getElementById('pb-copy-btn');
      btn.textContent = '✅ コピー済み';
      btn.classList.add('copied');
      setTimeout(() => {
        btn.textContent = '📋 コピー';
        btn.classList.remove('copied');
      }, 2000);
    } catch(e) {
      alert('コピーできませんでした。');
    }
  });

  const adminDetails = document.getElementById('pb-admin-category');
  if (adminDetails) {
    adminDetails.addEventListener('toggle', function() {
      if (adminDetails.open) {
        if (localStorage.getItem('pb_admin_auth') !== '1') {
          const input = window.prompt('管理人パスワードを入力してください');
          if (input === '393941') {
            localStorage.setItem('pb_admin_auth', '1');
          } else {
            adminDetails.open = false;
          }
        }
      }
    });
  }

  document.getElementById('send-to-shogun-btn').addEventListener('click', function() {
    const prompt = buildPrompt();
    if (!prompt) {
      alert('プロンプトを生成してから送信してください');
      return;
    }
    navigator.clipboard.writeText(prompt).catch(() => {});
    const countSd = document.getElementById('pb-sd-count').value || '1';
    const sizeSd = document.getElementById('pb-sd-size').value || '512x768';
    const modelSd = document.getElementById('pb-sd-model').value || '';
    const samplerSd = document.getElementById('pb-sd-sampler').value || '';
    const msgLines = [
      '🎨画像生成依頼(' + countSd + '枚)',
      '📐サイズ: ' + sizeSd,
      '🤖モデル: ' + modelSd,
      '🔧サンプラー: ' + samplerSd,
      'プロンプト: ' + prompt
    ];
    const message = encodeURIComponent(msgLines.join('\n'));
    const botUsername = 'Shogun4510_bot';
    window.open('https://t.me/' + botUsername + '?text=' + message, '_blank');
    const btn = document.getElementById('send-to-shogun-btn');
    btn.textContent = '✅ コピー＆Telegram起動';
    setTimeout(() => { btn.textContent = '📤 将軍に送信'; }, 2000);
  });

  document.getElementById('pb-copy-neg-btn').addEventListener('click', async () => {
    const text = val('pb-negative');
    try {
      await navigator.clipboard.writeText(text);
      const btn = document.getElementById('pb-copy-neg-btn');
      btn.textContent = '✅ コピー済み';
      btn.classList.add('copied');
      setTimeout(() => {
        btn.textContent = '📋 ネガコピー';
        btn.classList.remove('copied');
      }, 2000);
    } catch(e) {
      alert('コピーできませんでした。');
    }
  });

  // 初期表示
  updatePreview();
})();
</script>
