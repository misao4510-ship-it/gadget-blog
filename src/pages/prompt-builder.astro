  (function() {
    const RANDOM_FIELDS = [
      { id: 'pb-composition', label: '構図' },
      { id: 'pb-expression', label: '表情' },
      { id: 'pb-hair', label: '髪型' },
      { id: 'pb-outfit', label: '衣装スタイル' },
      { id: 'pb-top', label: '上着' },
      { id: 'pb-bottom', label: '下' },
      { id: 'pb-legwear', label: 'レッグウェア' },
      { id: 'pb-pose', label: 'ポーズ' },
      { id: 'pb-bg', label: '背景' },
      { id: 'pb-bust', label: '胸サイズ' },
    ];

    function pickRandom(sel) {
      const opts = Array.from(sel.options).filter(o => o.value !== '');
      if (!opts.length) return null;
      return opts[Math.floor(Math.random() * opts.length)];
    }

    function getJaLabel(optText) {
      // オプションテキスト「日本語 (english)」→ 日本語部分だけ返す
      return optText.replace(/\s*\([^)]*\)\s*$/, '').trim() || optText.trim();
    }

    document.getElementById('pb-random-btn').addEventListener('click', function() {
      const list = document.getElementById('pb-random-list');
      const panel = document.getElementById('pb-random-result');
      list.innerHTML = '';

      RANDOM_FIELDS.forEach(({ id, label }) => {
        const sel = document.getElementById(id);
        if (!sel) return;
        const opt = pickRandom(sel);
        if (!opt) return;
        sel.value = opt.value;
        sel.dispatchEvent(new Event('change'));
        const li = document.createElement('li');
        li.textContent = `${label}：${getJaLabel(opt.textContent)}`;
        list.appendChild(li);
      });

      updatePreview();
      panel.style.display = 'block';
    });
  })();

