---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="SD プロンプトビルダー"
  description="Stable Diffusion用プロンプトを素早く組み立てるツールです。"
>
<style>
  /* ===== パスワード認証画面 ===== */
  #pw-screen {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
    padding: 2rem 1rem;
  }
  .pw-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    padding: 2.5rem 2rem;
    max-width: 380px;
    width: 100%;
    text-align: center;
  }
  .pw-chara {
    font-size: 4rem;
    line-height: 1;
    margin-bottom: 0.5rem;
    animation: pw-bounce 1.2s ease-in-out infinite;
  }
  @keyframes pw-bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }
  .pw-chara-name {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: 0.8rem;
    font-weight: 600;
  }
  .pw-speech {
    background: var(--color-primary-light, #fce8f3);
    color: var(--color-text);
    border-radius: 12px;
    padding: 0.8rem 1rem;
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    position: relative;
    line-height: 1.5;
  }
  .pw-speech::after {
    content: '';
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    border: 5px solid transparent;
    border-top-color: var(--color-primary-light, #fce8f3);
  }
  .pw-input-row {
    display: flex;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .pw-input-row input[type="password"] {
    flex: 1;
    padding: 0.6rem 0.8rem;
    border: 2px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-text);
    font-size: 1rem;
    box-sizing: border-box;
    transition: border-color 0.2s;
  }
  .pw-input-row input[type="password"]:focus {
    outline: none;
    border-color: var(--color-primary);
  }
  .pw-submit-btn {
    background: var(--color-primary);
    color: #fff;
    border: none;
    border-radius: var(--radius);
    padding: 0.6rem 1.2rem;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s;
    font-family: var(--font-heading);
    white-space: nowrap;
  }
  .pw-submit-btn:hover:not(:disabled) { background: var(--color-primary-dark); }
  .pw-submit-btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .pw-error {
    color: #e03a3a;
    font-size: 0.85rem;
    margin-top: 0.7rem;
    min-height: 1.2em;
  }
  .pw-lock-msg {
    color: #e07a3a;
    font-size: 0.9rem;
    font-weight: 600;
    margin-top: 0.7rem;
    min-height: 1.2em;
  }
  /* ===== メインUI（認証後） ===== */
  #pb-main { display: none; }
  /* ===== 既存スタイル ===== */
  .pb-container {
    max-width: 900px;
    margin: 2rem auto;
    padding: 0 1rem;
    font-family: var(--font-body);
  }
  h1 {
    font-size: 1.6rem;
    color: var(--color-text);
    margin-bottom: 1.5rem;
    font-family: var(--font-heading);
  }
  .pb-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }
  @media (max-width: 640px) {
    .pb-grid { grid-template-columns: 1fr; }
  }
  .form-section {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
  }
  .form-section h2 {
    font-size: 1rem;
    color: var(--color-primary);
    margin: 0 0 1rem 0;
    font-family: var(--font-heading);
  }
  .field-group {
    margin-bottom: 0.8rem;
  }
  label {
    display: block;
    font-size: 0.82rem;
    color: var(--color-text-muted);
    margin-bottom: 0.25rem;
  }
  select, input[type="text"], textarea {
    width: 100%;
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-text);
    font-size: 0.9rem;
    box-sizing: border-box;
  }
  select:focus, input[type="text"]:focus, textarea:focus {
    outline: 2px solid var(--color-primary);
    border-color: var(--color-primary);
  }
  textarea {
    resize: vertical;
    min-height: 80px;
  }
  .quality-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .quality-tags label {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.82rem;
    color: var(--color-text);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 0.25rem 0.5rem;
    cursor: pointer;
    margin-bottom: 0;
  }
  .quality-tags label:hover {
    background: var(--color-primary-light);
    border-color: var(--color-primary);
  }
  .quality-tags input[type="checkbox"] {
    width: auto;
    margin: 0;
    accent-color: var(--color-primary);
  }
  .lora-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .lora-row input[type="checkbox"] {
    accent-color: var(--color-primary);
    width: 1.1rem;
    height: 1.1rem;
  }
  .lora-row input[type="range"] {
    flex: 1;
    min-width: 100px;
    accent-color: var(--color-primary);
  }
  .lora-strength-label {
    font-size: 0.85rem;
    color: var(--color-text);
    min-width: 2.5rem;
    text-align: right;
  }
  .output-section {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .output-section h2 {
    font-size: 1rem;
    color: var(--color-primary);
    margin: 0;
    font-family: var(--font-heading);
  }
  .prompt-preview {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0.8rem;
    font-size: 0.85rem;
    color: var(--color-text);
    line-height: 1.6;
    min-height: 80px;
    word-break: break-all;
    white-space: pre-wrap;
  }
  .negative-preview {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0.8rem;
    font-size: 0.82rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    min-height: 60px;
    word-break: break-all;
    white-space: pre-wrap;
  }
  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--color-primary);
    color: #fff;
    border: none;
    border-radius: var(--radius);
    padding: 0.5rem 1.2rem;
    font-size: 0.9rem;
    cursor: pointer;
    font-family: var(--font-heading);
    transition: background 0.2s;
  }
  .copy-btn:hover { background: var(--color-primary-dark); }
  .copy-btn.copied { background: #00b050; }
  .copy-neg-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--color-surface-raised);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0.4rem 0.9rem;
    font-size: 0.85rem;
    cursor: pointer;
    transition: background 0.2s;
  }
  .copy-neg-btn:hover { background: var(--color-primary-light); }
  .copy-neg-btn.copied { background: #e6f9ee; color: #00b050; }
  .section-label {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: 0.3rem;
  }
  .btn-row {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .custom-row {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.3rem;
  }
  .custom-row input[type="text"] {
    flex: 1;
    margin-top: 0;
  }
  .trans-btn {
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0.4rem 0.5rem;
    font-size: 0.8rem;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.15s;
    line-height: 1;
  }
  .trans-btn:hover { background: var(--color-primary-light); border-color: var(--color-primary); }
  .trans-btn.translated { background: #e6f9ee; color: #00b050; border-color: #00b050; }
</style>

<!-- パスワード認証画面 -->
<div id="pw-screen">
  <div class="pw-card">
    <div class="pw-chara">🌸</div>
    <div class="pw-chara-name">— サクラ —</div>
    <div class="pw-speech">
      ここはサクラの秘密工房✨<br />
      合言葉を教えてください💖
    </div>
    <div class="pw-input-row">
      <input type="password" id="pw-input" placeholder="合言葉" autocomplete="off" maxlength="20" />
      <button class="pw-submit-btn" id="pw-submit-btn">入る</button>
    </div>
    <div class="pw-error" id="pw-error"></div>
    <div class="pw-lock-msg" id="pw-lock-msg"></div>
  </div>
</div>

<!-- メインUI（認証後に表示） -->
<div id="pb-main">
<div class="pb-container">
  <h1>SD プロンプトビルダー</h1>
  <div class="pb-grid">
    <!-- 左: フォーム -->
    <div class="form-section">
      <h2>パーツ選択</h2>

      <div class="field-group">
        <label for="pb-composition">構図</label>
        <select id="pb-composition">
          <option value="full body" selected>全身 (full body)</option>
          <option value="upper body">上半身 (upper body)</option>
          <option value="portrait, from chest up">バストアップ (portrait, from chest up)</option>
          <option value="close-up face">顔アップ (close-up face)</option>
          <option value="chibi, super deformed">ちびキャラ (chibi, super deformed)</option>
        </select>
      </div>

      <div class="field-group">
        <label for="pb-gender">性別</label>
        <select id="pb-gender">
          <option value="">（なし）</option>
          <option value="1girl" selected>女の子 (1girl)</option>
          <option value="1boy">男の子 (1boy)</option>
          <option value="1girl, androgynous">中性的</option>
        </select>
      </div>

      <div class="field-group">
        <label for="pb-age">年齢</label>
        <select id="pb-age">
          <option value="">（なし）</option>
          <option value="child">子供</option>
          <option value="teenager">10代</option>
          <option value="young adult">20代</option>
          <option value="adult">大人</option>
        </select>
      </div>

      <div class="field-group">
        <label for="pb-count">人数</label>
        <select id="pb-count">
          <option value="">（なし）</option>
          <option value="solo">1人 (solo)</option>
          <option value="2girls">2人 (2girls)</option>
          <option value="group">グループ</option>
        </select>
      </div>

      <div class="field-group">
        <label for="pb-hair">髪型</label>
        <select id="pb-hair">
          <option value="">（なし）</option>
          <option value="long hair">ロングヘア</option>
          <option value="short hair">ショートヘア</option>
          <option value="twin tails">ツインテール</option>
          <option value="ponytail">ポニーテール</option>
          <option value="bob cut">ボブカット</option>
          <option value="semi-long hair">セミロング</option>
          <option value="braids">三つ編み</option>
        </select>
        <div class="custom-row"><input type="text" id="pb-hair-custom" placeholder="または手入力" /><button type="button" class="trans-btn" data-target="pb-hair-custom">📝 変換</button></div>
      </div>

      <div class="field-group">
        <label for="pb-haircolor">髪色</label>
        <select id="pb-haircolor">
          <option value="">（なし）</option>
          <option value="pink hair">ピンク</option>
          <option value="blue hair">ブルー</option>
          <option value="gradient pink-blue hair">グラデーション(ピンク→青)</option>
          <option value="silver hair">シルバー</option>
          <option value="blonde hair">ブロンド</option>
          <option value="black hair">ブラック</option>
        </select>
        <div class="custom-row"><input type="text" id="pb-haircolor-custom" placeholder="または手入力" /><button type="button" class="trans-btn" data-target="pb-haircolor-custom">📝 変換</button></div>
      </div>

      <div class="field-group">
        <label for="pb-hair-inner">髪のインナー色</label>
        <select id="pb-hair-inner">
          <option value="">（なし）</option>
          <option value="inner color hair, pink roots">ピンクルーツ</option>
          <option value="inner color hair, blue roots">ブルールーツ</option>
          <option value="inner color hair, white roots">ホワイトルーツ</option>
          <option value="inner color hair, rainbow">レインボー</option>
        </select>
        <div class="custom-row"><input type="text" id="pb-hair-inner-custom" placeholder="または手入力" /><button type="button" class="trans-btn" data-target="pb-hair-inner-custom">📝 変換</button></div>
      </div>

      <div class="field-group">
        <label for="pb-hair-tip">髪先の色</label>
        <select id="pb-hair-tip">
          <option value="">（なし）</option>
          <option value="gradient hair, pink tips">ピンク先端</option>
          <option value="gradient hair, blue tips">ブルー先端</option>
          <option value="gradient hair, white tips">ホワイト先端</option>
          <option value="gradient hair, gold tips">ゴールド先端</option>
        </select>
        <div class="custom-row"><input type="text" id="pb-hair-tip-custom" placeholder="または手入力" /><button type="button" class="trans-btn" data-target="pb-hair-tip-custom">📝 変換</button></div>
      </div>

      <div class="field-group">
        <label for="pb-eyes">目の色</label>
        <select id="pb-eyes">
          <option value="">（なし）</option>
          <option value="blue eyes">ブルー</option>
          <option value="green eyes">グリーン</option>
          <option value="red eyes">レッド</option>
          <option value="purple eyes">パープル</option>
          <option value="heterochromia">オッドアイ</option>
        </select>
        <div class="custom-row"><input type="text" id="pb-eyes-custom" placeholder="または手入力" /><button type="button" class="trans-btn" data-target="pb-eyes-custom">📝 変換</button></div>
      </div>

      <div class="field-group">
        <label for="pb-expression">表情</label>
        <select id="pb-expression">
          <option value="">（なし）</option>
          <option value="smile">スマイル</option>
          <option value="wink">ウィンク</option>
          <option value="surprised">驚き</option>
          <option value="sleepy">眠そう</option>
          <option value="determined">真剣</option>
          <option value="blushing">照れ</option>
          <option value="happy">嬉しそう</option>
        </select>
        <div class="custom-row"><input type="text" id="pb-expression-custom" placeholder="または手入力" /><button type="button" class="trans-btn" data-target="pb-expression-custom">📝 変換</button></div>
      </div>

      <div class="field-group">
        <label for="pb-outfit">服装</label>
        <select id="pb-outfit">
          <option value="">（なし）</option>
          <option value="school uniform">制服</option>
          <option value="maid outfit">メイド服</option>
          <option value="casual clothes">カジュアル</option>
          <option value="futuristic white outfit">未来的ホワイト</option>
          <option value="kimono">着物</option>
          <option value="swimsuit">水着</option>
          <option value="pajamas">パジャマ</option>
        </select>
        <div class="custom-row"><input type="text" id="pb-outfit-custom" placeholder="または手入力" /><button type="button" class="trans-btn" data-target="pb-outfit-custom">📝 変換</button></div>
      </div>

      <div class="field-group">
        <label for="pb-pose">ポーズ</label>
        <select id="pb-pose">
          <option value="">（なし）</option>
          <option value="standing">立っている</option>
          <option value="sitting">座っている</option>
          <option value="running">走っている</option>
          <option value="holding device">デバイスを持つ</option>
          <option value="peace sign">ピースサイン</option>
        </select>
        <div class="custom-row"><input type="text" id="pb-pose-custom" placeholder="または手入力" /><button type="button" class="trans-btn" data-target="pb-pose-custom">📝 変換</button></div>
      </div>

      <div class="field-group">
        <label for="pb-bg">背景</label>
        <select id="pb-bg">
          <option value="">（なし）</option>
          <option value="white background">白背景</option>
          <option value="city background">都市</option>
          <option value="nature background">自然</option>
          <option value="starry sky">星空</option>
          <option value="room">部屋</option>
          <option value="studio background">スタジオ</option>
        </select>
        <div class="custom-row"><input type="text" id="pb-bg-custom" placeholder="または手入力" /><button type="button" class="trans-btn" data-target="pb-bg-custom">📝 変換</button></div>
      </div>

      <div class="field-group">
        <label>品質タグ</label>
        <div class="quality-tags" id="pb-quality-tags">
          <label><input type="checkbox" value="masterpiece" checked /> masterpiece</label>
          <label><input type="checkbox" value="best quality" checked /> best quality</label>
          <label><input type="checkbox" value="highly detailed" /> highly detailed</label>
          <label><input type="checkbox" value="ultra-detailed" /> ultra-detailed</label>
          <label><input type="checkbox" value="8k" /> 8k</label>
          <label><input type="checkbox" value="sharp focus" /> sharp focus</label>
          <label><input type="checkbox" value="cinematic lighting" /> cinematic lighting</label>
          <label><input type="checkbox" value="volumetric lighting" /> volumetric lighting</label>
        </div>
      </div>

      <div class="field-group">
        <label>LoRA指定</label>
        <div class="lora-row">
          <input type="checkbox" id="pb-lora-on" checked />
          <span style="font-size:0.85rem;color:var(--color-text)">kaina_v1</span>
          <input type="range" id="pb-lora-strength" min="0.1" max="1.0" step="0.05" value="0.7" />
          <span class="lora-strength-label" id="pb-lora-value">0.70</span>
        </div>
      </div>

      <div class="field-group">
        <label for="pb-extra">追加指示（フリーテキスト）</label>
        <div class="custom-row"><input type="text" id="pb-extra" placeholder="例: 1girl, solo, looking at viewer" /><button type="button" class="trans-btn" data-target="pb-extra">📝 変換</button></div>
      </div>

      <div class="field-group">
        <label for="pb-negative">ネガティブプロンプト</label>
        <textarea id="pb-negative">lowres, bad anatomy, bad hands, text, error, missing fingers, extra digit, fewer digits, cropped, worst quality, low quality, normal quality, jpeg artifacts, signature, watermark, username, blurry</textarea>
      </div>
    </div>

    <!-- 右: 出力 -->
    <div class="output-section">
      <h2>生成プロンプト</h2>
      <div>
        <div class="section-label">ポジティブプロンプト</div>
        <div class="prompt-preview" id="pb-prompt-preview">（選択するとここに表示されます）</div>
      </div>
      <div class="btn-row">
        <button class="copy-btn" id="pb-copy-btn">📋 コピー</button>
      </div>
      <div>
        <div class="section-label">ネガティブプロンプト</div>
        <div class="negative-preview" id="pb-neg-preview"></div>
      </div>
      <div class="btn-row">
        <button class="copy-neg-btn" id="pb-copy-neg-btn">📋 ネガコピー</button>
      </div>
    </div>
  </div>
</div>
</div><!-- /#pb-main -->

<script>
// ===== URL直打ちブロック（ナビリンク経由のみ許可） =====
(function() {
  const isViaNav = sessionStorage.getItem('prompt_builder_via_nav') === 'true';
  if (!isViaNav) {
    window.location.href = '/';
    return;
  }
  sessionStorage.removeItem('prompt_builder_via_nav'); // フラグ消費
})();

(function() {
  // ===== パスワード認証 =====
  const CORRECT_PW = '393941';
  const SESSION_KEY = 'pb_auth';
  const MAX_FAIL = 5;
  const LOCK_SEC = 30;

  const pwScreen = document.getElementById('pw-screen');
  const pbMain = document.getElementById('pb-main');
  const pwInput = document.getElementById('pw-input');
  const pwSubmit = document.getElementById('pw-submit-btn');
  const pwError = document.getElementById('pw-error');
  const pwLock = document.getElementById('pw-lock-msg');

  let failCount = 0;
  let lockTimer = null;

  function showMain() {
    if (pwScreen) pwScreen.style.display = 'none';
    if (pbMain) pbMain.style.display = 'block';
  }

  // セッション認証済みなら即表示
  if (sessionStorage.getItem(SESSION_KEY) === '1') {
    showMain();
  }

  function startLock() {
    let remaining = LOCK_SEC;
    if (pwInput) pwInput.disabled = true;
    if (pwSubmit) pwSubmit.disabled = true;
    if (pwError) pwError.textContent = '';

    function tick() {
      if (pwLock) pwLock.textContent = `🔒 しばらくお待ちください（残り${remaining}秒）`;
      if (remaining <= 0) {
        clearInterval(lockTimer);
        lockTimer = null;
        failCount = 0;
        if (pwInput) { pwInput.disabled = false; pwInput.value = ''; }
        if (pwSubmit) pwSubmit.disabled = false;
        if (pwLock) pwLock.textContent = '';
      }
      remaining--;
    }
    tick();
    lockTimer = setInterval(tick, 1000);
  }

  function checkPassword() {
    if (lockTimer) return;
    const val = pwInput ? pwInput.value : '';
    if (val === CORRECT_PW) {
      sessionStorage.setItem(SESSION_KEY, '1');
      showMain();
    } else {
      failCount++;
      if (failCount >= MAX_FAIL) {
        startLock();
      } else {
        if (pwError) pwError.textContent = `合言葉が違います💦（残り${MAX_FAIL - failCount}回）`;
        if (pwInput) pwInput.value = '';
      }
    }
  }

  if (pwSubmit) pwSubmit.addEventListener('click', checkPassword);
  if (pwInput) pwInput.addEventListener('keydown', e => { if (e.key === 'Enter') checkPassword(); });
})();

(function() {
  // ===== 日本語→英語SD用語辞書 =====
  const JP_DICT = {
    // 髪型
    'ツインテール': 'twin tails', 'ポニーテール': 'ponytail', 'ショートヘア': 'short hair',
    'ロングヘア': 'long hair', 'ボブカット': 'bob cut', 'おさげ': 'braids', '三つ編み': 'braids',
    'セミロング': 'semi-long hair', 'アップヘア': 'updo', 'お団子': 'bun hair',
