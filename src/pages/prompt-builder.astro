---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="SD プロンプトビルダー"
  description="Stable Diffusion用プロンプトを素早く組み立てるツールです。"
>
<style>
  /* ===== パスワード認証画面 ===== */
  #pw-screen {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
    padding: 2rem 1rem;
  }
  .pw-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    padding: 2.5rem 2rem;
    max-width: 380px;
    width: 100%;
    text-align: center;
  }
  .pw-chara {
    line-height: 1;
    margin-bottom: 0.5rem;
    animation: pw-bounce 1.2s ease-in-out infinite;
  }
  .pw-chara-img {
    width: 140px;
    height: auto;
    display: block;
    margin: 0 auto;
  }
  @keyframes pw-bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }
  .pw-chara-name {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: 0.8rem;
    font-weight: 600;
  }
  .pw-speech {
    background: var(--color-primary-light, #fce8f3);
    color: var(--color-text);
    border-radius: 12px;
    padding: 0.8rem 1rem;
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    position: relative;
    line-height: 1.5;
  }
  .pw-speech::after {
    content: '';
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    border: 5px solid transparent;
    border-top-color: var(--color-primary-light, #fce8f3);
  }
  .pw-input-row {
    display: flex;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .pw-input-row input[type="password"] {
    flex: 1;
    padding: 0.6rem 0.8rem;
    border: 2px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-text);
    font-size: 1rem;
    box-sizing: border-box;
    transition: border-color 0.2s;
  }
  .pw-input-row input[type="password"]:focus {
    outline: none;
    border-color: var(--color-primary);
  }
  .pw-submit-btn {
    background: var(--color-primary);
    color: #fff;
    border: none;
    border-radius: var(--radius);
    padding: 0.6rem 1.2rem;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s;
    font-family: var(--font-heading);
    white-space: nowrap;
  }
  .pw-submit-btn:hover:not(:disabled) { background: var(--color-primary-dark); }
  .pw-submit-btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .pw-error {
    color: #e03a3a;
    font-size: 0.85rem;
    margin-top: 0.7rem;
    min-height: 1.2em;
  }
  .pw-lock-msg {
    color: #e07a3a;
    font-size: 0.9rem;
    font-weight: 600;
    margin-top: 0.7rem;
    min-height: 1.2em;
  }
  /* ===== メインUI（認証後） ===== */
  #pb-main { display: none; }
  /* ===== 既存スタイル ===== */
  .pb-container {
    max-width: 900px;
    margin: 2rem auto;
    padding: 0 1rem;
    font-family: var(--font-body);
  }
  h1 {
    font-size: 1.6rem;
    color: var(--color-text);
    margin-bottom: 1.5rem;
    font-family: var(--font-heading);
  }
  .pb-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }
  @media (max-width: 640px) {
    .pb-grid { grid-template-columns: 1fr; }
  }
  .form-section {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
  }
  .form-section h2 {
    font-size: 1rem;
    color: var(--color-primary);
    margin: 0 0 1rem 0;
    font-family: var(--font-heading);
  }
  .field-group {
    margin-bottom: 0.8rem;
  }
  label {
    display: block;
    font-size: 0.82rem;
    color: var(--color-text-muted);
    margin-bottom: 0.25rem;
  }
  select, input[type="text"], textarea {
    width: 100%;
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-text);
    font-size: 0.9rem;
    box-sizing: border-box;
  }
  select:focus, input[type="text"]:focus, textarea:focus {
    outline: 2px solid var(--color-primary);
    border-color: var(--color-primary);
  }
  textarea {
    resize: vertical;
    min-height: 80px;
  }
  .quality-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .quality-tags label {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.82rem;
    color: var(--color-text);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 0.25rem 0.5rem;
    cursor: pointer;
    margin-bottom: 0;
  }
  .quality-tags label:hover {
    background: var(--color-primary-light);
    border-color: var(--color-primary);
  }
  .quality-tags input[type="checkbox"] {
    width: auto;
    margin: 0;
    accent-color: var(--color-primary);
  }
  .lora-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .lora-row input[type="checkbox"] {
    accent-color: var(--color-primary);
    width: 1.1rem;
    height: 1.1rem;
  }
  .lora-row input[type="range"] {
    flex: 1;
    min-width: 100px;
    accent-color: var(--color-primary);
  }
  .lora-strength-label {
    font-size: 0.85rem;
    color: var(--color-text);
    min-width: 2.5rem;
    text-align: right;
  }
  .output-section {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: sticky;
    top: 80px;
    align-self: start;
    backdrop-filter: blur(6px);
    z-index: 50;
  }
  @media (max-width: 768px) {
    .output-section { position: sticky; top: 0; }
  }
  /* プリセットボタン */
  .admin-presets {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 10px 0 4px;
  }
  .admin-preset-btn {
    background: #334155;
    color: #f8fafc;
    border: 1px solid #475569;
    padding: 6px 12px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.83rem;
    transition: background 0.15s;
  }
  .admin-preset-btn:hover { background: #475569; }
  /* エロス系タグセクション */
  .erotag-section {
    margin: 12px 0 4px;
    border-top: 1px solid #334155;
    padding-top: 10px;
  }
  .erotag-section summary {
    font-size: 0.83rem;
    color: #f8fafc;
    cursor: pointer;
    padding: 4px 0;
    user-select: none;
    list-style: none;
  }
  .erotag-section summary::-webkit-details-marker { display: none; }
  .erotag-section summary::before { content: "▶ "; font-size: 0.7rem; }
  .erotag-section[open] summary::before { content: "▼ "; }
  .erotag-category { margin-top: 8px; }
  .erotag-category h5 {
    font-size: 0.78rem;
    color: #94a3b8;
    margin: 6px 0 4px;
  }
  .erotag-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 4px;
  }
  @media (max-width: 480px) {
    .erotag-grid { grid-template-columns: 1fr; }
  }
  .erotag-btn {
    background: #1e293b;
    color: #cbd5e1;
    border: 1px solid #334155;
    padding: 4px 8px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.78rem;
    text-align: left;
    transition: background 0.15s, border-color 0.15s;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .erotag-btn:hover { background: #334155; border-color: #475569; color: #f8fafc; }
  /* エロス系チェックボックス（タブ内アコーディオン） */
  .erotag-details {
    margin-top: 10px;
    border-top: 1px solid #334155;
    padding-top: 6px;
  }
  .erotag-details > summary {
    font-size: 0.78rem;
    color: #94a3b8;
    cursor: pointer;
    user-select: none;
    padding: 2px 0;
    list-style: none;
  }
  .erotag-details > summary::-webkit-details-marker { display: none; }
  .erotag-details > summary::before { content: "▶ "; font-size: 0.7rem; }
  .erotag-details[open] > summary::before { content: "▼ "; }
  .erotag-details[open] > summary { color: #f8fafc; }
  /* LoRAタブ内スタイル調整 */
  .admin-lora-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin: 0.5rem 0;
  }
  .admin-lora-row input[type="range"] {
    flex: 1;
    min-width: 100px;
    accent-color: #3b82f6;
  }
  .admin-lora-strength-label {
    font-size: 0.85rem;
    color: #cbd5e1;
    min-width: 2.5rem;
    text-align: right;
  }
  /* ===== ポーズプリセット ===== */
  .pose-category { margin-bottom: 0.8rem; }
  .pose-category-header {
    font-size: 0.8rem; color: #94a3b8; margin-bottom: 0.4rem;
    display: flex; align-items: center; gap: 4px;
  }
  .pose-cards { display: flex; flex-wrap: wrap; gap: 6px; }
  .pose-card {
    display: flex; flex-direction: column; align-items: center;
    width: 72px; cursor: pointer;
    background: #1e293b; border: 1px solid #334155; border-radius: 6px;
    padding: 6px 4px; transition: border-color 0.15s, background 0.15s;
  }
  .pose-card:hover { background: #273549; border-color: #475569; }
  .pose-card.selected { border-color: #3b82f6; background: #1e3a5f; }
  .pose-card-icon { font-size: 1.3rem; line-height: 1; margin-bottom: 4px; }
  .pose-card-img { width: 52px; height: 52px; object-fit: cover; border-radius: 4px; margin-bottom: 4px; }
  .pose-card-name { font-size: 0.7rem; color: #cbd5e1; text-align: center; line-height: 1.2; }
  .output-section h2 {
    font-size: 1rem;
    color: var(--color-primary);
    margin: 0;
    font-family: var(--font-heading);
  }
  .prompt-preview {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0.8rem;
    font-size: 0.85rem;
    color: var(--color-text);
    line-height: 1.6;
    min-height: 80px;
    word-break: break-all;
    white-space: pre-wrap;
  }
  .negative-preview {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0.8rem;
    font-size: 0.82rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    min-height: 60px;
    word-break: break-all;
    white-space: pre-wrap;
  }
  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--color-primary);
    color: #fff;
    border: none;
    border-radius: var(--radius);
    padding: 0.5rem 1.2rem;
    font-size: 0.9rem;
    cursor: pointer;
    font-family: var(--font-heading);
    transition: background 0.2s;
  }
  .copy-btn:hover { background: var(--color-primary-dark); }
  .copy-btn.copied { background: #00b050; }
  .copy-neg-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--color-surface-raised);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0.4rem 0.9rem;
    font-size: 0.85rem;
    cursor: pointer;
    transition: background 0.2s;
  }
  .copy-neg-btn:hover { background: var(--color-primary-light); }
  .copy-neg-btn.copied { background: #e6f9ee; color: #00b050; }
  .send-shogun-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    background: #0088cc;
    color: #fff;
    border: none;
    border-radius: var(--radius);
    font-size: 0.95rem;
    cursor: pointer;
    font-family: var(--font-heading);
    transition: background 0.2s;
  }
  .send-shogun-btn:hover { background: #006fa8; }
  .sd-bot-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    background: #229ED9;
    color: #fff;
    border: none;
    border-radius: var(--radius);
    font-size: 0.95rem;
    cursor: pointer;
    font-family: var(--font-heading);
    transition: background 0.2s;
  }
  .sd-bot-btn:hover { background: #1a8bbf; }
  .sd-settings-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    background: #5B8DD9;
    color: #fff;
    border: none;
    border-radius: var(--radius);
    font-size: 0.95rem;
    cursor: pointer;
    font-family: var(--font-heading);
    transition: background 0.2s;
  }
  .sd-settings-btn:hover { background: #4a7bc4; }
  .section-label {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: 0.3rem;
  }
  .btn-row {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .custom-row {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.3rem;
  }
  .custom-row input[type="text"] {
    flex: 1;
    margin-top: 0;
  }
  .trans-btn {
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0.4rem 0.5rem;
    font-size: 0.8rem;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.15s;
    line-height: 1;
  }
  .trans-btn:hover { background: var(--color-primary-light); border-color: var(--color-primary); }
  .trans-btn.translated { background: #e6f9ee; color: #00b050; border-color: #00b050; }

  /* ===== アコーディオン ===== */
  .pb-accordion {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    margin-bottom: 0.6rem;
    overflow: hidden;
  }
  .pb-accordion summary {
    cursor: pointer;
    padding: 12px 1rem;
    font-weight: 700;
    font-size: 0.95rem;
    background: var(--color-surface);
    color: var(--color-text);
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    user-select: none;
    border-bottom: 1px solid transparent;
    transition: background 0.15s;
  }
  .pb-accordion summary::-webkit-details-marker { display: none; }
  .pb-accordion summary::after {
    content: '▶';
    font-size: 0.7rem;
    margin-left: auto;
    transition: transform 0.2s;
    color: var(--color-text-muted);
  }
  .pb-accordion[open] > summary {
    border-bottom-color: var(--color-border);
    background: var(--color-surface-raised, var(--color-surface));
  }
  .pb-accordion[open] > summary::after { transform: rotate(90deg); }
  .pb-accordion summary:hover { background: var(--color-primary-light, #fce8f3); }
  .accordion-content {
    padding: 0.8rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .accordion-content .field-group { margin-bottom: 0; }
  [data-theme=dark] .pb-accordion { border-color: var(--color-border); }
  [data-theme=dark] .pb-accordion summary { background: var(--color-surface); }
  [data-theme=dark] .pb-accordion[open] > summary { background: var(--color-surface-raised, #2a2a2a); }
  [data-theme=dark] .pb-accordion summary:hover { background: var(--color-primary-light, #3a1a2a); }

  /* ===== 色パレット ===== */
  .color-palette { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 0.3rem; }
  .color-palette--sm .color-chip { width: 22px; height: 22px; }
  .cloth-sub-row { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 0.5rem; padding: 0.5rem; background: var(--color-surface-raised); border-radius: 6px; }
  .cloth-sub-row > div { flex: 1; min-width: 120px; }
  .sub-label { display: block; font-size: 0.78rem; color: var(--color-text-muted); margin-bottom: 0.3rem; }
  .material-sel { width: 100%; font-size: 0.85rem; padding: 0.3rem 0.5rem; }
  .color-chip { width: 28px; height: 28px; border-radius: 50%; border: 2px solid transparent; cursor: pointer; transition: transform 0.1s; padding: 0; }
  .color-chip:hover { transform: scale(1.15); }
  .color-chip.selected { border-color: #333; box-shadow: 0 0 0 2px #fff, 0 0 0 4px #333; }
  [data-theme=dark] .color-chip.selected { border-color: #eee; box-shadow: 0 0 0 2px #333, 0 0 0 4px #eee; }
  .color-none-btn { font-size: 0.7rem; color: var(--color-text-muted); background: none; border: 1px solid var(--color-border); border-radius: 4px; padding: 0 0.4rem; cursor: pointer; height: 28px; line-height: 1; }
  .color-none-btn:hover { background: var(--color-primary-light); }

  /* ===== 管理人モーダル ===== */
  .admin-modal-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    background: #1e293b;
    color: #f8fafc;
    border: none;
    border-radius: var(--radius);
    font-size: 0.9rem;
    cursor: pointer;
    transition: background 0.2s;
  }
  .admin-modal-btn:hover { background: #334155; }
  .admin-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
  }
  .admin-modal-content {
    background: #1e293b;
    color: #f8fafc;
    border-radius: 12px;
    width: min(96vw, 700px);
    max-height: 88vh;
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(0,0,0,0.5);
    display: flex;
    flex-direction: column;
  }
  .admin-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.9rem 1.2rem 0.7rem;
    border-bottom: 1px solid #334155;
    flex-shrink: 0;
  }
  .admin-modal-header h3 { margin: 0; font-size: 1rem; }
  .admin-modal-close {
    background: none;
    border: none;
    color: #94a3b8;
    font-size: 1.2rem;
    cursor: pointer;
    padding: 0 0.3rem;
    line-height: 1;
  }
  .admin-modal-close:hover { color: #f8fafc; }
  /* ===== サイドバーレイアウト ===== */
  .admin-modal-body {
    display: flex;
    flex: 1;
    overflow: hidden;
    min-height: 0;
  }
  .admin-sidebar {
    width: 90px;
    min-width: 80px;
    background: #111827;
    border-right: 1px solid #334155;
    padding: 6px 0;
    flex-shrink: 0;
    overflow-y: auto;
  }
  .admin-cat {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 8px 4px;
    cursor: pointer;
    color: #64748b;
    font-size: 10px;
    text-align: center;
    border-left: 3px solid transparent;
    transition: all 0.15s;
    line-height: 1.3;
    user-select: none;
  }
  .admin-cat:hover { color: #94a3b8; background: #1e293b; }
  .admin-cat.active { color: #f472b6; border-left-color: #f472b6; background: #1e293b; }
  .cat-icon { font-size: 18px; margin-bottom: 3px; display: block; }
  .admin-content { flex: 1; overflow-y: auto; padding: 10px 12px; }
  .admin-cat-panel { display: none; }
  .admin-cat-panel.active { display: block; }
  @media (max-width: 560px) {
    .admin-modal-body { flex-direction: column; }
    .admin-sidebar { width: 100%; display: flex; flex-direction: row; overflow-x: auto; overflow-y: hidden; padding: 0; border-right: none; border-bottom: 1px solid #334155; }
    .admin-cat { min-width: 56px; flex-shrink: 0; border-left: none; border-bottom: 3px solid transparent; padding: 6px 4px; }
    .admin-cat.active { border-bottom-color: #f472b6; border-left-color: transparent; }
  }
  .admin-tabs { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 0.8rem; margin-top: 4px; }
  .admin-tab {
    padding: 5px 10px;
    border-radius: 6px;
    border: 1px solid #475569;
    background: transparent;
    color: #94a3b8;
    cursor: pointer;
    font-size: 0.82rem;
    transition: background 0.15s;
  }
  .admin-tab:hover { background: #334155; color: #f8fafc; }
  .admin-tab.active { background: #3b82f6; color: #fff; border-color: #3b82f6; }
  .admin-tab-content { display: none; }
  .admin-tab-content.active { display: block; }
  .tab-clear-row {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 6px;
  }
  .clear-tab-btn {
    background: #374151;
