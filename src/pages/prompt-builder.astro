    '青い髪': 'blue hair', '青髪': 'blue hair',
    'ピンクの髪': 'pink hair', 'ピンク髪': 'pink hair',
    '金髪': 'blonde hair', '銀髪': 'silver hair', '黒髪': 'black hair',
    '白髪': 'white hair', '赤髪': 'red hair', '緑髪': 'green hair',
    '紫髪': 'purple hair', 'グラデーション': 'gradient hair',
    // 目の色
    '青い目': 'blue eyes', '緑の目': 'green eyes', '赤い目': 'red eyes',
    '紫の目': 'purple eyes', 'オッドアイ': 'heterochromia',
    // 表情・感情
    '笑顔': 'smile', '泣いている': 'crying', '怒っている': 'angry',
    'ウィンク': 'wink', '驚いている': 'surprised', '眠そう': 'sleepy',
    '照れている': 'blushing', '真剣': 'serious', '嬉しそう': 'happy',
    '悲しそう': 'sad', 'にやり': 'smirk',
    // 服装
    'セーラー服': 'sailor uniform', '制服': 'school uniform', 'メイド服': 'maid outfit',
    '浴衣': 'yukata', '着物': 'kimono', '水着': 'swimsuit', 'パジャマ': 'pajamas',
    'ワンピース': 'dress', 'スーツ': 'suit', 'カジュアル': 'casual clothes',
    'タンクトップ': 'tank top', 'ニット': 'sweater', 'コート': 'coat',
    // ポーズ・動作
    '立っている': 'standing', '座っている': 'sitting', '走っている': 'running',
    '手を振る': 'waving', '指差し': 'pointing', 'ピースサイン': 'peace sign',
    '寝ている': 'lying down', 'ジャンプ': 'jumping', '歩いている': 'walking',
    '抱きしめる': 'hugging', '振り向く': 'looking back',
    // 背景・場所
    '白背景': 'white background', '教室': 'classroom', '空': 'sky',
    '桜': 'cherry blossoms', '都市': 'city', '自然': 'nature', '宇宙': 'space',
    '海': 'ocean', '森': 'forest', '山': 'mountain', '夜景': 'night cityscape',
    '星空': 'starry sky', '夕日': 'sunset', '部屋': 'room',
    // 品質・スタイル
    '高品質': 'best quality', 'アニメ風': 'anime style', 'リアル': 'realistic',
    '可愛い': 'cute', 'かっこいい': 'cool', '美しい': 'beautiful',
    '細部まで描写': 'highly detailed', '超高画質': 'ultra high resolution',
    '傑作': 'masterpiece', 'シネマティック': 'cinematic lighting',
    // 性別・人数
    '女の子': '1girl', '男の子': '1boy', '1人': 'solo', '2人': '2girls',
    '子供': 'child', '10代': 'teenager', '20代': 'young adult', '大人': 'adult',
    // 髪インナー・先端
    'インナーカラー': 'inner color hair', 'ルーツカラー': 'inner color hair',
    'グラデーション先端': 'gradient hair tips',
  };

  function translateText(text) {
    let result = text;
    // 長いフレーズから順に置換（部分マッチ防止）
    const keys = Object.keys(JP_DICT).sort((a, b) => b.length - a.length);
    for (const jp of keys) {
      result = result.split(jp).join(JP_DICT[jp]);
    }
    return result;
  }

  // 変換ボタンのイベント委譲
  document.addEventListener('click', function(e) {
    const btn = e.target.closest('.trans-btn');
    if (!btn) return;
    const targetId = btn.dataset.target;
    const input = document.getElementById(targetId);
    if (!input) return;
    const original = input.value;
    const translated = translateText(original);
    input.value = translated;
    input.dispatchEvent(new Event('input'));
    // 変換フィードバック
    btn.classList.add('translated');
    const orig = btn.textContent;
    btn.textContent = '✅ 変換済';
    setTimeout(() => {
      btn.classList.remove('translated');
      btn.textContent = '📝 変換';
    }, 1500);
  });
})();

(function() {
  function val(id) {
    const el = document.getElementById(id);
    return el ? el.value.trim() : '';
  }
  function checked(id) {
    const el = document.getElementById(id);
    return el ? el.checked : false;
  }

  function buildPrompt() {
    const parts = [];

    // 品質タグ
    const qtags = Array.from(document.querySelectorAll('#pb-quality-tags input[type="checkbox"]:checked'))
      .map(cb => cb.value);
    if (qtags.length) parts.push(qtags.join(', '));

    // 性別・人数・年齢
    const gender = val('pb-gender');
    if (gender) parts.push(gender);
    const count = val('pb-count');
    if (count) parts.push(count);
    const age = val('pb-age');
    if (age) parts.push(age);

    // 構図
    const composition = val('pb-composition');
    if (composition) parts.push(composition);

    // 各パーツ（プルダウン優先、手入力で上書き）
    const fields = [
      ['pb-hair', 'pb-hair-custom'],
      ['pb-haircolor', 'pb-haircolor-custom'],
      ['pb-hair-inner', 'pb-hair-inner-custom'],
      ['pb-hair-tip', 'pb-hair-tip-custom'],
      ['pb-eyes', 'pb-eyes-custom'],
      ['pb-expression', 'pb-expression-custom'],
      ['pb-outfit', 'pb-outfit-custom'],
      ['pb-pose', 'pb-pose-custom'],
      ['pb-bg', 'pb-bg-custom'],
    ];
    for (const [selId, custId] of fields) {
      const custom = val(custId);
      const sel = val(selId);
      const v = custom || sel;
      if (v) parts.push(v);
    }

    // 追加指示
    const extra = val('pb-extra');
    if (extra) parts.push(extra);

    // LoRA
    if (checked('pb-lora-on')) {
      const strength = parseFloat(document.getElementById('pb-lora-strength').value).toFixed(2);
      parts.push(`<lora:kaina_v1:${strength}>`);
    }

    return parts.join(', ');
  }

  function updatePreview() {
    const prompt = buildPrompt();
    const el = document.getElementById('pb-prompt-preview');
    el.textContent = prompt || '（選択するとここに表示されます）';

    // ネガティブ
    const neg = val('pb-negative');
    document.getElementById('pb-neg-preview').textContent = neg;

    // LoRA強度表示
    const strength = parseFloat(document.getElementById('pb-lora-strength').value).toFixed(2);
    document.getElementById('pb-lora-value').textContent = strength;
  }

  // イベントリスナー
  const watchIds = [
    'pb-composition',
    'pb-gender', 'pb-age', 'pb-count',
    'pb-hair','pb-hair-custom','pb-haircolor','pb-haircolor-custom',
    'pb-hair-inner', 'pb-hair-inner-custom',
    'pb-hair-tip', 'pb-hair-tip-custom',
    'pb-eyes','pb-eyes-custom','pb-expression','pb-expression-custom',
    'pb-outfit','pb-outfit-custom','pb-pose','pb-pose-custom',
    'pb-bg','pb-bg-custom','pb-extra','pb-negative',
    'pb-lora-on','pb-lora-strength',
  ];
  for (const id of watchIds) {
    const el = document.getElementById(id);
    if (el) {
      el.addEventListener('input', updatePreview);
      el.addEventListener('change', updatePreview);
    }
  }
  document.querySelectorAll('#pb-quality-tags input[type="checkbox"]').forEach(cb => {
    cb.addEventListener('change', updatePreview);
  });

  // コピーボタン
  document.getElementById('pb-copy-btn').addEventListener('click', async () => {
    const text = buildPrompt();
    try {
      await navigator.clipboard.writeText(text);
      const btn = document.getElementById('pb-copy-btn');
      btn.textContent = '✅ コピー済み';
      btn.classList.add('copied');
      setTimeout(() => {
        btn.textContent = '📋 コピー';
        btn.classList.remove('copied');
      }, 2000);
    } catch(e) {
      alert('コピーできませんでした。');
    }
  });

  document.getElementById('pb-copy-neg-btn').addEventListener('click', async () => {
    const text = val('pb-negative');
    try {
      await navigator.clipboard.writeText(text);
      const btn = document.getElementById('pb-copy-neg-btn');
      btn.textContent = '✅ コピー済み';
      btn.classList.add('copied');
      setTimeout(() => {
        btn.textContent = '📋 ネガコピー';
        btn.classList.remove('copied');
      }, 2000);
    } catch(e) {
      alert('コピーできませんでした。');
    }
  });

  // 初期表示
  updatePreview();
})();
</script>
