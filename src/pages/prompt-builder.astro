  // ===== 管理人モーダル制御 =====
  (function() {
    const adminModalBtn = document.getElementById('admin-modal-btn');
    const adminModal = document.getElementById('admin-modal');
    const adminModalClose = document.getElementById('admin-modal-close');
    const adminModalCancel = document.getElementById('admin-modal-cancel');

    if (!adminModalBtn || !adminModal) return;

    // モーダルを開く
    adminModalBtn.addEventListener('click', function() {
      // 未認証の場合はパスワード確認
      if (localStorage.getItem('pb_admin_auth') !== '1') {
        const input = window.prompt('管理人パスワードを入力してください');
        if (input === '393941' || input === 'zaku') {
          localStorage.setItem('pb_admin_auth', '1');
        } else {
          return;
        }
      }
      adminModal.style.display = 'flex';
    });

    // モーダルを閉じる（✕・閉じる・オーバーレイクリック）
    function closeModal() { adminModal.style.display = 'none'; }
    if (adminModalClose) adminModalClose.addEventListener('click', closeModal);
    if (adminModalCancel) adminModalCancel.addEventListener('click', closeModal);
    adminModal.addEventListener('click', function(e) {
      if (e.target === adminModal) closeModal();
    });

    // 各タブの「全チェック外す」ボタン
    adminModal.querySelectorAll('.clear-tab-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var tabId = btn.dataset.tab;
        adminModal.querySelectorAll('input[name="admin-' + tabId + '"]').forEach(function(cb) {
          cb.checked = false;
        });
      });
    });

    // タブ切り替え
    adminModal.querySelectorAll('.admin-tab').forEach(function(tab) {
      tab.addEventListener('click', function() {
        adminModal.querySelectorAll('.admin-tab').forEach(function(t) { t.classList.remove('active'); });
        adminModal.querySelectorAll('.admin-tab-content').forEach(function(c) { c.classList.remove('active'); });
        tab.classList.add('active');
        var tabContent = document.getElementById('admin-tab-' + tab.dataset.tab);
        if (tabContent) tabContent.classList.add('active');
      });
    });

    // 全クリアボタン
    var adminClearAll = document.getElementById('admin-clear-all');
    if (adminClearAll) {
      adminClearAll.addEventListener('click', function() {
        adminModal.querySelectorAll('.admin-tab-content input[type="checkbox"]').forEach(function(cb) {
          cb.checked = false;
        });
      });
    }

    // 🌸 サクラテンプレボタン
    function setColorChip(paletteInputId, value) {
      var hiddenInput = document.getElementById(paletteInputId);
      if (!hiddenInput) return;
      hiddenInput.value = value;
      var palette = hiddenInput.nextElementSibling;
      if (palette && palette.classList.contains('color-palette')) {
        palette.querySelectorAll('.color-chip').forEach(function(c) { c.classList.remove('selected'); });
        if (value) {
          var target = palette.querySelector('[data-value="' + value + '"]');
          if (target) target.classList.add('selected');
        }
      }
    }

    var sakuraBtn = document.getElementById('sakura-template-btn');
    if (sakuraBtn) {
      sakuraBtn.addEventListener('click', function() {
        // 髪型: セミロング
        var hairSel = document.getElementById('pb-hair');
        if (hairSel) { hairSel.value = 'semi-long hair'; hairSel.dispatchEvent(new Event('change')); }
        // 髪色: ピンク
        setColorChip('pb-haircolor', 'pink hair');
        document.getElementById('pb-haircolor').dispatchEvent(new Event('input'));
        // インナー色: 水色
        setColorChip('pb-hair-inner', 'light blue inner color hair');
        document.getElementById('pb-hair-inner').dispatchEvent(new Event('input'));
        // 目の色: 水色
        setColorChip('pb-eyes', 'light blue eyes');
        document.getElementById('pb-eyes').dispatchEvent(new Event('input'));
        // 目の形: 丸い目
        var eyeShapeSel = document.getElementById('pb-eye-shape');
        if (eyeShapeSel) { eyeShapeSel.value = 'round eyes'; eyeShapeSel.dispatchEvent(new Event('change')); }
        // 服装: 近未来プレイスーツ
        var outfitSel = document.getElementById('pb-outfit');
        if (outfitSel) { outfitSel.value = 'futuristic playsuit'; outfitSel.dispatchEvent(new Event('change')); }
        // 服の色: 白
        setColorChip('pb-outfit-color', 'white outfit');
        document.getElementById('pb-outfit-color').dispatchEvent(new Event('input'));
        // 表情(管理人): 驚き
        adminModal.querySelectorAll('input[name="admin-face"]').forEach(function(cb) { cb.checked = false; });
        var surprisedCb = adminModal.querySelector('input[name="admin-face"][value="surprised"]');
        if (surprisedCb) surprisedCb.checked = true;
        updatePreview();
      });
    }
  })();

  document.getElementById('send-to-shogun-btn').addEventListener('click', function() {
    // 管理人モーダルの選択を自動反映
    collectAdminSelections();
    const prompt = buildPrompt();
    if (!prompt) {
      alert('プロンプトを生成してから送信してください');
      return;
    }
    navigator.clipboard.writeText(prompt).catch(() => {});
    const countSd = document.getElementById('pb-sd-count').value || '1';
    const sizeSd = document.getElementById('pb-sd-size').value || '512x768';
    const modelSd = document.getElementById('pb-sd-model').value || '';
    const samplerSd = document.getElementById('pb-sd-sampler').value || '';
    const stepsSd = document.getElementById('pb-sd-steps').value || '28';
    const msgLines = [
      '🎨画像生成依頼(' + countSd + '枚)',
      '📐サイズ: ' + sizeSd,
      '🤖モデル: ' + modelSd,
      '🔧サンプラー: ' + samplerSd,
      '🔢ステップ数: ' + stepsSd,
      'プロンプト: ' + prompt
    ];
    const message = encodeURIComponent(msgLines.join('\n'));
    const botUsername = 'Shogun4510_bot';
    window.open('https://t.me/' + botUsername + '?text=' + message, '_blank');
    const btn = document.getElementById('send-to-shogun-btn');
    btn.textContent = '✅ コピー＆Telegram起動';
    setTimeout(() => { btn.textContent = '📤 将軍に送信'; }, 2000);
  });

  document.getElementById('pb-copy-neg-btn').addEventListener('click', async () => {
    const text = val('pb-negative');
    try {
      await navigator.clipboard.writeText(text);
      const btn = document.getElementById('pb-copy-neg-btn');
      btn.textContent = '✅ コピー済み';
      btn.classList.add('copied');
      setTimeout(() => {
        btn.textContent = '📋 ネガコピー';
        btn.classList.remove('copied');
      }, 2000);
    } catch(e) {
      alert('コピーできませんでした。');
    }
  });

  // サンプラー別最適ステップ数テーブル
  const SAMPLER_STEPS = {
    'DPM++ 2M SDE Karras': 28,
    'DPM++ 2M Karras': 25,
    'DPM++ SDE Karras': 12,
    'DPM++ 2S a Karras': 20,
    'Euler a': 25,
    'Euler': 25,
    'DDIM': 20,
    'UniPC': 20,
    'LMS': 35,
    'LMS Karras': 35,
    'Heun': 15
  };

  // サンプラー変更時にステップ数自動更新
  document.getElementById('pb-sd-sampler')?.addEventListener('change', (e) => {
    const steps = SAMPLER_STEPS[e.target.value];
    if (steps) {
      const stepsInput = document.getElementById('pb-sd-steps');
      if (stepsInput) stepsInput.value = steps;
    }
  });

  // 初期ロード時デフォルト値設定
  (function() {
    const initSampler = document.getElementById('pb-sd-sampler')?.value;
    const initSteps = SAMPLER_STEPS[initSampler];
    if (initSteps) {
      const stepsInput = document.getElementById('pb-sd-steps');
      if (stepsInput) stepsInput.value = initSteps;
    }
  })();

  // 初期表示
  updatePreview();
})();
</script>
</BaseLayout>
