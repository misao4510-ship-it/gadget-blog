  // ===== 設定エクスポート/インポート (cmd_265) =====
  (function() {
    var ALL_FIELD_IDS = watchIds.concat([
      'pb-haircolor','pb-haircolor-custom','pb-hair-inner','pb-hair-inner-custom',
      'pb-hair-tip','pb-hair-tip-custom','pb-eyes','pb-eyes-custom',
      'pb-eye-shape','pb-eye-shape-custom','pb-eyebrow-shape','pb-eyebrow-color',
      'pb-outfit-color','pb-outfit-color-custom',
      'pb-top-color','pb-top-material','pb-bottom-color','pb-bottom-material',
      'pb-legwear-color','pb-legwear-material',
    ]);

    document.getElementById('pb-export-btn').addEventListener('click', function() {
      var fields = {};
      ALL_FIELD_IDS.forEach(function(id) {
        var el = document.getElementById(id);
        if (!el) return;
        if (el.type === 'checkbox') fields[id] = el.checked;
        else fields[id] = el.value;
      });
      // quality checkboxes
      var quality = [];
      document.querySelectorAll('#pb-quality-tags input[type="checkbox"]').forEach(function(cb) {
        if (cb.checked) quality.push(cb.value);
      });
      fields['__quality'] = quality;

      // expression mood checkboxes
      var moodtags = [];
      document.querySelectorAll('#pb-expression-mood-tags input[type="checkbox"]').forEach(function(cb) {
        if (cb.checked) moodtags.push(cb.value);
      });
      fields['__moodtags'] = moodtags;

      var now = new Date();
      var ts = now.toISOString().replace(/[-:T]/g,'').slice(0,15);
      var json = JSON.stringify({ version: '1.0', timestamp: now.toISOString(), fields: fields }, null, 2);
      var blob = new Blob([json], { type: 'application/json' });
      var url = URL.createObjectURL(blob);
      var a = document.createElement('a');
      a.href = url;
      a.download = 'yukine_prompt_settings_' + ts + '.json';
      a.click();
      URL.revokeObjectURL(url);
    });

    document.getElementById('pb-import-btn').addEventListener('click', function() {
      document.getElementById('pb-import-file').click();
    });

    document.getElementById('pb-import-file').addEventListener('change', function(e) {
      var file = e.target.files[0];
      if (!file) return;
      var reader = new FileReader();
      reader.onload = function(ev) {
        try {
          var data = JSON.parse(ev.target.result);
          if (!data.fields) throw new Error('fields missing');
          var f = data.fields;

          // quality checkboxes
          if (Array.isArray(f['__quality'])) {
            document.querySelectorAll('#pb-quality-tags input[type="checkbox"]').forEach(function(cb) {
              cb.checked = f['__quality'].includes(cb.value);
            });
          }

          // expression mood checkboxes
          if (Array.isArray(f['__moodtags'])) {
            document.querySelectorAll('#pb-expression-mood-tags input[type="checkbox"]').forEach(function(cb) {
              cb.checked = f['__moodtags'].includes(cb.value);
            });
          }

          ALL_FIELD_IDS.forEach(function(id) {
            if (!(id in f)) return;
            var el = document.getElementById(id);
            if (!el) return;
            if (el.type === 'checkbox') {
              el.checked = !!f[id];
              el.dispatchEvent(new Event('change'));
            } else {
              el.value = f[id];
              el.dispatchEvent(new Event('input'));
              el.dispatchEvent(new Event('change'));
            }
          });

          // カラーパレットのチップ active class 更新
          document.querySelectorAll('.color-palette[data-input]').forEach(function(palette) {
            var inputId = palette.getAttribute('data-input');
            var inputEl = document.getElementById(inputId);
            if (!inputEl) return;
            var val = inputEl.value;
            palette.querySelectorAll('.color-chip').forEach(function(chip) {
              chip.classList.toggle('selected', chip.dataset.value === val);
            });
          });

          updatePreview();
          alert('設定を読み込みました。');
        } catch(err) {
          alert('JSONファイルの形式が不正です: ' + err.message);
        }
        e.target.value = '';
      };
      reader.readAsText(file);
    });
  })();

