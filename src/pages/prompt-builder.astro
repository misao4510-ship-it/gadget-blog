    const input = document.getElementById(targetId);
    if (!input) return;
    const original = input.value;
    const translated = translateText(original.trim());
    if (translated === original.trim()) {
      // 変換されなかった場合
      btn.textContent = '⚠️ 未対応';
      setTimeout(() => { btn.textContent = '📝 変換'; }, 1500);
    } else {
      input.value = translated;
      input.dispatchEvent(new Event('input'));
      // 変換フィードバック
      btn.classList.add('translated');
      btn.textContent = '✅ 変換済';
      setTimeout(() => {
        btn.classList.remove('translated');
        btn.textContent = '📝 変換';
      }, 1500);
    }
  });
})();

(function() {
  function val(id) {
    const el = document.getElementById(id);
    return el ? el.value.trim() : '';
  }
  function checked(id) {
    const el = document.getElementById(id);
    return el ? el.checked : false;
  }

  function buildPrompt() {
    const parts = [];

    // 品質タグ
    const qtags = Array.from(document.querySelectorAll('#pb-quality-tags input[type="checkbox"]:checked'))
      .map(cb => cb.value);
    if (qtags.length) parts.push(qtags.join(', '));

    // 表情・色気タグ
    const moodtags = Array.from(document.querySelectorAll('#pb-expression-mood-tags input[type="checkbox"]:checked'))
      .map(cb => cb.value);
    if (moodtags.length) parts.push(moodtags.join(', '));

    // 性別・人数・年齢
    const gender = val('pb-gender');
    if (gender) parts.push(gender);
    const count = val('pb-count');
    if (count) parts.push(count);
    const age = val('pb-age');
    if (age) parts.push(age);
    const bust = val('pb-bust');
    if (bust) parts.push(bust);

    // 構図
    const composition = val('pb-composition');
    if (composition) parts.push(composition);

    // カメラアングル
    const angle = val('pb-angle-custom') || val('pb-angle');
    if (angle) parts.push(angle);

    // 各パーツ（プルダウン優先、手入力で上書き）
    const fields = [
      ['pb-hair', 'pb-hair-custom'],
      ['pb-haircolor', 'pb-haircolor-custom'],
      ['pb-hair-inner', 'pb-hair-inner-custom'],
      ['pb-hair-tip', 'pb-hair-tip-custom'],
      ['pb-eyes', 'pb-eyes-custom'],
      ['pb-eye-shape', 'pb-eye-shape-custom'],
      ['pb-eyebrow-shape', 'pb-eyebrow-shape-custom'],
      ['pb-eyebrow-color', 'pb-eyebrow-color-custom'],
      ['pb-expression', 'pb-expression-custom'],
      ['pb-outfit', 'pb-outfit-custom'],
      ['pb-outfit-color', 'pb-outfit-color-custom'],
      ['pb-pose', 'pb-pose-custom'],
      ['pb-bg', 'pb-bg-custom'],
    ];
    for (const [selId, custId] of fields) {
      const custom = val(custId);
      const sel = val(selId);
      const v = custom || sel;
      if (v) parts.push(v);
    }

    // 服装詳細プルダウン + 色・材質 (cmd_222/263)
    function clothPart(itemId, colorId, matId) {
      const item = document.getElementById(itemId)?.value;
      if (!item) return;
      const color = document.getElementById(colorId)?.value || '';
      const mat   = document.getElementById(matId)?.value || '';
      parts.push([color, mat, item].filter(Boolean).join(' '));
    }
    clothPart('pb-top',     'pb-top-color',     'pb-top-material');
    clothPart('pb-bottom',  'pb-bottom-color',  'pb-bottom-material');
    clothPart('pb-legwear', 'pb-legwear-color', 'pb-legwear-material');

    // NSFW
    if (checked('pb-nsfw')) parts.push('nsfw');

    // 管理人モーダル選択プロンプト
    const adminPrompts = val('admin-prompts-output');
    if (adminPrompts) parts.push(adminPrompts);

    // ポーズプリセット
    const posePresetTags = val('admin-pose-presets-output');
    if (posePresetTags) parts.push(posePresetTags);

    // 追加指示
    const extra = val('pb-extra');
    if (extra) parts.push(extra);

    // LoRA
    if (checked('pb-lora-on')) {
      const strength = parseFloat(document.getElementById('pb-lora-strength').value).toFixed(2);
      const loraName = document.getElementById('pb-lora-name').value || 'kurokawa_v1';
      parts.push(`<lora:${loraName}:${strength}>`);
    }

    return parts.join(', ');
  }

  function updatePreview() {
    const prompt = buildPrompt();
    const el = document.getElementById('pb-prompt-preview');
    el.textContent = prompt || '（選択するとここに表示されます）';

    // ネガティブ
    const neg = val('pb-negative');
    document.getElementById('pb-neg-preview').textContent = neg;

    // LoRA強度表示
    const strength = parseFloat(document.getElementById('pb-lora-strength').value).toFixed(2);
    document.getElementById('pb-lora-value').textContent = strength;
  }

  // イベントリスナー
  const watchIds = [
    'pb-composition',
    'pb-gender', 'pb-age', 'pb-bust', 'pb-count',
    'pb-angle', 'pb-angle-custom',
    'pb-hair','pb-hair-custom','pb-haircolor','pb-haircolor-custom',
    'pb-hair-inner', 'pb-hair-inner-custom',
    'pb-hair-tip', 'pb-hair-tip-custom',
    'pb-eyes','pb-eyes-custom',
    'pb-eye-shape','pb-eye-shape-custom',
    'pb-eyebrow-shape','pb-eyebrow-shape-custom',
    'pb-eyebrow-color','pb-eyebrow-color-custom',
    'pb-expression','pb-expression-custom',
    'pb-outfit','pb-outfit-custom',
    'pb-outfit-color','pb-outfit-color-custom',
