---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="SD プロンプトビルダー"
  description="Stable Diffusion用プロンプトを素早く組み立てるツールです。"
>
<style>
  /* ===== パスワード認証画面 ===== */
  #pw-screen {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
    padding: 2rem 1rem;
  }
  .pw-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    padding: 2.5rem 2rem;
    max-width: 380px;
    width: 100%;
    text-align: center;
  }
  .pw-chara {
    line-height: 1;
    margin-bottom: 0.5rem;
    animation: pw-bounce 1.2s ease-in-out infinite;
  }
  .pw-chara-img {
    width: 140px;
    height: auto;
    display: block;
    margin: 0 auto;
  }
  @keyframes pw-bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }
  .pw-chara-name {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: 0.8rem;
    font-weight: 600;
  }
  .pw-speech {
    background: var(--color-primary-light, #fce8f3);
    color: var(--color-text);
    border-radius: 12px;
    padding: 0.8rem 1rem;
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    position: relative;
    line-height: 1.5;
  }
  .pw-speech::after {
    content: '';
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    border: 5px solid transparent;
    border-top-color: var(--color-primary-light, #fce8f3);
  }
  .pw-input-row {
    display: flex;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .pw-input-row input[type="password"] {
    flex: 1;
    padding: 0.6rem 0.8rem;
    border: 2px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-text);
    font-size: 1rem;
    box-sizing: border-box;
    transition: border-color 0.2s;
  }
  .pw-input-row input[type="password"]:focus {
    outline: none;
    border-color: var(--color-primary);
  }
  .pw-submit-btn {
    background: var(--color-primary);
    color: #fff;
    border: none;
    border-radius: var(--radius);
    padding: 0.6rem 1.2rem;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s;
    font-family: var(--font-heading);
    white-space: nowrap;
  }
  .pw-submit-btn:hover:not(:disabled) { background: var(--color-primary-dark); }
  .pw-submit-btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .pw-error {
    color: #e03a3a;
    font-size: 0.85rem;
    margin-top: 0.7rem;
    min-height: 1.2em;
  }
  .pw-lock-msg {
    color: #e07a3a;
    font-size: 0.9rem;
    font-weight: 600;
    margin-top: 0.7rem;
    min-height: 1.2em;
  }
  /* ===== メインUI（認証後） ===== */
  #pb-main { display: none; }
  /* ===== 既存スタイル ===== */
  .pb-container {
    max-width: 900px;
    margin: 2rem auto;
    padding: 0 1rem;
    font-family: var(--font-body);
  }
  h1 {
    font-size: 1.6rem;
    color: var(--color-text);
    margin-bottom: 1.5rem;
    font-family: var(--font-heading);
  }
  .pb-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }
  @media (max-width: 640px) {
    .pb-grid { grid-template-columns: 1fr; }
  }
  .form-section {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
  }
  .form-section h2 {
    font-size: 1rem;
    color: var(--color-primary);
    margin: 0 0 1rem 0;
    font-family: var(--font-heading);
  }
  .field-group {
    margin-bottom: 0.8rem;
  }
  label {
    display: block;
    font-size: 0.82rem;
    color: var(--color-text-muted);
    margin-bottom: 0.25rem;
  }
  select, input[type="text"], textarea {
    width: 100%;
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-text);
    font-size: 0.9rem;
    box-sizing: border-box;
  }
  select:focus, input[type="text"]:focus, textarea:focus {
    outline: 2px solid var(--color-primary);
    border-color: var(--color-primary);
  }
  textarea {
    resize: vertical;
    min-height: 80px;
  }
  .quality-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .quality-tags label {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.82rem;
    color: var(--color-text);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 0.25rem 0.5rem;
    cursor: pointer;
    margin-bottom: 0;
  }
  .quality-tags label:hover {
    background: var(--color-primary-light);
    border-color: var(--color-primary);
  }
  .quality-tags input[type="checkbox"] {
    width: auto;
    margin: 0;
    accent-color: var(--color-primary);
  }
  .lora-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .lora-row input[type="checkbox"] {
    accent-color: var(--color-primary);
    width: 1.1rem;
    height: 1.1rem;
  }
  .lora-row input[type="range"] {
    flex: 1;
    min-width: 100px;
    accent-color: var(--color-primary);
  }
  .lora-strength-label {
    font-size: 0.85rem;
    color: var(--color-text);
    min-width: 2.5rem;
    text-align: right;
  }
  .output-section {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .output-section h2 {
    font-size: 1rem;
    color: var(--color-primary);
    margin: 0;
    font-family: var(--font-heading);
  }
  .prompt-preview {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0.8rem;
    font-size: 0.85rem;
    color: var(--color-text);
    line-height: 1.6;
    min-height: 80px;
    word-break: break-all;
    white-space: pre-wrap;
  }
  .negative-preview {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0.8rem;
    font-size: 0.82rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    min-height: 60px;
    word-break: break-all;
    white-space: pre-wrap;
  }
  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--color-primary);
    color: #fff;
    border: none;
    border-radius: var(--radius);
    padding: 0.5rem 1.2rem;
    font-size: 0.9rem;
    cursor: pointer;
    font-family: var(--font-heading);
    transition: background 0.2s;
  }
  .copy-btn:hover { background: var(--color-primary-dark); }
  .copy-btn.copied { background: #00b050; }
  .copy-neg-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--color-surface-raised);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0.4rem 0.9rem;
    font-size: 0.85rem;
    cursor: pointer;
    transition: background 0.2s;
  }
  .copy-neg-btn:hover { background: var(--color-primary-light); }
  .copy-neg-btn.copied { background: #e6f9ee; color: #00b050; }
  .send-shogun-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    background: #0088cc;
    color: #fff;
    border: none;
    border-radius: var(--radius);
    font-size: 0.95rem;
    cursor: pointer;
    font-family: var(--font-heading);
    transition: background 0.2s;
  }
  .send-shogun-btn:hover { background: #006fa8; }
  .section-label {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: 0.3rem;
  }
  .btn-row {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .custom-row {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.3rem;
  }
  .custom-row input[type="text"] {
    flex: 1;
    margin-top: 0;
  }
  .trans-btn {
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0.4rem 0.5rem;
    font-size: 0.8rem;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.15s;
    line-height: 1;
  }
  .trans-btn:hover { background: var(--color-primary-light); border-color: var(--color-primary); }
  .trans-btn.translated { background: #e6f9ee; color: #00b050; border-color: #00b050; }

  /* ===== アコーディオン ===== */
  .pb-accordion {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    margin-bottom: 0.6rem;
    overflow: hidden;
  }
  .pb-accordion summary {
    cursor: pointer;
    padding: 12px 1rem;
    font-weight: 700;
    font-size: 0.95rem;
    background: var(--color-surface);
    color: var(--color-text);
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    user-select: none;
    border-bottom: 1px solid transparent;
    transition: background 0.15s;
  }
  .pb-accordion summary::-webkit-details-marker { display: none; }
  .pb-accordion summary::after {
    content: '▶';
    font-size: 0.7rem;
    margin-left: auto;
    transition: transform 0.2s;
    color: var(--color-text-muted);
  }
  .pb-accordion[open] > summary {
    border-bottom-color: var(--color-border);
    background: var(--color-surface-raised, var(--color-surface));
  }
  .pb-accordion[open] > summary::after { transform: rotate(90deg); }
  .pb-accordion summary:hover { background: var(--color-primary-light, #fce8f3); }
  .accordion-content {
    padding: 0.8rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .accordion-content .field-group { margin-bottom: 0; }
  [data-theme=dark] .pb-accordion { border-color: var(--color-border); }
  [data-theme=dark] .pb-accordion summary { background: var(--color-surface); }
  [data-theme=dark] .pb-accordion[open] > summary { background: var(--color-surface-raised, #2a2a2a); }
  [data-theme=dark] .pb-accordion summary:hover { background: var(--color-primary-light, #3a1a2a); }

  /* ===== 色パレット ===== */
  .color-palette { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 0.3rem; }
  .color-chip { width: 28px; height: 28px; border-radius: 50%; border: 2px solid transparent; cursor: pointer; transition: transform 0.1s; padding: 0; }
  .color-chip:hover { transform: scale(1.15); }
  .color-chip.selected { border-color: #333; box-shadow: 0 0 0 2px #fff, 0 0 0 4px #333; }
  [data-theme=dark] .color-chip.selected { border-color: #eee; box-shadow: 0 0 0 2px #333, 0 0 0 4px #eee; }
  .color-none-btn { font-size: 0.7rem; color: var(--color-text-muted); background: none; border: 1px solid var(--color-border); border-radius: 4px; padding: 0 0.4rem; cursor: pointer; height: 28px; line-height: 1; }
  .color-none-btn:hover { background: var(--color-primary-light); }

  /* ===== 管理人モーダル ===== */
  .admin-modal-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    background: #1e293b;
    color: #f8fafc;
    border: none;
    border-radius: var(--radius);
    font-size: 0.9rem;
    cursor: pointer;
    transition: background 0.2s;
  }
  .admin-modal-btn:hover { background: #334155; }
  .admin-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
  }
  .admin-modal-content {
    background: #1e293b;
    color: #f8fafc;
    border-radius: 12px;
    padding: 1.5rem;
    width: min(92vw, 520px);
    max-height: 80vh;
    overflow-y: auto;
    box-shadow: 0 8px 32px rgba(0,0,0,0.5);
  }
  .admin-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }
  .admin-modal-header h3 { margin: 0; font-size: 1rem; }
  .admin-modal-close {
    background: none;
    border: none;
    color: #94a3b8;
    font-size: 1.2rem;
    cursor: pointer;
    padding: 0 0.3rem;
    line-height: 1;
  }
  .admin-modal-close:hover { color: #f8fafc; }
  .admin-tabs { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 1rem; }
  .admin-tab {
    padding: 5px 10px;
    border-radius: 6px;
    border: 1px solid #475569;
    background: transparent;
    color: #94a3b8;
    cursor: pointer;
    font-size: 0.82rem;
    transition: background 0.15s;
  }
  .admin-tab:hover { background: #334155; color: #f8fafc; }
  .admin-tab.active { background: #3b82f6; color: #fff; border-color: #3b82f6; }
  .admin-tab-content { display: none; }
  .admin-tab-content.active { display: block; }
  .tab-clear-row {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 6px;
  }
  .clear-tab-btn {
    background: #374151;
    color: #94a3b8;
    border: 1px solid #4b5563;
    padding: 3px 10px;
    border-radius: 5px;
    cursor: pointer;
    font-size: 0.78rem;
  }
  .clear-tab-btn:hover { background: #4b5563; color: #e2e8f0; }
  .admin-option-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin-bottom: 0.5rem;
  }
  .admin-option-grid label {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 0.85rem;
    cursor: pointer;
    color: #cbd5e1;
  }
  .admin-modal-footer {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid #334155;
    flex-wrap: wrap;
  }
  .admin-modal-footer .admin-nsfw-check {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 0.85rem;
    color: #cbd5e1;
    cursor: pointer;
  }
  .admin-clear-all-btn {
    background: #dc2626;
    color: #fff;
    border: none;
    padding: 7px 12px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.85rem;
  }
  .admin-clear-all-btn:hover { background: #b91c1c; }
  .admin-modal-cancel {
    background: #475569;
    color: #f8fafc;
    border: none;
    padding: 7px 14px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.85rem;
  }
  .admin-modal-cancel:hover { background: #64748b; }
  .sakura-template-btn {
    background: linear-gradient(135deg, #ffb7c5, #ff8fab);
    color: white;
    border: none;
    padding: 8px 16px;
    border-radius: 8px;
    cursor: pointer;
    font-weight: bold;
    margin-bottom: 8px;
    font-size: 0.9rem;
  }
  .sakura-template-btn:hover { opacity: 0.85; }
</style>

<!-- パスワード認証画面 -->
<div id="pw-screen">
  <div class="pw-card">
    <div class="pw-chara">
      <img src="/images/games/chibi/sakura_chibi_v2_06_nobg.png" alt="サクラ" class="pw-chara-img" />
    </div>
    <div class="pw-chara-name">— サクラ —</div>
    <div class="pw-speech">
      ここはサクラの秘密工房✨<br />
      合言葉を教えてください💖
    </div>
    <div class="pw-input-row">
      <input type="password" id="pw-input" placeholder="合言葉" autocomplete="off" maxlength="20" />
      <button class="pw-submit-btn" id="pw-submit-btn">入る</button>
    </div>
    <div class="pw-error" id="pw-error"></div>
    <div class="pw-lock-msg" id="pw-lock-msg"></div>
  </div>
</div>

<!-- メインUI（認証後に表示） -->
<div id="pb-main">
<div class="pb-container">
  <h1>SD プロンプトビルダー</h1>
  <div class="pb-grid">
    <!-- 左: フォーム -->
    <div class="form-section">
      <h2>パーツ選択</h2>

      <!-- 👤 基本 -->
      <details class="pb-accordion" open>
        <summary>👤 基本</summary>
        <div class="accordion-content">
          <div class="field-group">
            <label for="pb-composition">構図</label>
            <select id="pb-composition">
              <option value="full body" selected>全身 (full body)</option>
              <option value="upper body">上半身 (upper body)</option>
              <option value="portrait, from chest up">バストアップ (portrait, from chest up)</option>
              <option value="close-up face">顔アップ (close-up face)</option>
              <option value="chibi, super deformed">ちびキャラ (chibi, super deformed)</option>
              <option value="cowboy shot">膝から上 (cowboy shot)</option>
              <option value="thigh up">太腿から上 (thigh up)</option>
            </select>
          </div>
          <div class="field-group">
            <label for="pb-gender">性別</label>
            <select id="pb-gender">
              <option value="">（なし）</option>
              <option value="1girl" selected>女の子 (1girl)</option>
              <option value="1boy">男の子 (1boy)</option>
              <option value="1girl, androgynous">中性的</option>
            </select>
          </div>
          <div class="field-group">
            <label for="pb-age">年齢</label>
            <select id="pb-age">
              <option value="">（なし）</option>
              <option value="child">子供</option>
              <option value="teenager">10代</option>
              <option value="young adult">20代</option>
              <option value="adult">大人</option>
            </select>
          </div>
          <div class="field-group">
            <label for="pb-count">人数</label>
            <select id="pb-count">
              <option value="">（なし）</option>
              <option value="solo">1人 (solo)</option>
              <option value="2girls">2人 (2girls)</option>
              <option value="group">グループ</option>
            </select>
          </div>
          <div class="field-group">
            <label for="pb-angle">カメラアングル</label>
            <select id="pb-angle">
              <option value="">（なし）</option>
              <option value="from front">正面</option>
              <option value="from side angle">斜め</option>
              <option value="profile view">横顔</option>
              <option value="from behind">後ろ</option>
              <option value="from above">上から</option>
              <option value="from below">下から</option>
            </select>
            <div class="custom-row"><input type="text" id="pb-angle-custom" placeholder="または手入力" /><button type="button" class="trans-btn" data-target="pb-angle-custom">📝 変換</button></div>
          </div>
        </div>
      </details>

      <!-- 💇 髪 -->
      <details class="pb-accordion">
        <summary>💇 髪</summary>
        <div class="accordion-content">
          <div class="field-group">
            <label for="pb-hair">髪型</label>
            <select id="pb-hair">
              <option value="">（なし）</option>
              <option value="long hair">ロングヘア</option>
              <option value="short hair">ショートヘア</option>
              <option value="twin tails">ツインテール</option>
              <option value="ponytail">ポニーテール</option>
              <option value="bob cut">ボブカット</option>
              <option value="semi-long hair">セミロング</option>
              <option value="braids">三つ編み</option>
            </select>
            <div class="custom-row"><input type="text" id="pb-hair-custom" placeholder="または手入力" /><button type="button" class="trans-btn" data-target="pb-hair-custom">📝 変換</button></div>
          </div>
          <div class="field-group">
            <label>髪色</label>
            <input type="hidden" id="pb-haircolor" value="" />
            <div class="color-palette" data-input="pb-haircolor">
              <button class="color-chip" type="button" data-value="red hair" style="background:#ef4444" title="赤"></button>
              <button class="color-chip" type="button" data-value="orange hair" style="background:#f97316" title="橙"></button>
              <button class="color-chip" type="button" data-value="yellow hair" style="background:#eab308" title="黄"></button>
              <button class="color-chip" type="button" data-value="yellow green hair" style="background:#84cc16" title="黄緑"></button>
              <button class="color-chip" type="button" data-value="green hair" style="background:#22c55e" title="緑"></button>
              <button class="color-chip" type="button" data-value="light blue hair" style="background:#38bdf8" title="水"></button>
              <button class="color-chip" type="button" data-value="blue hair" style="background:#3b82f6" title="青"></button>
              <button class="color-chip" type="button" data-value="purple hair" style="background:#a855f7" title="紫"></button>
              <button class="color-chip" type="button" data-value="pink hair" style="background:#ec4899" title="桃"></button>
