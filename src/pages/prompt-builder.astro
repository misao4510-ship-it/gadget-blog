  function translateText(text) {
    let result = text;
    // 長いフレーズから順に置換（部分マッチ防止）
    const keys = Object.keys(JP_DICT).sort((a, b) => b.length - a.length);
    for (const jp of keys) {
      result = result.split(jp).join(JP_DICT[jp]);
    }
    return result;
  }

  // 色パレットのクリックハンドラー（再クリックで解除トグル）
  document.addEventListener('click', function(e) {
    const chip = e.target.closest('.color-chip, .color-none-btn');
    if (!chip) return;
    const palette = chip.closest('.color-palette');
    if (!palette) return;
    const inputId = palette.dataset.input;
    const hiddenInput = document.getElementById(inputId);
    if (!hiddenInput) return;
    const isColorChip = chip.classList.contains('color-chip');
    const isSelected = chip.classList.contains('selected');
    // 全チップの選択解除
    palette.querySelectorAll('.color-chip').forEach(c => c.classList.remove('selected'));
    if (isColorChip && !isSelected) {
      // 未選択→選択
      chip.classList.add('selected');
      hiddenInput.value = chip.dataset.value || '';
    } else if (!isColorChip) {
      // ×ボタン: 色指定なし
      hiddenInput.value = '';
    } else {
      // 選択済み→解除（色指定なし）
      hiddenInput.value = '';
