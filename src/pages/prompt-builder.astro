  // ===== ポーズプリセット =====
  (function() {
    let posePresets = null;
    let selectedPoseId = null;

    async function loadPosePresets() {
      try {
        const res = await fetch('/data/pose_presets.json');
        posePresets = await res.json();
        renderPosePresets();
      } catch(e) {
        const container = document.getElementById('pose-presets-container');
        if (container) container.textContent = '読み込み失敗';
      }
    }

    function renderPosePresets() {
      const container = document.getElementById('pose-presets-container');
      if (!container || !posePresets) return;
      container.innerHTML = '';
      posePresets.categories.forEach(function(cat) {
        const presets = posePresets.presets.filter(function(p) { return p.category === cat.id; });
        const catDiv = document.createElement('div');
        catDiv.className = 'pose-category';
        const header = document.createElement('div');
        header.className = 'pose-category-header';
        header.textContent = cat.icon + ' ' + cat.name;
        catDiv.appendChild(header);
        const cards = document.createElement('div');
        cards.className = 'pose-cards';
        presets.forEach(function(preset) {
          const card = document.createElement('div');
          card.className = 'pose-card' + (selectedPoseId === preset.id ? ' selected' : '');
          card.dataset.poseId = preset.id;
          // OpenPose画像があれば表示、なければカテゴリアイコン
          const imgEl = document.createElement('img');
          imgEl.className = 'pose-card-img';
          imgEl.alt = preset.name;
          imgEl.onerror = function() {
            imgEl.style.display = 'none';
            const iconEl = document.createElement('div');
            iconEl.className = 'pose-card-icon';
            iconEl.textContent = cat.icon;
            card.insertBefore(iconEl, imgEl);
          };
          imgEl.src = preset.openpose;
          card.appendChild(imgEl);
          const nameEl = document.createElement('div');
          nameEl.className = 'pose-card-name';
          nameEl.textContent = preset.name;
          card.appendChild(nameEl);
          card.addEventListener('click', function() { selectPose(preset); });
          cards.appendChild(card);
        });
        catDiv.appendChild(cards);
        container.appendChild(catDiv);
      });
    }

    function selectPose(preset) {
      selectedPoseId = preset.id;
      const outputField = document.getElementById('admin-pose-presets-output');
      if (outputField) outputField.value = preset.tags;
      const label = document.getElementById('pose-selected-label');
      if (label) label.textContent = '選択中: ' + preset.name;
      // カード選択状態更新
      document.querySelectorAll('#pose-presets-container .pose-card').forEach(function(c) {
        c.classList.toggle('selected', c.dataset.poseId === preset.id);
      });
      if (typeof updatePreview === 'function') updatePreview();
    }

    function clearPose() {
      selectedPoseId = null;
      const outputField = document.getElementById('admin-pose-presets-output');
      if (outputField) outputField.value = '';
      const label = document.getElementById('pose-selected-label');
      if (label) label.textContent = '';
      document.querySelectorAll('#pose-presets-container .pose-card').forEach(function(c) {
        c.classList.remove('selected');
      });
      if (typeof updatePreview === 'function') updatePreview();
    }

    const clearBtn = document.getElementById('pose-clear-btn');
    if (clearBtn) clearBtn.addEventListener('click', clearPose);

    // ポーズタブを開いたときにロード（遅延ロード）
    const poseTab = document.querySelector('.admin-tab[data-tab="pose-presets"]');
    if (poseTab) {
      poseTab.addEventListener('click', function() {
        if (!posePresets) loadPosePresets();
      });
    }
    // サイドバーからも遅延ロード可能にする
    window.loadPosePresetsDelay = function() {
      if (!posePresets) loadPosePresets();
    };
  })();

  // ===== 🎨 人気プロンプト集タブ =====
  (function() {
    var popularData = null;
    var popularLoaded = false;

    async function loadPopularPrompts() {
      if (popularLoaded) return;
      popularLoaded = true;
      const container = document.getElementById('popular-prompts-container');
      if (!container) return;
      try {
        const res = await fetch('/data/civitai_popular_prompts.json');
        if (!res.ok) throw new Error('fetch failed');
        popularData = await res.json();
        renderPopularPrompts(popularData, container);
      } catch(e) {
        container.innerHTML = '<span style="color:#ef4444;">読み込み失敗: ' + e.message + '</span>';
      }
    }

    function renderPopularPrompts(data, container) {
      var html = '';

      // TOP30タグ チェックボックス
      html += '<div style="margin-bottom:0.8rem;">';
      html += '<div style="font-size:0.78rem;color:#60a5fa;margin-bottom:0.4rem;font-weight:600;">✅ Positive TOP30タグ（チェックして一括追加）</div>';
      html += '<div style="display:flex;flex-wrap:wrap;gap:4px;" id="popular-tags-grid">';
      (data.positive_top30 || []).forEach(function(item) {
        var tag = item.tag.replace(/"/g, '&quot;');
        var safeId = 'pp-' + tag.replace(/[^a-z0-9]/g, '_').substring(0, 30);
        html += '<label style="display:inline-flex;align-items:center;gap:3px;background:#1e293b;border:1px solid #334155;border-radius:4px;padding:2px 6px;cursor:pointer;font-size:0.78rem;color:#cbd5e1;">';
        html += '<input type="checkbox" class="popular-tag-cb" data-tag="' + tag + '" style="margin:0;cursor:pointer;">';
        html += '<span>' + item.tag + '</span><span style="color:#64748b;font-size:0.7rem;margin-left:2px;">×' + item.count + '</span>';
        html += '</label>';
      });
      html += '</div></div>';

      // 人気LoRAプリセット
      if (data.popular_loras && data.popular_loras.length > 0) {
        html += '<div>';
        html += '<div style="font-size:0.78rem;color:#f59e0b;margin-bottom:0.4rem;font-weight:600;">🔥 人気LoRAプリセット（クリックでLoRAタグ追加）</div>';
        html += '<div style="display:flex;flex-wrap:wrap;gap:4px;">';
        data.popular_loras.forEach(function(lora) {
          var tag = '<lora:' + lora.name + ':0.7>';
          html += '<button type="button" class="popular-lora-btn" data-lora-tag="' + tag.replace(/"/g, '&quot;') + '" ';
          html += 'style="font-size:0.75rem;padding:3px 8px;background:#292524;color:#f59e0b;border:1px solid #78350f;border-radius:4px;cursor:pointer;">';
          html += lora.name.substring(0, 20) + ' ×' + lora.count;
          html += '</button>';
        });
        html += '</div>';
        html += '<div style="font-size:0.7rem;color:#64748b;margin-top:4px;">CivitAI: <a href="https://civitai.com/models" target="_blank" style="color:#3b82f6;">civitai.com/models</a></div>';
        html += '</div>';
      }

      container.innerHTML = html;

      // LoRAボタンのクリックイベント
      container.querySelectorAll('.popular-lora-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var loraTag = btn.getAttribute('data-lora-tag');
          var addTags = document.getElementById('add-tags');
          if (addTags) {
            addTags.value = (addTags.value ? addTags.value + ', ' : '') + loraTag;
            updatePreview && updatePreview();
          }
          btn.style.background = '#292524';
          btn.style.borderColor = '#3b82f6';
          btn.style.color = '#60a5fa';
          setTimeout(function() {
            btn.style.background = '';
            btn.style.borderColor = '#78350f';
            btn.style.color = '#f59e0b';
          }, 1500);
        });
      });
    }

    // 「選択タグを追加」ボタン
    var addBtn = document.getElementById('add-selected-tags-btn');
    if (addBtn) {
      addBtn.addEventListener('click', function() {
        var checked = document.querySelectorAll('#popular-tags-grid .popular-tag-cb:checked');
        var tags = [];
        checked.forEach(function(cb) { tags.push(cb.getAttribute('data-tag')); });
        if (tags.length === 0) return;
        var addTags = document.getElementById('add-tags');
        if (addTags) {
          addTags.value = (addTags.value ? addTags.value + ', ' : '') + tags.join(', ');
          updatePreview && updatePreview();
        }
        // チェックをクリア
        checked.forEach(function(cb) { cb.checked = false; });
        addBtn.textContent = '✅ ' + tags.length + 'タグ追加しました！';
        setTimeout(function() { addBtn.textContent = '✅ 選択タグをPositiveに追加'; }, 2000);
      });
    }

    // 「チェッククリア」ボタン
    var clearTagsBtn = document.getElementById('clear-selected-tags-btn');
    if (clearTagsBtn) {
      clearTagsBtn.addEventListener('click', function() {
        document.querySelectorAll('#popular-tags-grid .popular-tag-cb').forEach(function(cb) {
          cb.checked = false;
        });
      });
    }

    // 人気カテゴリを開いたときにロード
    window.loadPopularPromptsDelay = function() {
      loadPopularPrompts();
    };
  })();

  // 初期表示
  updatePreview();
})();
</script>

<script is:inline>
// ===== Custom Dropdown (WebKitGTK <select> popup workaround) =====
(function() {
  function createCustomDropdown(selectEl) {
    var wrapper = document.createElement('div');
    wrapper.className = 'custom-dropdown';

    var trigger = document.createElement('button');
    trigger.className = 'custom-dropdown-trigger';
    trigger.type = 'button';

    var labelNode = document.createTextNode('');
    trigger.appendChild(labelNode);

    var arrow = document.createElement('span');
    arrow.className = 'dd-arrow';
    arrow.textContent = '▾';
    trigger.appendChild(arrow);

    var list = document.createElement('ul');
    list.className = 'custom-dropdown-list';

    var selectedIndex = selectEl.selectedIndex;

    function updateDisplay() {
      var opt = selectEl.options[selectedIndex];
      labelNode.textContent = opt ? opt.text : '';
    }

    function renderOptions() {
      list.innerHTML = '';
      Array.from(selectEl.options).forEach(function(opt, i) {
        var li = document.createElement('li');
        li.textContent = opt.text;
        li.dataset.value = opt.value;
        if (i === selectedIndex) li.classList.add('is-selected');
        li.addEventListener('mouseenter', function() { li.classList.add('is-selected'); });
        li.addEventListener('mouseleave', function() { if (i !== selectedIndex) li.classList.remove('is-selected'); });
        li.addEventListener('click', function() {
          selectedIndex = i;
          selectEl.selectedIndex = i;
          selectEl.value = opt.value;
          selectEl.dispatchEvent(new Event('change', { bubbles: true }));
          updateDisplay();
          closeList();
        });
        list.appendChild(li);
      });
    }

    function openList() { renderOptions(); list.style.display = 'block'; }
    function closeList() { list.style.display = 'none'; }

    trigger.addEventListener('click', function(e) {
      e.stopPropagation();
      list.style.display === 'none' ? openList() : closeList();
    });

    wrapper.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') { closeList(); return; }
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (list.style.display === 'none') { openList(); return; }
        selectedIndex = Math.min(selectedIndex + 1, selectEl.options.length - 1);
        updateDisplay(); renderOptions();
      }
      if (e.key === 'ArrowUp') {
        e.preventDefault();
        selectedIndex = Math.max(selectedIndex - 1, 0);
        updateDisplay(); renderOptions();
      }
      if (e.key === 'Enter' && list.style.display !== 'none') {
        e.preventDefault();
        selectEl.selectedIndex = selectedIndex;
        selectEl.value = selectEl.options[selectedIndex] ? selectEl.options[selectedIndex].value : '';
        selectEl.dispatchEvent(new Event('change', { bubbles: true }));
        updateDisplay(); closeList();
      }
    });
    wrapper.tabIndex = 0;

    document.addEventListener('click', function(e) {
      if (!wrapper.contains(e.target)) closeList();
    });

    selectEl.style.display = 'none';
    wrapper.appendChild(trigger);
    wrapper.appendChild(list);
    updateDisplay();

    selectEl.addEventListener('change', function() {
      selectedIndex = selectEl.selectedIndex;
      updateDisplay();
    });

    return wrapper;
  }

  function initCustomDropdowns(root) {
    (root || document).querySelectorAll('select').forEach(function(sel) {
      if (sel.dataset.noCustomDropdown) return;
      var wrapper = createCustomDropdown(sel);
      sel.parentNode.insertBefore(wrapper, sel.nextSibling);
    });
  }

  document.addEventListener('DOMContentLoaded', function() {
    initCustomDropdowns();
  });
})();
</script>

<script is:inline>
// ===== 🦴 3Dポーズビューア (Phase A-D) =====
(function() {
  // Three.js UMD動的ロード
  function loadThreeJS(cb) {
    if (window.THREE) { cb(); return; }
    var s = document.createElement('script');
    s.src = 'https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.min.js';
    s.onload = cb;
    s.onerror = function() {
      var el = document.getElementById('pose3d-loading');
      if (el) el.textContent = 'Three.js 読み込み失敗。オフライン環境では利用できません。';
    };
    document.head.appendChild(s);
  }

  // 17 OpenPose Keypoints (初期座標 x,y,z)
  var JOINT_DEFAULTS = {
    nose:           [0,    0.9,  0],
    left_eye:       [-0.05,0.95, 0.05],
    right_eye:      [0.05, 0.95, 0.05],
    left_ear:       [-0.12,0.88, 0],
    right_ear:      [0.12, 0.88, 0],
    left_shoulder:  [-0.18,0.65, 0],
    right_shoulder: [0.18, 0.65, 0],
    left_elbow:     [-0.30,0.35, 0],
    right_elbow:    [0.30, 0.35, 0],
    left_wrist:     [-0.30,0.05, 0],
    right_wrist:    [0.30, 0.05, 0],
    left_hip:       [-0.12,0.18, 0],
    right_hip:      [0.12, 0.18, 0],
    left_knee:      [-0.12,-0.22,0],
    right_knee:     [0.12, -0.22,0],
    left_ankle:     [-0.12,-0.55,0],
    right_ankle:    [0.12, -0.55,0]
  };

  var BONES = [
    ['nose','left_eye'],['nose','right_eye'],
    ['left_eye','left_ear'],['right_eye','right_ear'],
    ['left_shoulder','right_shoulder'],
    ['left_shoulder','left_elbow'],['right_shoulder','right_elbow'],
    ['left_elbow','left_wrist'],['right_elbow','right_wrist'],
    ['left_shoulder','left_hip'],['right_shoulder','right_hip'],
    ['left_hip','right_hip'],
    ['left_hip','left_knee'],['right_hip','right_knee'],
    ['left_knee','left_ankle'],['right_knee','right_ankle'],
    ['nose','left_shoulder'],['nose','right_shoulder']
  ];

  // OpenPose カラー (ボーンごと)
  var BONE_COLORS = [
    0xff3333,0xff3333,0xff6600,0xff6600,
    0xffff00,0x33ff33,0xff33ff,0x33ff33,0xff33ff,
    0x3399ff,0x3399ff,0xffffff,
    0x33ffff,0xff9933,0x33ffff,0xff9933,
    0xffff33,0xffff33
  ];

  var pose3dState = null;

  function MinimalOrbitControls(camera, domElement) {
    var self = this;
    self.enabled = true;
    var THREE = window.THREE;
    var target = new THREE.Vector3(0, 0.3, 0);
    var isDragging = false;
    var isRightDrag = false;
    var lastX, lastY;
    var sph = new THREE.Spherical();
    sph.setFromVector3(camera.position.clone().sub(target));

    function update() {
      var pos = new THREE.Vector3().setFromSpherical(sph).add(target);
      camera.position.copy(pos);
      camera.lookAt(target);
    }

    domElement.addEventListener('contextmenu', function(e) { e.preventDefault(); });

    domElement.addEventListener('mousedown', function(e) {
      if (!self.enabled) return;
      isDragging = true;
      isRightDrag = e.button === 2;
      lastX = e.clientX; lastY = e.clientY;
    });

    window.addEventListener('mousemove', function(e) {
      if (!isDragging || !self.enabled) return;
      var dx = e.clientX - lastX, dy = e.clientY - lastY;
      lastX = e.clientX; lastY = e.clientY;
      if (!isRightDrag) {
        sph.theta -= dx * 0.006;
        sph.phi -= dy * 0.006;
        sph.phi = Math.max(0.05, Math.min(Math.PI - 0.05, sph.phi));
      } else {
        var panSpeed = sph.radius * 0.0012;
        var dir = new THREE.Vector3();
        camera.getWorldDirection(dir);
        var right = new THREE.Vector3().crossVectors(dir, camera.up).normalize();
        target.addScaledVector(right, -dx * panSpeed);
        target.addScaledVector(camera.up, dy * panSpeed);
      }
      update();
    });

    window.addEventListener('mouseup', function() { isDragging = false; });

    domElement.addEventListener('wheel', function(e) {
      if (!self.enabled) return;
      e.preventDefault();
      sph.radius *= (1 + e.deltaY * 0.001);
      sph.radius = Math.max(0.5, Math.min(8, sph.radius));
      update();
    }, { passive: false });

    // タッチ
    var touches = [];
    var lastTouchDist = 0;
    domElement.addEventListener('touchstart', function(e) {
      touches = Array.from(e.touches);
      if (touches.length === 2) {
        lastTouchDist = Math.hypot(
          touches[0].clientX - touches[1].clientX,
          touches[0].clientY - touches[1].clientY
        );
      }
    }, { passive: true });

    domElement.addEventListener('touchmove', function(e) {
      if (!self.enabled) return;
      var nt = Array.from(e.touches);
      if (nt.length === 1 && touches.length >= 1) {
        var dx = nt[0].clientX - touches[0].clientX;
        var dy = nt[0].clientY - touches[0].clientY;
        sph.theta -= dx * 0.006;
        sph.phi -= dy * 0.006;
        sph.phi = Math.max(0.05, Math.min(Math.PI - 0.05, sph.phi));
        update();
      } else if (nt.length === 2 && touches.length >= 2) {
        var dist = Math.hypot(
          nt[0].clientX - nt[1].clientX,
          nt[0].clientY - nt[1].clientY
        );
        sph.radius *= lastTouchDist / dist;
        sph.radius = Math.max(0.5, Math.min(8, sph.radius));
        lastTouchDist = dist;
        update();
      }
      touches = nt;
    }, { passive: true });

    domElement.addEventListener('touchend', function(e) {
      touches = Array.from(e.touches);
    });

    update();
    this.setView = function(theta, phi, radius) {
      sph.theta = theta; sph.phi = phi; sph.radius = radius;
      update();
    };
    this.getAzimuthalAngle = function() { return sph.theta; };
    this.getPolarAngle = function() { return sph.phi; };
    this.target = target;
    this.update = update;
  }

  function initPose3D() {
    var THREE = window.THREE;
    var canvas = document.getElementById('pose3d-canvas');
    var loading = document.getElementById('pose3d-loading');
    var container = document.getElementById('pose3d-container');
    if (!canvas || !container) return;

    var w = container.clientWidth, h = container.clientHeight || 400;
    canvas.width = w; canvas.height = h;

    var renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true, alpha: false });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(w, h);
    renderer.setClearColor(0x0a0a1a);

    var scene = new THREE.Scene();
    var camera = new THREE.PerspectiveCamera(50, w / h, 0.01, 100);
    camera.position.set(0, 0.3, 3.5);

    scene.add(new THREE.AmbientLight(0xffffff, 0.6));
    var dirLight = new THREE.DirectionalLight(0xffffff, 0.8);
    dirLight.position.set(2, 4, 3);
    scene.add(dirLight);

    // グリッド
    var gridHelper = new THREE.GridHelper(2, 10, 0x333355, 0x222233);
    gridHelper.position.y = -0.6;
    scene.add(gridHelper);

    var orbit = new MinimalOrbitControls(camera, canvas);

    // ジョイント初期座標コピー
    var jointPositions = {};
    Object.keys(JOINT_DEFAULTS).forEach(function(k) {
      jointPositions[k] = JOINT_DEFAULTS[k].slice();
    });

    // ジョイントMesh生成
    var jointMeshes = {};
    var jointGeo = new THREE.SphereGeometry(0.035, 10, 8);
    Object.keys(jointPositions).forEach(function(name) {
      var mat = new THREE.MeshLambertMaterial({ color: 0xffffff, emissive: 0x444444 });
      var mesh = new THREE.Mesh(jointGeo, mat);
      var p = jointPositions[name];
      mesh.position.set(p[0], p[1], p[2]);
      mesh.userData.name = name;
      scene.add(mesh);
      jointMeshes[name] = mesh;
    });

    // ボーンLines生成
    var boneMeshes = [];
    function makeBoneLine(color) {
      var geo = new THREE.BufferGeometry();
      geo.setAttribute('position', new THREE.BufferAttribute(new Float32Array(6), 3));
      var mat = new THREE.LineBasicMaterial({ color: color, linewidth: 2 });
      var line = new THREE.Line(geo, mat);
      scene.add(line);
      return line;
    }
    BONES.forEach(function(pair, i) {
      boneMeshes.push(makeBoneLine(BONE_COLORS[i] || 0xffffff));
    });

    function updateBones() {
      BONES.forEach(function(pair, i) {
        var a = jointMeshes[pair[0]], b = jointMeshes[pair[1]];
        if (!a || !b) return;
        var pos = boneMeshes[i].geometry.attributes.position;
        pos.setXYZ(0, a.position.x, a.position.y, a.position.z);
        pos.setXYZ(1, b.position.x, b.position.y, b.position.z);
        pos.needsUpdate = true;
      });
    }
    updateBones();

    // Phase B: 関節ドラッグ
    var selectedJoint = null;
    var dragPlane = new THREE.Plane();
    var raycaster = new THREE.Raycaster();
    raycaster.params.Mesh = { threshold: 0.05 };

    function getNDC(e) {
      var rect = canvas.getBoundingClientRect();
      var cx = e.clientX !== undefined ? e.clientX : e.touches[0].clientX;
      var cy = e.clientY !== undefined ? e.clientY : e.touches[0].clientY;
      return new THREE.Vector2(
        ((cx - rect.left) / rect.width) * 2 - 1,
        -((cy - rect.top) / rect.height) * 2 + 1
      );
    }

    canvas.addEventListener('pointerdown', function(e) {
      var ndc = getNDC(e);
      raycaster.setFromCamera(ndc, camera);
      var meshArr = Object.values(jointMeshes);
      var hits = raycaster.intersectObjects(meshArr, false);
      if (hits.length > 0) {
        selectedJoint = hits[0].object.userData.name;
        orbit.enabled = false;
        var camDir = new THREE.Vector3();
        camera.getWorldDirection(camDir);
        dragPlane.setFromNormalAndCoplanarPoint(camDir, hits[0].point);
        try { canvas.setPointerCapture(e.pointerId); } catch(err) {}
        e.preventDefault();
        var status = document.getElementById('pose3d-status');
        if (status) status.textContent = '選択中: ' + selectedJoint.replace(/_/g, ' ');
      }
    });

    canvas.addEventListener('pointermove', function(e) {
      if (!selectedJoint) return;
      var ndc = getNDC(e);
      raycaster.setFromCamera(ndc, camera);
      var target = new THREE.Vector3();
      if (raycaster.ray.intersectPlane(dragPlane, target)) {
        jointMeshes[selectedJoint].position.copy(target);
        jointPositions[selectedJoint] = [target.x, target.y, target.z];
        updateBones();
      }
    });

    canvas.addEventListener('pointerup', function() {
      selectedJoint = null;
      orbit.enabled = true;
      var status = document.getElementById('pose3d-status');
      if (status) status.textContent = '';
    });

    // カメラプリセット
    var CAM_PRESETS = {
      front: [0,      Math.PI/2,  3.5],
      top:   [0,      0.2,        3.5],
      low:   [0,      Math.PI-0.3,3.5],
      side:  [Math.PI/2, Math.PI/2, 3.5],
      back:  [Math.PI,   Math.PI/2, 3.5]
    };
    document.querySelectorAll('.pose3d-cam-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var p = CAM_PRESETS[btn.dataset.cam];
        if (p) orbit.setView(p[0], p[1], p[2]);
      });
    });

    // Phase C: OpenPose PNG出力
    document.getElementById('pose3d-export-btn').addEventListener('click', function() {
      var c2 = document.createElement('canvas');
      c2.width = 512; c2.height = 512;
      var ctx = c2.getContext('2d');
      ctx.fillStyle = '#000'; ctx.fillRect(0, 0, 512, 512);

      function toScreen(worldPos) {
        var v = worldPos.clone().project(camera);
        return {
          x: (v.x + 1) / 2 * 512,
          y: (-v.y + 1) / 2 * 512
        };
      }

      // ボーン描画
      BONES.forEach(function(pair, i) {
        var a = jointMeshes[pair[0]], b = jointMeshes[pair[1]];
        if (!a || !b) return;
        var sa = toScreen(a.position), sb = toScreen(b.position);
        var col = BONE_COLORS[i] || 0xffffff;
        var r = (col >> 16) & 0xff, g = (col >> 8) & 0xff, bl = col & 0xff;
        ctx.strokeStyle = 'rgb(' + r + ',' + g + ',' + bl + ')';
        ctx.lineWidth = 4;
        ctx.beginPath();
        ctx.moveTo(sa.x, sa.y);
        ctx.lineTo(sb.x, sb.y);
        ctx.stroke();
      });

      // ジョイント描画
      Object.keys(jointMeshes).forEach(function(name) {
        var s = toScreen(jointMeshes[name].position);
        ctx.fillStyle = '#fff';
        ctx.beginPath();
        ctx.arc(s.x, s.y, 7, 0, Math.PI * 2);
        ctx.fill();
      });

      c2.toBlob(function(blob) {
        var url = URL.createObjectURL(blob);
        var link = document.createElement('a');
        link.href = url; link.download = 'openpose.png'; link.click();
        setTimeout(function() { URL.revokeObjectURL(url); }, 1000);
        var status = document.getElementById('pose3d-status');
        if (status) status.textContent = '📸 openpose.png を保存しました';
      });
    });

    // Phase D: プロンプト変換
    document.getElementById('pose3d-prompt-btn').addEventListener('click', function() {
      var jp = jointPositions;
      var tags = [];

      // 両腕の高さ
      if (jp.left_wrist[1] > jp.left_shoulder[1] && jp.right_wrist[1] > jp.right_shoulder[1]) {
        tags.push('arms up');
      } else if (jp.left_wrist[1] > jp.left_shoulder[1]) {
        tags.push('arm up');
      } else if (jp.left_wrist[1] < jp.left_hip[1] && jp.right_wrist[1] < jp.right_hip[1]) {
        tags.push('arms at sides');
      }

      // 体の傾き/姿勢
      var hipY = (jp.left_hip[1] + jp.right_hip[1]) / 2;
      var shoulderY = (jp.left_shoulder[1] + jp.right_shoulder[1]) / 2;
      if (hipY > shoulderY - 0.05) {
        tags.push('lying down');
      } else if (hipY < 0.1) {
        tags.push('sitting');
      } else {
        tags.push('standing');
      }

      // カメラ方向
      var az = orbit.getAzimuthalAngle();
      if (Math.abs(az) > 2.5) tags.push('from behind');
      else if (Math.abs(az) > 1.0) tags.push('from side');
      else tags.push('facing viewer');

      // 仰俯角
      var pol = orbit.getPolarAngle();
      if (pol < 0.8) tags.push('from above');
      else if (pol > 2.4) tags.push('from below');

      // 膝の曲がり具合
      var leftKneeBend = jp.left_knee[1] - jp.left_hip[1];
      if (leftKneeBend < -0.1) tags.push('bent knees');

      // プロンプト欄に追加
      var tagStr = tags.join(', ');
      var posField = document.getElementById('positive-prompt');
      if (posField) {
        var cur = posField.value.trim();
        posField.value = cur ? cur + ', ' + tagStr : tagStr;
      }
      var status = document.getElementById('pose3d-status');
      if (status) status.textContent = '📋 追加: ' + tagStr;
    });

    // リセット
    document.getElementById('pose3d-reset-btn').addEventListener('click', function() {
      Object.keys(JOINT_DEFAULTS).forEach(function(name) {
        jointPositions[name] = JOINT_DEFAULTS[name].slice();
        var p = jointPositions[name];
        jointMeshes[name].position.set(p[0], p[1], p[2]);
      });
      updateBones();
      orbit.setView(0, Math.PI / 2, 3.5);
      var status = document.getElementById('pose3d-status');
      if (status) status.textContent = '🔄 リセット完了';
    });

    // リサイズ対応
    var resizeObs = new ResizeObserver(function() {
      var nw = container.clientWidth, nh = container.clientHeight || 400;
      renderer.setSize(nw, nh);
      camera.aspect = nw / nh;
      camera.updateProjectionMatrix();
    });
    resizeObs.observe(container);

    // アニメーションループ
    function animate() {
      requestAnimationFrame(animate);
      updateBones();
      renderer.render(scene, camera);
    }
    animate();

    if (loading) loading.style.display = 'none';
    pose3dState = { renderer, scene, camera, orbit, jointMeshes, jointPositions };
    var status = document.getElementById('pose3d-status');
    if (status) status.textContent = '✅ 3Dビューア起動完了。ジョイント（白球）をドラッグで移動';
    setTimeout(function() {
      if (status && status.textContent.startsWith('✅')) status.textContent = '';
    }, 4000);
  }

  // タブクリックで遅延ロード
  document.addEventListener('DOMContentLoaded', function() {
    var pose3dTab = document.querySelector('.admin-tab[data-tab="pose3d"]');
    if (!pose3dTab) return;
    pose3dTab.addEventListener('click', function() {
      if (pose3dState) return;
      var loading = document.getElementById('pose3d-loading');
      if (loading) loading.textContent = '⏳ Three.js 読み込み中...';
      loadThreeJS(function() {
        if (!pose3dState) initPose3D();
      });
    });
  });
})();
</script>
</BaseLayout>
