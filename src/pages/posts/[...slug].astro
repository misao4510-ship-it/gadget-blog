---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PriceComparisonTable from '../../components/PriceComparisonTable.astro';
import PriceChart from '../../components/PriceChart.astro';
import ProductSchemaLD from '../../components/ProductSchemaLD.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import StoreLinkBox from '../../components/StoreLinkBox.astro';
import AuthorProfile from '../../components/AuthorProfile.astro';
import NaviChar from '../../components/NaviChar.astro';
import StarRating from '../../components/StarRating.astro';
import { readFileSync } from 'fs';
import { join } from 'path';
import { getPriceTrend } from '../../utils/priceTrend';
import type { TrendResult } from '../../utils/priceTrend';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const { products } = await import('../../../data/products.json');

const articleTrend: TrendResult | null = (() => {
  const firstProduct = post.data.products?.[0];
  if (!firstProduct) return null;
  try {
    const raw = readFileSync(join(process.cwd(), 'data/prices', `${firstProduct}.json`), 'utf-8');
    const data = JSON.parse(raw);
    const pricePoints = (data.history ?? [])
      .map((h: { date: string; amazon?: number; rakuten?: number }) => {
        const price = Math.min(h.amazon ?? Infinity, h.rakuten ?? Infinity);
        return isFinite(price) ? { date: h.date, price } : null;
      })
      .filter(Boolean);
    return getPriceTrend(pricePoints);
  } catch {
    return null;
  }
})();

const typeLabels: Record<string, string> = {
  review: 'レビュー', comparison: '比較', roundup: 'まとめ', ranking: 'ランキング'
};
const categoryLabels: Record<string, string> = {
  'mobile-battery': 'モバイルバッテリー',
  'usb-hub': 'USB-Cハブ',
  'earphones': 'イヤホン',
  'charger': '充電器',
  'sale-guide': 'セール情報',
  'smartwatch': 'スマートウォッチ',
  'wireless-charger': 'ワイヤレス充電器',
  'monitor': 'PCモニター',
  'keyboard': 'キーボード',
  'portable-ssd': 'ポータブルSSD',
  'iphone-case': 'iPhoneケース',
  'robot-vacuum': 'ロボット掃除機',
  'air-purifier': '空気清浄機',
  'electric-kettle': '電気ケトル',
  'hair-dryer': 'ヘアドライヤー',
  'circulator': 'サーキュレーター',
};
---
<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogImage={post.data.ogImage}
  type="article"
>
  {post.data.products.map((id: string) => <ProductSchemaLD productId={id} />)}

  <article class="article">
    <!-- Hero Image (ランキング記事では非表示) -->
    {post.data.ogImage && post.data.type !== 'ranking' && (
      <div class="article__hero">
        <img src={post.data.ogImage} alt={post.data.title} class="article__hero-img" />
      </div>
    )}

    <div class="container">
      <div class="article-layout">
        <!-- Left sidebar: ToC -->
        <aside class="article-layout__toc">
          <TableOfContents headings={headings} />
        </aside>

        <!-- Main content -->
        <div class="article-layout__main">
          <div class="article__inner">
            <!-- Meta -->
            <div class="article__meta">
              <span class="badge badge--category">{categoryLabels[post.data.category] ?? post.data.category}</span>
              <span class="badge badge--type" style="background:#fff7ed;color:#c2410c">{typeLabels[post.data.type] ?? post.data.type}</span>
              {articleTrend && (
                <span class={`price-badge price-badge--${articleTrend.color}`}>{articleTrend.label}</span>
              )}
              <span class="trust-badge">📅 最終更新: {post.data.publishDate}</span>
              <time class="article__date">{post.data.publishDate}</time>
            </div>
            <h1 class="article__title">{post.data.title}</h1>
            <StarRating rating={post.data.recommendation} />
            <!-- Admin star editor (hidden by default, shown with ?admin=1) -->
            <div id="admin-star-editor" style="display:none;">
              <div class="admin-star-bar">
                <span class="admin-star-label">⭐管理者評価:</span>
                <div class="admin-stars" id="admin-stars">
                  {[1,2,3,4,5].map(n => (
                    <button class="admin-star-btn" data-value={n} type="button">☆</button>
                  ))}
                </div>
                <span id="admin-star-value" class="admin-star-value">未設定</span>
                <button id="admin-star-save" class="admin-star-save" type="button">保存</button>
                <span id="admin-star-status" class="admin-star-status"></span>
              </div>
            </div>
            <p class="article__desc">{post.data.description}</p>

            {/* === CTA #1: Store link box at top (ランキング記事では非表示) === */}
            {post.data.products.length > 0 && post.data.type !== 'ranking' && (
              <div class="article__top-cta">
                {post.data.products.map((id: string) => (
                  <StoreLinkBox productId={id} />
                ))}
              </div>
            )}

            {/* === Product image gallery (ランキング記事では非表示) === */}
            {post.data.products.length > 0 && post.data.type !== 'ranking' && (
              <div class="article__product-gallery">
                {post.data.products.map((id: string) => {
                  const prod = products.find(p => p.id === id);
                  return prod?.image ? (
                    <div class="article__product-card">
                      <img
                        src={prod.image_url ?? prod.image}
                        alt={prod.name}
                        class="article__product-img"
                        width="300"
                        height="300"
                        loading="lazy"
                        onerror={`this.src='${prod.image}';this.onerror=null`}
                      />
                      <p class="article__product-name">{prod.name}</p>
                    </div>
                  ) : null;
                })}
              </div>
            )}

            {/* === Article content (markdown) === */}
            <div class="article__content prose">
              <Content />
            </div>

            {/* === CTA #2: Price comparison + chart (after content) === */}
            {post.data.products.length > 0 && (
              <div class="article__price-widgets">
                {post.data.products.map((id: string) => (
                  <div class="article__price-widget">
                    <PriceComparisonTable productId={id} />
                    <PriceChart productId={id} />
                  </div>
                ))}
              </div>
            )}

            {/* === CTA #3: Store link box at bottom (after price section) === */}
            {post.data.products.length > 0 && (
              <div class="article__bottom-cta">
                {post.data.products.map((id: string) => (
                  <StoreLinkBox productId={id} />
                ))}
              </div>
            )}

            {/* === Author profile (E-E-A-T) === */}
            <AuthorProfile />
          </div>

          {/* === Navi character (fixed bottom-right) === */}
          <NaviChar />
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .article__hero { width: 100%; max-height: 500px; overflow: hidden; }
  .article__hero-img { width: 100%; height: auto; max-height: 500px; object-fit: contain; }

  .article__inner { max-width: var(--content-width); margin: 0 auto; padding: 2rem 0 4rem; }

  .price-badge { font-size: 0.7rem; padding: 2px 6px; border-radius: 4px; font-weight: bold; }
  .price-badge--pink { background: #fce7f3; color: #be185d; }
  .price-badge--green { background: #dcfce7; color: #166534; }
  .price-badge--orange { background: #ffedd5; color: #c2410c; }
  .article__meta { display: flex; align-items: center; gap: .6rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .article__date { font-size: .875rem; color: var(--color-text-muted); margin-left: auto; }

  .article__title { font-size: clamp(1.5rem, 4vw, 2.2rem); font-weight: 800; line-height: 1.2; margin: .5rem 0 .75rem; color: var(--color-text); }
  .article__desc { font-size: 1.05rem; color: var(--color-text-muted); border-left: 4px solid var(--color-primary); padding-left: 1rem; margin-bottom: 1.5rem; }

  /* Top CTA */
  .article__top-cta { margin-bottom: 1.5rem; }

  /* Product gallery */
  .article__product-gallery {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1rem; margin: 1.5rem 0 2rem;
  }
  .article__product-card {
    background: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: var(--radius-lg); padding: 1rem; text-align: center;
    transition: transform .2s, box-shadow .2s;
  }
  .article__product-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }
  .article__product-img { width: 100%; max-width: 200px; height: auto; margin: 0 auto; }
  .article__product-name {
    font-size: .85rem; font-weight: 600; color: var(--color-text);
    margin: .75rem 0 0; line-height: 1.3;
  }

  .article__price-widgets { display: flex; flex-direction: column; gap: 1.5rem; margin: 2rem 0; }
  .article__price-widget { background: var(--color-bg); border-radius: var(--radius-lg); padding: 1.5rem; border: 1px solid var(--color-border); }

  /* Bottom CTA */
  .article__bottom-cta { margin: 2rem 0; }

  /* Prose styles */
  .prose h2, .prose h3, .prose h4 { scroll-margin-top: 80px; }
  .prose h2 { border-bottom: 2px solid var(--color-border); padding-bottom: .5rem; }
  .prose h3 { color: var(--color-primary); }
  .prose ul, .prose ol { padding-left: 1.5rem; margin-bottom: 1rem; }
  .prose li { margin-bottom: .35rem; }
  .prose table { width: 100%; border-collapse: collapse; margin: 1.5rem 0; font-size: .9rem; }
  .prose th { background: var(--color-primary); color: white; padding: .6rem 1rem; text-align: left; }
  .prose td { padding: .6rem 1rem; border: 1px solid var(--color-border); }
  .prose tr:nth-child(even) td { background: #f8fafc; }
  .prose blockquote { border-left: 4px solid var(--color-accent); padding: .75rem 1rem; background: #fff7ed; border-radius: 0 var(--radius) var(--radius) 0; margin: 1.5rem 0; color: #7c2d12; }
  .prose code { font-family: var(--font-mono); font-size: .875em; background: #f1f5f9; padding: .1em .35em; border-radius: 4px; }
  .prose pre { background: #1e293b; color: #e2e8f0; padding: 1.25rem; border-radius: var(--radius); overflow-x: auto; margin: 1.5rem 0; }
  .prose pre code { background: none; padding: 0; }
  .prose a { font-weight: 600; }
  .prose img { border-radius: var(--radius); margin: 1.5rem auto; box-shadow: var(--shadow-md); }

  @media (max-width: 640px) {
    .article__hero-img { height: auto; max-height: 300px; }
    .article__inner { padding: 1.5rem 0 3rem; }
  }

  /* Admin star editor */
  .admin-star-bar {
    display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;
    background: #fef3c7; border: 2px dashed #f59e0b; border-radius: 8px;
    padding: 0.5rem 1rem; margin: 0.5rem 0;
  }
  .admin-star-label { font-size: 0.85rem; font-weight: 700; color: #92400e; }
  .admin-star-btn {
    background: none; border: none; font-size: 1.5rem; cursor: pointer;
    padding: 0 2px; transition: transform 0.1s;
  }
  .admin-star-btn:hover { transform: scale(1.2); }
  .admin-star-btn.active { color: #f59e0b; }
  .admin-star-value { font-size: 0.85rem; color: #78716c; min-width: 3rem; }
  .admin-star-save {
    background: #f59e0b; color: white; border: none; border-radius: 6px;
    padding: 0.3rem 0.8rem; font-size: 0.8rem; font-weight: 700; cursor: pointer;
  }
  .admin-star-save:hover { background: #d97706; }
  .admin-star-save:disabled { background: #d1d5db; cursor: not-allowed; }
  .admin-star-status { font-size: 0.8rem; }

  /* ===== 3-column layout ===== */
  .article-layout {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 2rem;
    align-items: start;
    padding: 2rem 0 4rem;
  }
  .article-layout__toc { align-self: start; position: sticky; top: 80px; max-height: calc(100vh - 100px); overflow-y: auto; }
  .article-layout__main { min-width: 0; }

  .article-layout .article__inner { padding-top: 0; }

  /* Tablet: narrow */
  @media (max-width: 1100px) {
    .article-layout {
      grid-template-columns: 200px 1fr;
      gap: 1.5rem;
    }
  }

  /* Mobile: 1-column */
  @media (max-width: 768px) {
    .article-layout {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding: 1rem 0 3rem;
    }
    .article-layout__toc {
      order: -1;
    }
  }
</style>

<script define:vars={{ slug: post.id, currentRating: post.data.recommendation }}>
  // Admin star editor
  (function() {
    const params = new URLSearchParams(window.location.search);
    if (params.get('admin') !== '1') return;

    const editor = document.getElementById('admin-star-editor');
    if (!editor) return;
    editor.style.display = '';

    const buttons = document.querySelectorAll('.admin-star-btn');
    const valueEl = document.getElementById('admin-star-value');
    const saveBtn = document.getElementById('admin-star-save');
    const statusEl = document.getElementById('admin-star-status');
    let selectedRating = currentRating || 0;

    function renderStars(rating) {
      buttons.forEach(btn => {
        const v = parseInt(btn.dataset.value);
        btn.textContent = v <= rating ? '★' : '☆';
        btn.classList.toggle('active', v <= rating);
      });
      valueEl.textContent = rating > 0 ? rating + '/5' : '未設定';
    }

    // Half-star support: click same star toggles .5
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const v = parseInt(btn.dataset.value);
        if (selectedRating === v) {
          selectedRating = v - 0.5;
        } else {
          selectedRating = v;
        }
        renderStars(Math.ceil(selectedRating));
        valueEl.textContent = selectedRating > 0 ? selectedRating + '/5' : '未設定';
      });
    });

    renderStars(Math.ceil(selectedRating));
    if (selectedRating > 0) valueEl.textContent = selectedRating + '/5';

    // Save: send to Telegram
    saveBtn.addEventListener('click', async () => {
      if (selectedRating <= 0) { statusEl.textContent = '⚠️ 星を選択してください'; return; }

      let token = localStorage.getItem('tg_bot_token');
      let chatId = localStorage.getItem('tg_chat_id');
      if (!token || !chatId) {
        token = prompt('Telegram Bot Token を入力:');
        chatId = prompt('Telegram Chat ID を入力:');
        if (!token || !chatId) { statusEl.textContent = '❌ キャンセル'; return; }
        localStorage.setItem('tg_bot_token', token);
        localStorage.setItem('tg_chat_id', chatId);
      }

      saveBtn.disabled = true;
      statusEl.textContent = '送信中...';

      try {
        const msg = `⭐recommendation: slug=${slug} stars=${selectedRating}`;
        const resp = await fetch(`https://api.telegram.org/bot${token}/sendMessage`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ chat_id: chatId, text: msg }),
        });
        const data = await resp.json();
        if (data.ok) {
          statusEl.textContent = '✅ 送信完了！';
        } else {
          statusEl.textContent = '❌ ' + (data.description || 'エラー');
        }
      } catch (e) {
        statusEl.textContent = '❌ 通信エラー';
      }
      saveBtn.disabled = false;
    });
  })();
</script>
