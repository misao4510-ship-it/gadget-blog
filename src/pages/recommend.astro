---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';

const posts = await getCollection('posts', ({ data }) => !data.draft && data.type === 'review');

// デフォルト: おすすめ度降順（未評価は末尾）
const sortedPosts = [...posts].sort((a, b) => {
  const aVal = a.data.recommendation ?? null;
  const bVal = b.data.recommendation ?? null;
  if (aVal == null && bVal == null) return 0;
  if (aVal == null) return 1;
  if (bVal == null) return -1;
  return bVal - aVal;
});
---
<BaseLayout
  title="管理人おすすめ"
  description="管理人が実際に使って評価したおすすめガジェット一覧。★評価順・最安値更新順で確認できます。"
>
  <section class="recommend-hero">
    <div class="container">
      <h1 class="recommend-hero__title">⭐ 管理人おすすめ</h1>
      <p class="recommend-hero__desc">管理人が実際に使って評価したおすすめガジェット一覧</p>
      <span class="recommend-hero__count">{sortedPosts.length}件の記事</span>
    </div>
  </section>

  <section class="recommend-articles">
    <div class="container">
      <div class="sort-buttons">
        <button class="sort-btn active" id="sort-recommend" data-sort="recommend">⭐ おすすめ度順</button>
        <button class="sort-btn" id="sort-price" data-sort="price">💰 最安値更新順</button>
      </div>
      <div class="articles__grid" id="articles-grid">
        {sortedPosts.map(post => (
          <div
            class="article-card-wrapper"
            data-recommendation={post.data.recommendation != null ? String(post.data.recommendation) : ''}
            data-price-updated={post.data.priceUpdatedAt ?? ''}
          >
            <ArticleCard
              title={post.data.title}
              description={post.data.description}
              slug={post.id}
              category={post.data.category}
              publishDate={post.data.publishDate}
              ogImage={'/images/og-default.svg'}
              type={post.data.type}
              productId={post.data.products?.[0]}
              recommendation={post.data.recommendation}
            />
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .recommend-hero {
    padding: 3rem 0 2.5rem;
    color: white;
    background: linear-gradient(135deg, #7c3aed 0%, #ec4899 50%, #f59e0b 100%);
  }
  .recommend-hero__title { font-size: clamp(1.75rem, 4vw, 2.5rem); font-weight: 800; margin-bottom: .75rem; color: white; }
  .recommend-hero__desc { font-size: 1.05rem; color: rgba(255,255,255,.85); margin-bottom: 1rem; }
  .recommend-hero__count { background: rgba(255,255,255,.2); border: 1px solid rgba(255,255,255,.3); padding: .25em .8em; border-radius: 99px; font-size: .875rem; font-weight: 600; }

  .recommend-articles { padding: 3rem 0; }

  .sort-buttons {
    display: flex;
    gap: .75rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }
  .sort-btn {
    background: var(--color-surface);
    border: 2px solid var(--color-border);
    border-radius: 99px;
    padding: .5rem 1.25rem;
    font-size: .9rem;
    font-weight: 600;
    cursor: pointer;
    color: var(--color-text-muted);
    transition: all .2s;
  }
  .sort-btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
  .sort-btn.active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: white;
  }

  .articles__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.75rem;
  }
  .article-card-wrapper { display: flex; flex-direction: column; }

  @media (max-width: 640px) {
    .articles__grid { grid-template-columns: 1fr; }
    .recommend-hero { padding: 2rem 0 1.75rem; }
  }
</style>

<script>
  const grid = document.getElementById('articles-grid') as HTMLElement;
  const sortRecommendBtn = document.getElementById('sort-recommend') as HTMLButtonElement;
  const sortPriceBtn = document.getElementById('sort-price') as HTMLButtonElement;

  function sortCards(sortType: string) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.article-card-wrapper'));

    if (sortType === 'recommend') {
      cards.sort((a, b) => {
        const aStr = a.dataset.recommendation;
        const bStr = b.dataset.recommendation;
        const aVal = aStr ? parseFloat(aStr) : null;
        const bVal = bStr ? parseFloat(bStr) : null;
        if (aVal == null && bVal == null) return 0;
        if (aVal == null) return 1;
        if (bVal == null) return -1;
        return bVal - aVal;
      });
    } else {
      cards.sort((a, b) => {
        const aDate = a.dataset.priceUpdated || '';
        const bDate = b.dataset.priceUpdated || '';
        if (!aDate && !bDate) return 0;
        if (!aDate) return 1;
        if (!bDate) return -1;
        return new Date(bDate).getTime() - new Date(aDate).getTime();
      });
    }

    cards.forEach(card => grid.appendChild(card));
  }

  sortRecommendBtn.addEventListener('click', () => {
    sortRecommendBtn.classList.add('active');
    sortPriceBtn.classList.remove('active');
    sortCards('recommend');
  });

  sortPriceBtn.addEventListener('click', () => {
    sortPriceBtn.classList.add('active');
    sortRecommendBtn.classList.remove('active');
    sortCards('price');
  });
</script>
