---
import BaseLayout from '../layouts/BaseLayout.astro';
import productsData from '../../data/products.json';

const products = productsData.products;
const productsJson = JSON.stringify(products);
---
<BaseLayout
  title="ガジェット相性診断"
  description="3つの質問に答えるだけであなたにピッタリのガジェットをサクラが診断！予算・用途・こだわりから最適なガジェット記事をご案内します。"
>
  <div class="shindan-page">
    <div class="shindan-header">
      <h1 class="shindan-title">🔍 ガジェット相性診断</h1>
      <p class="shindan-subtitle">3つの質問でぴったりのガジェットをサクラが診断します✨</p>
    </div>

    <div class="shindan-box">
      <!-- ステップ表示 -->
      <div class="step-indicator" id="step-indicator">
        <span class="step-dot active" data-step="1"></span>
        <span class="step-line"></span>
        <span class="step-dot" data-step="2"></span>
        <span class="step-line"></span>
        <span class="step-dot" data-step="3"></span>
      </div>

      <!-- サクラのメッセージ -->
      <div class="sakura-msg">
        <img src="/images/sakura-icon.png" alt="サクラ" class="sakura-avatar" onerror="this.style.display='none'" />
        <div class="sakura-bubble" id="sakura-bubble">
          質問に答えてね！あなたにぴったりのガジェットを紹介するよ🌸
        </div>
      </div>

      <!-- Q1 -->
      <div class="question-block active" id="q1">
        <p class="question-label">Q1 / 3</p>
        <h2 class="question-text">💰 予算はどのくらい？</h2>
        <div class="choices">
          <button class="choice-btn" data-q="1" data-v="A">
            <span class="choice-icon">🪙</span>
            <span class="choice-main">5,000円以下</span>
            <span class="choice-sub">プチプラで試したい</span>
          </button>
          <button class="choice-btn" data-q="1" data-v="B">
            <span class="choice-icon">💳</span>
            <span class="choice-main">1万円以下</span>
            <span class="choice-sub">手頃な価格で高品質</span>
          </button>
          <button class="choice-btn" data-q="1" data-v="C">
            <span class="choice-icon">💎</span>
            <span class="choice-main">1万円以上</span>
            <span class="choice-sub">本格的なものが欲しい</span>
          </button>
        </div>
      </div>

      <!-- Q2 -->
      <div class="question-block" id="q2">
        <p class="question-label">Q2 / 3</p>
        <h2 class="question-text">🎯 主な用途は？</h2>
        <div class="choices">
          <button class="choice-btn" data-q="2" data-v="A">
            <span class="choice-icon">🚶</span>
            <span class="choice-main">持ち運び・外出</span>
            <span class="choice-sub">外でガンガン使いたい</span>
          </button>
          <button class="choice-btn" data-q="2" data-v="B">
            <span class="choice-icon">💻</span>
            <span class="choice-main">デスク・仕事</span>
            <span class="choice-sub">作業効率を上げたい</span>
          </button>
          <button class="choice-btn" data-q="2" data-v="C">
            <span class="choice-icon">⛺</span>
            <span class="choice-main">アウトドア・趣味</span>
            <span class="choice-sub">趣味や娯楽を充実させたい</span>
          </button>
        </div>
      </div>

      <!-- Q3 -->
      <div class="question-block" id="q3">
        <p class="question-label">Q3 / 3</p>
        <h2 class="question-text">✨ 一番のこだわりは？</h2>
        <div class="choices">
          <button class="choice-btn" data-q="3" data-v="A">
            <span class="choice-icon">⚡</span>
            <span class="choice-main">コスパ重視</span>
            <span class="choice-sub">コスパ最強のものを選ぶ</span>
          </button>
          <button class="choice-btn" data-q="3" data-v="B">
            <span class="choice-icon">🏆</span>
            <span class="choice-main">性能・品質</span>
            <span class="choice-sub">スペックや信頼性が大事</span>
          </button>
          <button class="choice-btn" data-q="3" data-v="C">
            <span class="choice-icon">🎨</span>
            <span class="choice-main">デザイン・おしゃれ</span>
            <span class="choice-sub">見た目や雰囲気も重要</span>
          </button>
        </div>
      </div>

      <!-- 結果 -->
      <div class="result-block" id="result-block">
        <div class="result-badge">🎉 診断結果</div>
        <h2 class="result-title" id="result-title"></h2>
        <p class="result-desc" id="result-desc"></p>

        <!-- おすすめ商品 -->
        <div class="product-card">
          <a id="product-link" href="#" target="_blank" rel="noopener noreferrer nofollow">
            <div class="product-img-wrap">
              <img id="product-img" src="" alt="" class="product-img hidden" />
              <div id="product-img-ph" class="product-img-ph">📦</div>
            </div>
            <div class="product-info">
              <p class="product-name" id="product-name"></p>
              <span class="product-cta">Amazon で見る →</span>
            </div>
          </a>
        </div>

        <!-- 記事リンク -->
        <a class="article-link" id="article-link" href="#">
          📖 関連記事を読む
        </a>

        <!-- サクラのコメント（結果） -->
        <div class="sakura-result-msg">
          <img src="/images/sakura-icon.png" alt="サクラ" class="sakura-avatar" onerror="this.style.display='none'" />
          <div class="sakura-bubble" id="result-comment"></div>
        </div>

        <button class="retry-btn" id="retry-btn">🔄 もう一度診断する</button>
      </div>
    </div>
  </div>
</BaseLayout>

<script define:vars={{ productsJson }}>
  const products = JSON.parse(productsJson);

  // 診断マッピング: Q1Q2Q3 → { category, article, title, desc, sakura }
  const diagMap = {
    'AAA': { category: 'mobile-battery', article: '/posts/mobile-battery-recommendation/', title: 'コスパ最強モバイルバッテリー', desc: '5,000円以下で外出中の充電切れを解消！コスパで選ぶならモバイルバッテリーが◎', sakura: 'お財布に優しくて、外でも安心！サクラもいつも持ち歩いてるよ🔋' },
    'AAB': { category: 'wireless-earbuds', article: '/posts/wireless-earphones-guide/', title: '高音質ワイヤレスイヤホン', desc: '外出先でもクリアな音楽を。5,000円以下でも性能十分なイヤホンがたくさん！', sakura: 'コードがないって本当に快適だよね！電車の中でも最高🎵' },
    'AAC': { category: 'iphone-case', article: '/posts/esr-iphone17-case-review/', title: 'おしゃれスマホケース', desc: 'プチプラでもかわいいデザインのスマホケースでイメチェン！', sakura: 'ケースって毎日目に入るから、かわいいのを選ぶと気分が上がるよ🌸' },
    'ABA': { category: 'usb-hub', article: '/posts/usbc-hub-comparison/', title: 'コスパ抜群USBハブ', desc: 'デスク環境をスッキリ整理！5,000円以下でPC作業が格段に快適になる。', sakura: 'ポートが足りない悩み、USBハブで一発解決！コスパ最強だよ⌨️' },
    'ABB': { category: 'keyboard', article: '/posts/keyboard-comparison/', title: '高性能キーボード', desc: 'デスクワークの生産性アップ！打鍵感にこだわったキーボードで作業が変わる。', sakura: 'キーボードを変えると仕事の気分まで変わるよ！ぜひ試してみて✨' },
    'ABC': { category: 'mouse', article: '/posts/keyboard-comparison/', title: 'デザイン重視マウス', desc: 'おしゃれなデスク環境づくりに！デザインと使いやすさを兼ね備えたマウス。', sakura: 'マウスはデスクの主役だよ！見た目にこだわると毎日の作業が楽しくなる🖱️' },
    'ACA': { category: 'earphones', article: '/posts/gadget-ranking-under-5000/', title: '5,000円以下コスパガジェット', desc: '趣味やアウトドアで使えるコスパ最強ガジェットを厳選！', sakura: 'この価格帯、実は宝の山なんだよ！サクラお気に入りのコスパ圏🌟' },
    'ACB': { category: 'earphones', article: '/posts/wireless-earphones-guide/', title: '高性能イヤホン', desc: 'アウトドアや運動中も高音質！スポーツにも対応したイヤホンがおすすめ。', sakura: '外で音楽聴きながら過ごすの最高だよね！高性能イヤホンで世界が変わる🎶' },
    'ACC': { category: 'bluetooth-speaker', article: '/posts/gadget-ranking-under-5000/', title: 'おしゃれBluetoothスピーカー', desc: 'アウトドアに持って行きたいおしゃれスピーカー。5,000円以下でも十分楽しめる！', sakura: 'キャンプや公園で音楽流したら最高の気分！おしゃれなデザインも◎🎵' },
    'BAA': { category: 'charger', article: '/posts/gadget-ranking-under-10000/', title: 'コスパ充電器セット', desc: '1万円以下でスマホ・PC何でも充電できる高性能充電器！外出がもっと快適に。', sakura: '充電器って意外と重要！良いものを持つと毎日のストレスが消えるよ🔌' },
    'BAB': { category: 'smartwatch', article: '/posts/smartwatch-comparison/', title: '高性能スマートウォッチ', desc: '健康管理からナビまで！外出に最適な多機能スマートウォッチ。', sakura: '着けてるだけで健康管理できちゃうの、すごくない？外出中も安心⌚' },
    'BAC': { category: 'wireless-earbuds', article: '/posts/wireless-earphones-guide/', title: 'おしゃれワイヤレスイヤホン', desc: 'デザインにこだわったワイヤレスイヤホンで外出がさらに楽しくなる！', sakura: 'おしゃれイヤホンをつけてると、気分が上がるんだよね🎨' },
    'BBA': { category: 'mouse', article: '/posts/gadget-ranking-under-10000/', title: 'コスパマウス', desc: 'デスク作業の効率を上げるコスパ最強マウス。1万円以下でも高性能！', sakura: 'マウスを変えると作業速度が変わるよ！コスパ重視ならこれ一択🖱️' },
    'BBB': { category: 'headphones', article: '/posts/wireless-earphones-guide/', title: '高性能ヘッドフォン', desc: '没入感のある音質でデスクワークが捗る！ノイズキャンセリング搭載モデルも。', sakura: 'ヘッドフォンで外の音を遮断すると集中力が全然違う！おすすめ🎧' },
    'BBC': { category: 'keyboard', article: '/posts/keyboard-comparison/', title: 'デザインキーボード', desc: 'おしゃれなデスク環境に！デザイン性の高いキーボードで作業部屋をアップグレード。', sakura: '見た目のいいキーボードって、テンション上がってタイピングも速くなる気がする✨' },
    'BCA': { category: 'bluetooth-speaker', article: '/posts/gadget-ranking-under-10000/', title: 'コスパBluetoothスピーカー', desc: '1万円以下でも高音質！アウトドアでも趣味でも活躍するスピーカー。', sakura: 'コスパスピーカーも最近めちゃくちゃ良くなってるよ！驚くはず🌟' },
    'BCB': { category: 'portable-ssd', article: '/posts/portable-ssd-comparison/', title: '高速ポータブルSSD', desc: '大容量データを高速転送！趣味の動画・写真管理にもぴったり。', sakura: 'ポータブルSSDって、一度使ったら戻れなくなるやつ！性能感動的だよ💾' },
    'BCC': { category: 'speaker', article: '/posts/gadget-ranking-under-10000/', title: 'おしゃれスピーカー', desc: 'インテリアにも馴染むデザイン性の高いスピーカーで趣味の空間を演出。', sakura: '部屋のインテリアになるスピーカー、いいよね！音楽で空間が変わる🎨' },
    'CAA': { category: 'tablet', article: '/posts/gadget-ranking-under-30000/', title: 'コスパタブレット', desc: '勉強・読書・動画鑑賞に！持ち運びできるコスパ最強タブレット。', sakura: 'タブレットって持ち歩けるのに大画面！コスパ最強の選択肢だよ📱' },
    'CAB': { category: 'e-reader', article: '/posts/gadget-ranking-under-30000/', title: '高性能電子書籍リーダー', desc: '目に優しい電子ペーパーで長時間読書も快適。持ち運びにも最適！', sakura: '電子書籍リーダー、一冊分の重さで何千冊も持ち歩けるの、最高すぎる📚' },
    'CAC': { category: 'smartwatch', article: '/posts/smartwatch-comparison/', title: 'デザインスマートウォッチ', desc: 'ファッションとして映えるおしゃれスマートウォッチ。毎日のコーデのアクセントに！', sakura: 'スマートウォッチはもはやファッションアイテム！おしゃれに決めよう⌚' },
    'CBA': { category: 'monitor', article: '/posts/pc-monitor-guide/', title: 'コスパ高解像度モニター', desc: 'デスク作業を劇的に改善！広い画面で作業効率が格段に上がる。', sakura: '大きいモニターを一回使ったら元に戻れない！コスパ最高の投資だよ🖥️' },
    'CBB': { category: 'monitor', article: '/posts/pc-monitor-guide/', title: '高性能プロ向けモニター', desc: '色再現性・応答速度・高解像度にこだわる人のためのプロ仕様モニター。', sakura: '仕事や創作に本気で向き合うなら、モニターに投資するのが一番効果的！🏆' },
    'CBC': { category: 'gaming-mouse', article: '/posts/gadget-ranking-under-30000/', title: 'おしゃれゲーミングマウス', desc: 'デザインも性能もこだわりたい人に！RGB搭載のゲーミングマウスでデスクを彩る。', sakura: 'ゲーミングマウスってデザインも超カッコいいんだよね！RGBが最高🎨' },
    'CCA': { category: 'robot-vacuum', article: '/posts/roomba-i2-review/', title: 'コスパロボット掃除機', desc: '家事を自動化してゆっくりできる時間を作ろう！コスパ最強のロボット掃除機。', sakura: 'ロボット掃除機ってホントに生活が変わるよ！掃除を任せてアウトドアを満喫しよう✨' },
    'CCB': { category: 'air-purifier', article: '/posts/sharp-air-purifier-review/', title: '高性能空気清浄機', desc: '花粉・PM2.5もしっかりキャッチ！パワフルな空気清浄機で快適な環境づくり。', sakura: 'きれいな空気って、健康への投資だよ！体が喜ぶガジェットを選ぼう🌿' },
    'CCC': { category: 'wireless-charger', article: '/posts/wireless-charger-guide/', title: 'おしゃれワイヤレス充電器', desc: '置くだけ充電でデスクをスッキリ！デザイン性の高いワイヤレス充電器で趣味部屋を演出。', sakura: 'ケーブルなしでおしゃれに充電！趣味の空間にぴったりのアイテムだよ💕' },
  };

  const questionMessages = [
    '予算を教えてね！どのくらいの価格帯で探してるの？🌸',
    '次は用途ね！どんな場面で使いたいの？🎯',
    'いよいよ最後！一番のこだわりを教えてね✨',
  ];

  let answers = {};
  const sakuraBubble = document.getElementById('sakura-bubble');
  const stepDots = document.querySelectorAll('.step-dot');
  const retryBtn = document.getElementById('retry-btn');

  function showQuestion(n) {
    document.querySelectorAll('.question-block').forEach(el => el.classList.remove('active'));
    const q = document.getElementById('q' + n);
    if (q) q.classList.add('active');
    sakuraBubble.textContent = questionMessages[n - 1];

    stepDots.forEach((dot, i) => {
      dot.classList.toggle('active', i < n);
      dot.classList.toggle('done', i < n - 1);
    });
  }

  function showResult() {
    const key = (answers[1] || 'A') + (answers[2] || 'A') + (answers[3] || 'A');
    const data = diagMap[key] || diagMap['AAA'];

    const categoryProducts = products.filter(p => p.category === data.category);
    const product = categoryProducts.length > 0 ? categoryProducts[0] : products[0];

    document.getElementById('result-title').textContent = data.title;
    document.getElementById('result-desc').textContent = data.desc;
    document.getElementById('result-comment').textContent = data.sakura;

    const articleLink = document.getElementById('article-link');
    articleLink.href = data.article;

    const productLink = document.getElementById('product-link');
    productLink.href = product.affiliate_links?.amazon?.url || '#';
    document.getElementById('product-name').textContent = product.name;

    const productImg = document.getElementById('product-img');
    const productImgPh = document.getElementById('product-img-ph');
    if (product.image_url) {
      productImg.src = product.image_url;
      productImg.alt = product.name;
      productImg.classList.remove('hidden');
      productImgPh.classList.add('hidden');
    } else {
      productImg.classList.add('hidden');
      productImgPh.classList.remove('hidden');
    }

    document.querySelectorAll('.question-block').forEach(el => el.classList.remove('active'));
    document.getElementById('step-indicator').style.opacity = '0.4';
    document.getElementById('result-block').classList.add('active');
    sakuraBubble.textContent = '診断完了！あなたにぴったりのガジェットはこれだよ🎉';
  }

  function resetQuiz() {
    answers = {};
    document.getElementById('result-block').classList.remove('active');
    document.getElementById('step-indicator').style.opacity = '1';
    document.querySelectorAll('.choice-btn').forEach(b => b.classList.remove('selected'));
    showQuestion(1);
  }

  document.querySelectorAll('.choice-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const q = parseInt(btn.dataset.q);
      const v = btn.dataset.v;
      answers[q] = v;

      btn.closest('.choices')?.querySelectorAll('.choice-btn').forEach(b => b.classList.remove('selected'));
      btn.classList.add('selected');

      setTimeout(() => {
        if (q < 3) {
          showQuestion(q + 1);
        } else {
          showResult();
        }
      }, 350);
    });
  });

  retryBtn?.addEventListener('click', resetQuiz);

  showQuestion(1);
</script>

<style>
  .shindan-page {
    max-width: 680px;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
  }

  .shindan-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .shindan-title {
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-heading, #1a1a2e);
    margin-bottom: 0.5rem;
    font-family: 'Quicksand', sans-serif;
  }

  [data-theme="dark"] .shindan-title {
    color: #f0f0f0;
  }

  .shindan-subtitle {
    font-size: 1rem;
    color: var(--color-text-muted, #666);
  }

  .shindan-box {
    background: var(--color-surface, #fff);
    border-radius: 24px;
    padding: 2.5rem 2rem;
    box-shadow: 0 4px 24px rgba(99, 102, 241, 0.12);
    border: 2px solid rgba(99, 102, 241, 0.18);
    min-height: 480px;
  }

  [data-theme="dark"] .shindan-box {
    background: var(--color-surface, #1a1a2e);
    border-color: rgba(139, 92, 246, 0.3);
    box-shadow: 0 4px 24px rgba(139, 92, 246, 0.08);
  }

  /* ステップインジケーター */
  .step-indicator {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.75rem;
    transition: opacity 0.3s;
  }

  .step-dot {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--color-border, #e5e7eb);
    border: 2px solid var(--color-border, #e5e7eb);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    font-weight: 700;
    transition: background 0.3s, border-color 0.3s;
    flex-shrink: 0;
    position: relative;
  }

  .step-dot::after {
    content: attr(data-step);
    color: #aaa;
  }

  .step-dot.active {
    background: linear-gradient(135deg, #6366f1, #ec4899);
    border-color: transparent;
  }

  .step-dot.active::after {
    color: #fff;
  }

  .step-dot.done {
    background: linear-gradient(135deg, #6366f1, #ec4899);
    border-color: transparent;
  }

  .step-dot.done::after {
    content: '✓';
    color: #fff;
  }

  .step-line {
    height: 2px;
    width: 60px;
    background: var(--color-border, #e5e7eb);
    flex-shrink: 0;
  }

  /* サクラのメッセージ */
  .sakura-msg {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .sakura-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 2px solid rgba(236, 72, 153, 0.4);
  }

  .sakura-bubble {
    background: linear-gradient(135deg, #fff0f6, #f0f0ff);
    border: 1.5px solid rgba(99, 102, 241, 0.25);
    border-radius: 16px;
    border-top-left-radius: 4px;
    padding: 0.75rem 1rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: #444;
    flex: 1;
    transition: background 0.3s;
  }

  [data-theme="dark"] .sakura-bubble {
    background: linear-gradient(135deg, #2d1b2e, #1e1b4b);
    border-color: rgba(139, 92, 246, 0.35);
    color: #f0f0f0;
  }

  /* 質問ブロック */
  .question-block {
    display: none;
    animation: fadeIn 0.35s ease;
  }

  .question-block.active {
    display: block;
  }

