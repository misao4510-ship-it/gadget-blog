---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="🔍 ガジェット相性診断"
  description="3つの質問に答えるだけ！あなたにぴったりのガジェット記事をサクラが診断します✨"
>
  <div class="shindan-page">
    <div class="shindan-header">
      <h1 class="shindan-title">🔍 ガジェット相性診断</h1>
      <p class="shindan-subtitle">3問に答えるだけで、あなたにぴったりのガジェットが見つかる！</p>
    </div>

    <!-- サクラキャラ -->
    <div class="sakura-area">
      <div class="chibi-wrapper">
        <img class="sakura-img chibi-light" src="/images/games/chibi/sakura_chibi_v2_01_nobg.png" alt="サクラ" />
        <img class="sakura-img chibi-dark" src="/images/games/chibi/black/sakura_chibi_black_01_nobg.png" alt="サクラ" />
      </div>
      <div class="sakura-bubble">
        <p id="sakura-message">どんなガジェットが気になる？✨ 一緒に探そ！</p>
      </div>
    </div>

    <div class="shindan-container" id="shindan-container">

      <!-- 開始画面 -->
      <div class="screen screen--start" id="screen-start">
        <div class="start-card">
          <h2>ガジェット相性診断 💕</h2>
          <p class="start-desc">たった3問で<strong>あなたにぴったりのガジェット記事</strong>を案内するよ！</p>
          <ul class="rule-list">
            <li>💰 予算はどのくらい？</li>
            <li>🎯 どんなシーンで使う？</li>
            <li>✨ いちばんのこだわりは？</li>
          </ul>
          <button class="btn btn--primary" id="btn-start">診断スタート！</button>
        </div>
      </div>

      <!-- 質問画面 -->
      <div class="screen screen--question" id="screen-question" style="display:none">
        <div class="progress-wrap">
          <div class="progress-bar-track">
            <div class="progress-bar-fill" id="progress-bar"></div>
          </div>
          <span class="progress-label" id="progress-label">1 / 3</span>
        </div>
        <div class="question-card" id="question-card">
          <p class="question-text" id="question-text"></p>
          <div class="choices" id="choices"></div>
        </div>
      </div>

      <!-- 結果画面 -->
      <div class="screen screen--result" id="screen-result" style="display:none">
        <div class="result-card">
          <div class="result-badge">診断結果</div>
          <h2 class="result-title" id="result-title"></h2>
          <p class="result-comment" id="result-comment"></p>
          <a class="btn btn--result" id="result-link" href="#" target="_blank" rel="noopener">
            記事を読む →
          </a>
          <button class="btn btn--retry" id="btn-retry">もう一度診断する 🔁</button>
        </div>
      </div>

    </div>
  </div>

<style>
  .shindan-page {
    max-width: 680px;
    margin: 0 auto;
    padding: 1.5rem 1rem 3rem;
  }

  .shindan-header {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .shindan-title {
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-accent, #e05a8a);
    margin: 0 0 0.4rem;
  }

  .shindan-subtitle {
    color: var(--color-text-muted, #888);
    font-size: 0.95rem;
    margin: 0;
  }

  /* サクラエリア */
  .sakura-area {
    display: flex;
    align-items: flex-end;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    padding: 0 0.5rem;
  }

  .chibi-wrapper {
    flex-shrink: 0;
    position: relative;
    width: 90px;
    height: 110px;
  }

  .sakura-img {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 90px;
    height: auto;
    transition: opacity 0.3s;
  }

  .chibi-light { opacity: 1; }
  .chibi-dark  { opacity: 0; }

  [data-theme="dark"] .chibi-light { opacity: 0; }
  [data-theme="dark"] .chibi-dark  { opacity: 1; }

  .sakura-bubble {
    background: var(--color-surface, #fff);
    border: 2px solid var(--color-accent, #e05a8a);
    border-radius: 1rem 1rem 1rem 0.25rem;
    padding: 0.75rem 1rem;
    flex: 1;
    font-size: 0.9rem;
    line-height: 1.5;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    position: relative;
  }

  .sakura-bubble p { margin: 0; }

  /* コンテナ */
  .shindan-container {
    background: var(--color-surface, #fff);
    border-radius: 1.25rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.10);
    overflow: hidden;
  }

  .screen { padding: 2rem 1.5rem; }

  /* スタート画面 */
  .start-card { text-align: center; }
  .start-card h2 { font-size: 1.5rem; font-weight: 800; margin: 0 0 0.75rem; }
  .start-desc { color: var(--color-text-muted, #666); margin-bottom: 1.25rem; line-height: 1.6; }

  .rule-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .rule-list li {
    background: var(--color-bg, #fdf5f8);
    border-radius: 0.75rem;
    padding: 0.6rem 1rem;
    font-size: 0.95rem;
    text-align: left;
  }

  /* プログレス */
  .progress-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .progress-bar-track {
    flex: 1;
    height: 8px;
    background: var(--color-bg, #f0e0ea);
    border-radius: 4px;
    overflow: hidden;
  }

  .progress-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, #e05a8a, #f0a0c0);
    border-radius: 4px;
    transition: width 0.4s ease;
  }

  .progress-label {
    font-size: 0.8rem;
    color: var(--color-text-muted, #999);
    white-space: nowrap;
  }

  /* 質問カード */
  .question-card {
    animation: slideIn 0.35s ease;
  }

  @keyframes slideIn {
    from { opacity: 0; transform: translateX(30px); }
    to   { opacity: 1; transform: translateX(0); }
  }

  .question-text {
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0 0 1.25rem;
    line-height: 1.5;
    color: var(--color-heading, #333);
  }

  .choices {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .choice-btn {
    background: var(--color-bg, #fdf5f8);
    border: 2px solid var(--color-border, #f0d0e0);
    border-radius: 1rem;
    padding: 0.85rem 1.25rem;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    text-align: left;
    transition: all 0.18s ease;
    color: var(--color-text, #333);
  }

  .choice-btn:hover {
    border-color: var(--color-accent, #e05a8a);
    background: var(--color-accent-bg, #fff0f5);
    transform: translateX(4px);
  }

  .choice-btn.selected {
    border-color: var(--color-accent, #e05a8a);
    background: linear-gradient(135deg, #e05a8a, #f07aaa);
    color: #fff;
  }

  /* 結果画面 */
  .result-card {
    text-align: center;
    animation: fadeInUp 0.5s ease;
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .result-badge {
    display: inline-block;
    background: linear-gradient(135deg, #e05a8a, #f07aaa);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.3rem 1rem;
    border-radius: 2rem;
    margin-bottom: 0.75rem;
    letter-spacing: 0.05em;
  }

  .result-title {
    font-size: 1.35rem;
    font-weight: 800;
    margin: 0 0 1rem;
    line-height: 1.4;
    color: var(--color-heading, #333);
  }

  .result-comment {
    font-size: 0.9rem;
    color: var(--color-text-muted, #666);
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }

  /* ボタン */
  .btn {
    display: inline-block;
    border: none;
    border-radius: 2rem;
    padding: 0.8rem 2rem;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
    text-decoration: none;
  }

  .btn--primary {
    background: linear-gradient(135deg, #e05a8a, #f07aaa);
    color: #fff;
    box-shadow: 0 4px 12px rgba(224,90,138,0.35);
  }

  .btn--primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(224,90,138,0.45);
  }

  .btn--result {
    display: block;
    background: linear-gradient(135deg, #e05a8a, #f07aaa);
    color: #fff;
    box-shadow: 0 4px 12px rgba(224,90,138,0.35);
    margin-bottom: 0.75rem;
  }

  .btn--result:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(224,90,138,0.45);
    color: #fff;
  }

  .btn--retry {
    background: var(--color-bg, #f8f0f4);
    color: var(--color-accent, #e05a8a);
    border: 2px solid var(--color-accent, #e05a8a);
    display: block;
    width: 100%;
  }

  .btn--retry:hover {
    background: var(--color-accent, #e05a8a);
    color: #fff;
  }

  /* ダークモード調整 */
  [data-theme="dark"] .shindan-container {
    box-shadow: 0 4px 20px rgba(0,0,0,0.35);
  }

  [data-theme="dark"] .rule-list li,
  [data-theme="dark"] .choice-btn {
    background: #2a1a22;
    border-color: #4a2a3a;
    color: #f0d0df;
  }

  [data-theme="dark"] .choice-btn:hover {
    background: #3a1a28;
    border-color: #e05a8a;
  }

  [data-theme="dark"] .btn--retry {
    background: transparent;
    color: #f07aaa;
    border-color: #f07aaa;
  }

  [data-theme="dark"] .progress-bar-track {
    background: #3a1a28;
  }

  @media (max-width: 480px) {
    .shindan-title { font-size: 1.6rem; }
    .screen { padding: 1.5rem 1rem; }
    .question-text { font-size: 1.05rem; }
  }
</style>

<script>
  const questions = [
    {
      text: "Q1. 予算はどのくらいですか？",
      choices: [
        { label: "A　5,000円以下", value: "A" },
        { label: "B　1万円以下",   value: "B" },
        { label: "C　1万円以上",   value: "C" },
      ],
      messages: [
        "予算を教えてね💰 どれくらいが理想？",
        "どのくらい使える？一緒に考えよ！",
        "予算次第でおすすめが変わるよ✨"
      ]
    },
    {
      text: "Q2. 主な使用シーンは？",
      choices: [
        { label: "A　持ち運び・外出",     value: "A" },
        { label: "B　デスク・仕事",       value: "B" },
        { label: "C　アウトドア・趣味",   value: "C" },
      ],
      messages: [
        "どんな場面で使う？🌟",
        "シーンを教えてくれると絞り込めるよ！",
        "使う場所でぴったりのガジェットが変わるね💕"
      ]
    },
    {
      text: "Q3. いちばんのこだわりは？",
      choices: [
        { label: "A　コスパ重視",       value: "A" },
        { label: "B　性能・品質",       value: "B" },
        { label: "C　デザイン・おしゃれ", value: "C" },
      ],
      messages: [
        "最後の質問！こだわりは何？✨",
        "あと一問だよ、もうちょっと！🌸",
        "こだわりを教えて！ぴったりを見つけるよ💕"
      ]
    }
  ];

  // 27通りの結果マッピング (Q1Q2Q3 → { slug, title, comment })
  const results: Record<string, { slug: string; title: string; comment: string }> = {
    // A (5000円以下)
    AAA: { slug: "anker-powercore-10000-review",        title: "Anker PowerCore 10000 レビュー",        comment: "外出×コスパ最強のモバイルバッテリー！軽くてコンパクトだから毎日持ち歩けるよ✨" },
    AAB: { slug: "portable-ssd-comparison",             title: "ポータブルSSD比較 2026年版",             comment: "外出先でデータも快適に！高性能ポータブルSSDでストレスフリーに🎵" },
    AAC: { slug: "wireless-earphones-guide",            title: "ワイヤレスイヤホンの選び方完全ガイド",   comment: "外出中のおしゃれアイテムといえばコレ！スタイリッシュなイヤホンを探してみて🌸" },
    ABA: { slug: "gadget-ranking-under-5000",           title: "5,000円以下ガジェット おすすめランキング", comment: "デスクで使えるコスパ最強ガジェットがまとめてチェックできるよ！" },
    ABB: { slug: "ciniffo-electric-air-duster-review",  title: "Ciniffo 電動エアダスター レビュー",       comment: "デスク周りをキレイに保つ高性能ガジェット！PCのホコリに悩んでいるなら必見✨" },
    ABC: { slug: "threekey-qi2-magsafe-charger-review", title: "Qi2 MagSafe充電器 レビュー",             comment: "デスクをおしゃれに彩るワイヤレス充電器！インテリアとしても映えるよ🌸" },
    ACA: { slug: "amazon-basics-aa-battery-review",     title: "Amazonベーシック 乾電池 レビュー",        comment: "アウトドアの備えはコスパ重視で！大容量パックでお得にストックしておこう💪" },
    ACB: { slug: "greeshow-gs297-radio-review",         title: "Greeshow GS-297 防災ラジオ レビュー",    comment: "アウトドアや緊急時に頼れる高性能ラジオ！性能重視ならこれが一番✨" },
    ACC: { slug: "esr-iphone17-case-review",            title: "ESR iPhone 17 ケース レビュー",          comment: "アウトドアでもスタイリッシュに！おしゃれなケースで気分を上げよう🌺" },

    // B (1万円以下)
    BAA: { slug: "mobile-battery-recommendation",       title: "モバイルバッテリー おすすめ10選",        comment: "1万円以内のコスパ最強モバイルバッテリー比較！あなたにぴったりの一台が見つかるよ💕" },
    BAB: { slug: "smartwatch-comparison",               title: "スマートウォッチ比較 2026年版",           comment: "外出の相棒に！健康管理もできる高性能スマートウォッチはどう？✨" },
    BAC: { slug: "wireless-earphones-guide",            title: "ワイヤレスイヤホンの選び方完全ガイド",   comment: "1万円以下でおしゃれなイヤホンが揃ってるよ！外出をもっと楽しくしよう🎵" },
    BBA: { slug: "usbc-hub-comparison",                 title: "USB-Cハブ 徹底比較",                     comment: "仕事効率を上げるコスパ最強のUSB-Cハブ！テレワークの必需品だよ✨" },
    BBB: { slug: "keyboard-comparison",                 title: "メカニカルキーボード比較 2026年版",       comment: "デスクワークの質が上がるキーボード！高性能タイピング体験を試してみて⌨️" },
    BBC: { slug: "threekey-qi2-magsafe-charger-review", title: "Qi2 MagSafe充電器 レビュー",             comment: "デスクにおしゃれなMagSafe充電器を置こう！シンプルでスタイリッシュ🌸" },
    BCA: { slug: "gadget-ranking-under-10000",          title: "1万円以下ガジェット おすすめランキング",  comment: "アウトドアで使えるコスパガジェットを一覧でチェックできるよ！" },
    BCB: { slug: "portable-ssd-comparison",             title: "ポータブルSSD比較 2026年版",             comment: "アウトドアでも頼れる高性能ストレージ！フィールドで大切なデータを守ろう✨" },
    BCC: { slug: "snow-peak-titanium-mug-600",          title: "Snow Peak チタンシングルマグ600 レビュー", comment: "キャンプをおしゃれに演出するチタンマグ！軽くて丈夫でかっこいいよ🏕️" },

    // C (1万円以上)
    CAA: { slug: "gadget-ranking-under-30000",          title: "3万円以下ガジェット おすすめランキング",  comment: "予算があるならコスパ重視でベストの一台を探そう！ランキングで一気にチェック✨" },
    CAB: { slug: "smartwatch-comparison",               title: "スマートウォッチ比較 2026年版",           comment: "外出に最高の高性能スマートウォッチはこれ！フル装備で日常をアップデートしよう💕" },
    CAC: { slug: "panasonic-nanocare-review",           title: "パナソニック ナノケア ドライヤー レビュー", comment: "外出先でもおしゃれを楽しむ！話題の美容家電でスタイルをキープしよう✨" },
    CBA: { slug: "pc-monitor-guide",                    title: "PCモニター 選び方ガイド",                 comment: "仕事の生産性を上げるPCモニター！コスパ重視で最高の作業環境を作ろう💼" },
    CBB: { slug: "keyboard-comparison",                 title: "メカニカルキーボード比較 2026年版",       comment: "高性能キーボードでデスクワークを極める！タイピングが楽しくなるよ⌨️" },
    CBC: { slug: "sharp-air-purifier-review",           title: "シャープ 空気清浄機 レビュー",            comment: "デスクをおしゃれに彩る空気清浄機！清潔な空気でお仕事の質が上がるよ🌿" },
    CCA: { slug: "amazon-disaster-kit-b0ct7zx2ch-review", title: "Amazon 防災セット レビュー",           comment: "アウトドアでも防災意識はコスパ重視で！いざという時の備えを万全に✊" },
    CCB: { slug: "pykes-peak-toilet-120-review",        title: "パイクスピーク 簡易トイレ レビュー",      comment: "アウトドアの高性能装備でワンランク上の体験を！快適さが段違いだよ✨" },
    CCC: { slug: "snow-peak-titanium-mug-600",          title: "Snow Peak チタンシングルマグ600 レビュー", comment: "アウトドアをおしゃれに演出！軽量チタンマグでキャンプの雰囲気アップ🏕️" },
  };

  let answers: string[] = [];
  let currentQ = 0;

  const msgEl       = document.getElementById('sakura-message')!;
  const startScreen = document.getElementById('screen-start')!;
  const qScreen     = document.getElementById('screen-question')!;
  const resScreen   = document.getElementById('screen-result')!;
  const progressBar = document.getElementById('progress-bar')!;
  const progressLbl = document.getElementById('progress-label')!;
  const questionTxt = document.getElementById('question-text')!;
  const choicesEl   = document.getElementById('choices')!;
  const resultTitle = document.getElementById('result-title')!;
  const resultComment= document.getElementById('result-comment')!;
  const resultLink  = document.getElementById('result-link') as HTMLAnchorElement;

  function setMessage(text: string) {
    msgEl.textContent = text;
  }

  function showQuestion(index: number) {
    const q = questions[index];
    const randMsg = q.messages[Math.floor(Math.random() * q.messages.length)];
    setMessage(randMsg);

    // プログレスバー
    progressBar.style.width = `${((index) / questions.length) * 100}%`;
    progressLbl.textContent = `${index + 1} / ${questions.length}`;

    questionTxt.textContent = q.text;

    // 選択肢を再生成
    choicesEl.innerHTML = '';
    q.choices.forEach(c => {
      const btn = document.createElement('button');
      btn.className = 'choice-btn';
      btn.textContent = c.label;
      btn.addEventListener('click', () => selectAnswer(c.value, btn));
      choicesEl.appendChild(btn);
    });

    // アニメーションリセット
    const card = document.getElementById('question-card')!;
    card.style.animation = 'none';
    requestAnimationFrame(() => { card.style.animation = ''; });
  }

  function selectAnswer(value: string, btn: HTMLButtonElement) {
    // ボタン無効化（連打防止）
    choicesEl.querySelectorAll('.choice-btn').forEach(b => (b as HTMLButtonElement).disabled = true);
    btn.classList.add('selected');

    answers.push(value);

    setTimeout(() => {
      currentQ++;
      if (currentQ < questions.length) {
        showQuestion(currentQ);
      } else {
        showResult();
      }
    }, 350);
  }

  function showResult() {
    const key = answers.join('') as string;
    const r = results[key];

    progressBar.style.width = '100%';

    qScreen.style.display = 'none';
    resScreen.style.display = '';

    if (r) {
      resultTitle.textContent = r.title;
      resultComment.textContent = r.comment;
      resultLink.href = `/posts/${r.slug}/`;
      setMessage(`診断完了！あなたにぴったりはこれだよ💕`);
    } else {
      resultTitle.textContent = 'モバイルバッテリー おすすめ10選';
      resultComment.textContent = 'どんな場面でも使えるモバイルバッテリーがおすすめ！一緒にチェックしてみて✨';
      resultLink.href = '/posts/mobile-battery-recommendation/';
      setMessage('診断完了！おすすめ記事を紹介するね🌸');
    }
  }

  // スタートボタン
  document.getElementById('btn-start')!.addEventListener('click', () => {
    answers = [];
    currentQ = 0;
    startScreen.style.display = 'none';
    qScreen.style.display = '';
    showQuestion(0);
  });

  // リトライボタン
  document.getElementById('btn-retry')!.addEventListener('click', () => {
    answers = [];
    currentQ = 0;
    resScreen.style.display = 'none';
    startScreen.style.display = '';
    progressBar.style.width = '0%';
