---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts', ({ data }) => !data.draft);
posts.sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime());

const ogImages: Record<string, string> = {
  'mobile-battery-recommendation': '/images/og-mobile-battery.svg',
  'anker-powercore-10000-review': '/images/og-anker-review.svg',
  'usbc-hub-comparison': '/images/og-usbc-hub.svg',
  'wireless-earphones-guide': '/images/og-earphones.svg',
  'amazon-sale-guide-2026': '/images/og-amazon-sale.svg',
};

const rankingCards = [
  { href: '/zh/posts/ranking-under-1000', label: '1000日元以下排行榜', desc: '超值小物件精选推荐' },
  { href: '/zh/posts/ranking-under-3000', label: '3000日元以下排行榜', desc: '中等价位高性价比商品' },
  { href: '/zh/posts/ranking-under-5000', label: '5000日元以下排行榜', desc: '品质与价格的最佳平衡' },
  { href: '/zh/posts/ranking-under-10000', label: '1万日元以下排行榜', desc: '优质数码产品精选' },
];
---
<BaseLayout
  title="数码产品比价博客 | 日本数码好物推荐"
  description="自动比较Amazon和乐天的数码产品价格。价格走势图一目了然，轻松找到最佳购买时机。"
>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <div class="hero__inner">
        <h1 class="hero__title">数码产品<span class="hero__accent">最低价</span>自动追踪</h1>
        <p class="hero__lead">每天自动更新Amazon・乐天的价格。通过价格走势图，一眼看出最佳购买时机。</p>
        <div class="hero__badges">
          <span>🔄 每日自动更新</span>
          <span>📊 价格走势图</span>
          <span>🏷️ 最低价高亮显示</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Ranking Cards -->
  <section class="ranking-section">
    <div class="container">
      <h2 class="section-title">按价格区间查看排行榜</h2>
      <div class="ranking-grid">
        {rankingCards.map(card => (
          <a href={card.href} class="ranking-card">
            <div class="ranking-card__label">{card.label}</div>
            <div class="ranking-card__desc">{card.desc}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Articles Grid -->
  <section class="articles">
    <div class="container">
      <h2 class="section-title">最新文章</h2>
      <div class="articles__grid">
        {posts.map(post => (
          <ArticleCard
            title={post.data.title}
            description={post.data.description}
            slug={`zh/posts/${post.id}`}
            category={post.data.category}
            publishDate={post.data.publishDate}
            ogImage={ogImages[post.id] ?? '/images/og-default.svg'}
            type={post.data.type}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    background: linear-gradient(135deg, #1e40af 0%, #2563eb 50%, #3b82f6 100%);
    color: white; padding: 4rem 0 3rem;
  }
  .hero__inner { max-width: 700px; }
  .hero__title { font-size: clamp(2rem, 5vw, 3rem); font-weight: 800; line-height: 1.15; margin-bottom: 1rem; color: white; }
  .hero__accent { color: #fbbf24; }
  .hero__lead { font-size: 1.125rem; color: #bfdbfe; margin-bottom: 1.5rem; }
  .hero__badges { display: flex; gap: .75rem; flex-wrap: wrap; }
  .hero__badges span { background: rgba(255,255,255,.15); backdrop-filter: blur(4px); border: 1px solid rgba(255,255,255,.25); padding: .35em .85em; border-radius: 99px; font-size: .875rem; font-weight: 600; }

  .ranking-section { padding: 3rem 0 1rem; }
  .section-title { font-size: 1.5rem; font-weight: 800; margin-bottom: 1.75rem; padding-bottom: .5rem; border-bottom: 3px solid var(--color-primary); display: inline-block; }
  .ranking-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem; margin-bottom: 1rem; }
  .ranking-card {
    display: block; padding: 1.25rem 1.5rem;
    background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg);
    text-decoration: none; transition: transform .2s, box-shadow .2s;
  }
  .ranking-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-hover); }
  .ranking-card__label { font-size: 1rem; font-weight: 700; color: var(--color-primary); margin-bottom: .35rem; }
  .ranking-card__desc { font-size: .875rem; color: var(--color-text-muted); }

  .articles { padding: 2rem 0 3rem; }
  .articles__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.75rem;
  }
  @media (max-width: 640px) {
    .articles__grid { grid-template-columns: 1fr; }
    .hero { padding: 2.5rem 0 2rem; }
    .ranking-grid { grid-template-columns: 1fr 1fr; }
  }
</style>
