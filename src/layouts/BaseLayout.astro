---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  type?: string;
}
const { title, description, ogImage = '/images/og-default.svg', type = 'website' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
const currentYear = new Date().getFullYear();
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <!-- ダークモード フラッシュ防止（<head>最初に実行） -->
  <script is:inline>
    (function(){
      var saved = localStorage.getItem('theme');
      var pref = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', saved || pref);
    })();
  </script>
  <title>{title} | 人生快適ブログ</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="alternate" type="application/rss+xml" title="人生快適ブログ RSS" href="/rss.xml" />
  <!-- Google Fonts: Quicksand (heading) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@600;700;800&display=swap" rel="stylesheet" />
  <!-- OGP -->
  <meta property="og:type" content={type} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="人生快適ブログ" />
  <meta property="og:locale" content="ja_JP" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />
</head>
<body>
  <!-- モバイルドロワーオーバーレイ -->
  <div id="drawer-overlay"></div>

  <!-- モバイルドロワー -->
  <div id="mobile-drawer">
    <button id="drawer-close" aria-label="メニューを閉じる">×</button>
    <nav class="drawer-nav">
      <a href="/">トップ</a>
      <a href="/categories/sale/">セール時期</a>
      <a href="/categories/ranking/">ランキング</a>
      <a href="/categories/review/">レビュー</a>
      <a href="/categories/review/gadget/" class="drawer-nav__sub">　📱 ガジェット</a>
      <a href="/categories/review/appliance/" class="drawer-nav__sub">　🏠 家電</a>
      <a href="/categories/review/disaster/" class="drawer-nav__sub">　🆘 防災</a>
      <a href="/sale-news/">セール速報</a>
      <a href="/about/">カイナとは</a>
      <a href="/faq/">FAQ</a>
    </nav>
  </div>

  <header class="site-header">
    <div class="site-header__inner">
      <a href="/" class="site-header__logo">😊 人生快適ブログ</a>
      <nav class="site-header__nav pc-nav">
        <a href="/">ホーム</a>
        <a href="/categories/sale/">セール時期</a>
        <a href="/categories/ranking/">ランキング</a>
        <div class="nav-dropdown">
          <a href="/categories/review/">レビュー</a>
          <div class="nav-dropdown__menu">
            <a href="/categories/review/gadget/">📱 ガジェット</a>
            <a href="/categories/review/appliance/">🏠 家電</a>
            <a href="/categories/review/disaster/">🆘 防災</a>
          </div>
        </div>
        <a href="/sale-news/">セール速報</a>
        <a href="/about/">カイナとは</a>
        <a href="/faq/">FAQ</a>
      </nav>
      <button id="theme-toggle" aria-label="ダークモード切り替え" class="theme-toggle-btn">☀</button>
      <button id="hamburger-btn" aria-label="メニューを開く">☰</button>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="site-footer__inner">
      <div class="site-footer__links">
        <a href="/">ホーム</a>
        <a href="/privacy-policy/">プライバシーポリシー</a>
        <a href="/sitemap-index.xml">サイトマップ</a>
      </div>
      <p>© {currentYear} 人生快適ブログ</p>
      <p class="site-footer__affiliate">
        Amazonのアソシエイトとして、当メディアは適格販売により収入を得ています。<br />
        このサイトはアフィリエイト広告（Amazonアソシエイト・楽天アフィリエイト・もしもアフィリエイト含む）を掲載しています。<br />
        掲載価格は記事作成時点のものです。実際の価格はリンク先でご確認ください。
      </p>
    </div>
  </footer>

<style>
  /* ダークモードトグルボタン */
  .theme-toggle-btn {
    background: none;
    border: none;
    font-size: 1.3rem;
    cursor: pointer;
    padding: 4px 6px;
    color: inherit;
    line-height: 1;
    border-radius: 6px;
    transition: background 0.15s;
  }
  .theme-toggle-btn:hover {
    background: rgba(128,128,128,0.15);
  }

  /* ハンバーガーボタン: モバイルのみ表示 */
  #hamburger-btn {
    display: none;
    background: none;
    border: none;
    font-size: 1.6rem;
    cursor: pointer;
    padding: 4px 8px;
    color: inherit;
    line-height: 1;
  }
  @media (max-width: 768px) {
    #hamburger-btn { display: block; }
    .pc-nav { display: none !important; }
  }

  /* PCナビ ドロップダウン */
  .nav-dropdown {
    position: relative;
  }
  .nav-dropdown__menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    background: var(--dropdown-bg);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    box-shadow: 0 4px 16px rgba(0,0,0,.12);
    min-width: 160px;
    z-index: 100;
    padding: 4px 0;
  }
  .nav-dropdown__menu a {
    display: block;
    padding: 10px 16px;
    font-size: .9rem;
    color: var(--dropdown-text);
    text-decoration: none;
    white-space: nowrap;
  }
  .nav-dropdown__menu a:hover { background: var(--dropdown-hover-bg); }
  .nav-dropdown:hover .nav-dropdown__menu { display: block; }

  /* ドロワー */
  #mobile-drawer {
    position: fixed;
    top: 0;
    left: -280px;
    width: 280px;
    height: 100%;
    background: var(--drawer-bg);
    z-index: 1001;
    transition: left 0.3s ease;
    padding: 20px;
    box-shadow: 2px 0 8px rgba(0,0,0,0.15);
  }
  #mobile-drawer.open { left: 0; }

  #drawer-close {
    background: none;
    border: none;
    font-size: 1.8rem;
    cursor: pointer;
    float: right;
    line-height: 1;
    padding: 0 4px;
    color: var(--color-text);
  }

  .drawer-nav {
    display: flex;
    flex-direction: column;
    margin-top: 48px;
    gap: 0;
  }
  .drawer-nav a {
    display: block;
    padding: 14px 8px;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
  }
  .drawer-nav a:hover { background: var(--color-surface-raised); }
  .drawer-nav .drawer-nav__sub {
    font-size: .95rem;
    font-weight: 500;
    padding: 10px 8px;
    color: var(--color-text-muted);
    background: var(--color-surface-raised);
  }
  .drawer-nav .drawer-nav__sub:hover { background: var(--color-surface); }

  /* オーバーレイ */
  #drawer-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.5);
    z-index: 1000;
  }
  #drawer-overlay.open { display: block; }
</style>

<script>
  // ドロワー
  const hamburger = document.getElementById('hamburger-btn');
  const drawer = document.getElementById('mobile-drawer');
  const overlay = document.getElementById('drawer-overlay');
  const closeBtn = document.getElementById('drawer-close');

  function openDrawer() {
    drawer?.classList.add('open');
    overlay?.classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function closeDrawer() {
    drawer?.classList.remove('open');
    overlay?.classList.remove('open');
    document.body.style.overflow = '';
  }

  hamburger?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  overlay?.addEventListener('click', closeDrawer);

  // ダークモード トグル
  const themeToggle = document.getElementById('theme-toggle');

  function updateToggleIcon() {
    if (!themeToggle) return;
    const current = document.documentElement.getAttribute('data-theme');
    themeToggle.textContent = current === 'dark' ? '🌙' : '☀';
  }

  themeToggle?.addEventListener('click', () => {
    const current = document.documentElement.getAttribute('data-theme');
    const next = current === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
    updateToggleIcon();
  });

  updateToggleIcon();
</script>

<!-- Cloudflare Web Analytics -->
<script defer src='https://static.cloudflareinsights.com/beacon.min.js'
  data-cf-beacon='{"token": "e38061c395ac4765a0b26d9395654415"}'></script>
</body>
</html>
