---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  heroImage?: string;
  ogImage?: string;
  type?: string;
}
const { title, description, heroImage, ogImage, type = 'website' } = Astro.props;
const siteUrl = 'https://gadget-blog-dxq.pages.dev';
const defaultOg = `${siteUrl}/images/og-default.png`;
const ogImageUrl = ogImage
  ? `${siteUrl}${ogImage}`
  : heroImage
    ? `${siteUrl}${heroImage}`
    : defaultOg;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const currentYear = new Date().getFullYear();
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="google-site-verification" content="ei_pWI3yRMK28fryiz7858jmvl7F0avu4YIW_sUc6qY" />
  <!-- ダークモード フラッシュ防止（<head>最初に実行） -->
  <script is:inline>
    (function(){
      var saved = localStorage.getItem('theme');
      var pref = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', saved || pref);
    })();
  </script>
  <title>{title} | 人生快適ブログ</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="alternate" type="application/rss+xml" title="人生快適ブログ RSS" href="/rss.xml" />
  <!-- Google Fonts: Quicksand (heading) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@600;700;800&display=swap" rel="stylesheet" />
  <!-- OGP -->
  <meta property="og:type" content={type} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="人生快適ブログ" />
  <meta property="og:locale" content="ja_JP" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
</head>
<body>
  <!-- モバイルドロワーオーバーレイ -->
  <div id="drawer-overlay"></div>

  <!-- モバイルドロワー -->
  <div id="mobile-drawer">
    <button id="drawer-close" aria-label="メニューを閉じる">×</button>
    <nav class="drawer-nav">
      <a href="/">トップ</a>
      <a href="/categories/sale/">セール時期</a>
      <a href="/categories/ranking/">ランキング</a>
      <a href="/categories/review/">レビュー</a>
      <a href="/sale-news/">セール速報</a>
      <a href="/about/">サクラとは</a>
      <a href="/faq/">FAQ</a>
      <a href="/prompt-builder/">🎨工房</a>
      <a href="/games/">🎮 ゲーム</a>
      <a href="/omikuji/">🎋おみくじ</a>
      <a href="/shindan/">🔍 診断</a>
      <a href="/sakura-room/" class="hidden-link" aria-label="サクラの部屋">🌸</a>
    </nav>
  </div>

  <header class="site-header">
    <div class="site-header__inner">
      <a href="/" class="site-header__logo">😊 人生快適ブログ</a>
      <nav class="site-header__nav pc-nav">
        <a href="/">ホーム</a>
        <a href="/categories/sale/">セール時期</a>
        <a href="/categories/ranking/">ランキング</a>
        <a href="/categories/review/">レビュー</a>
        <a href="/sale-news/">セール速報</a>
        <a href="/about/">サクラとは</a>
        <a href="/faq/">FAQ</a>
        <a href="/prompt-builder/">🎨工房</a>
        <a href="/games/">🎮 ゲーム</a>
        <a href="/omikuji/">🎋おみくじ</a>
        <a href="/shindan/">🔍 診断</a>
        <a href="/sakura-room/" class="hidden-link" aria-label="サクラの部屋">🌸</a>
      </nav>
      <button id="theme-toggle" aria-label="ダークモード切り替え" class="theme-toggle-btn">☀</button>
      <button id="hamburger-btn" aria-label="メニューを開く">☰</button>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="site-footer__inner">
      <div class="site-footer__links">
        <a href="/">ホーム</a>
        <a href="/privacy-policy/">プライバシーポリシー</a>
        <a href="/sitemap-index.xml">サイトマップ</a>
      </div>
      <p>© {currentYear} 人生快適ブログ</p>
      <p class="site-footer__affiliate">
        Amazonのアソシエイトとして、当メディアは適格販売により収入を得ています。<br />
        このサイトはアフィリエイト広告（Amazonアソシエイト・楽天アフィリエイト・もしもアフィリエイト含む）を掲載しています。<br />
        掲載価格は記事作成時点のものです。実際の価格はリンク先でご確認ください。
      </p>
    </div>
  </footer>

<style is:global>
  /* ダークモードトグルボタン */
  .theme-toggle-btn {
    background: none;
    border: none;
    font-size: 1.3rem;
    cursor: pointer;
    padding: 4px 6px;
    color: inherit;
    line-height: 1;
    border-radius: 6px;
    transition: background 0.15s;
  }
  .theme-toggle-btn:hover {
    background: rgba(128,128,128,0.15);
  }

  /* ハンバーガーボタン: モバイルのみ表示 */
  #hamburger-btn {
    display: none;
    background: none;
    border: none;
    font-size: 1.6rem;
    cursor: pointer;
    padding: 4px 8px;
    color: inherit;
    line-height: 1;
  }
  @media (max-width: 768px) {
    #hamburger-btn { display: block; }
    .pc-nav { display: none !important; }
  }


  /* ドロワー */
  #mobile-drawer {
    position: fixed;
    top: 0;
    left: -280px;
    width: 280px;
    height: 100%;
    background: var(--drawer-bg);
    z-index: 1001;
    transition: left 0.3s ease;
    padding: 20px;
    box-shadow: 2px 0 8px rgba(0,0,0,0.15);
  }
  #mobile-drawer.open { left: 0; }

  #drawer-close {
    background: none;
    border: none;
    font-size: 1.8rem;
    cursor: pointer;
    float: right;
    line-height: 1;
    padding: 0 4px;
    color: var(--color-text);
  }

  .drawer-nav {
    display: flex;
    flex-direction: column;
    margin-top: 48px;
    gap: 0;
  }
  .drawer-nav a {
    display: block;
    padding: 14px 8px;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
  }
  .drawer-nav a:hover { background: var(--color-surface-raised); }

  /* 隠しリンク（サクラの部屋） */
  .hidden-link {
    color: var(--header-bg, #ffffff) !important;
    transition: color 0.3s;
    text-decoration: none;
    border-bottom-color: transparent !important;
  }
  .hidden-link:hover,
  .hidden-link:focus {
    color: #ec4899 !important;
    border-bottom-color: #ec4899 !important;
  }
  [data-theme="dark"] .hidden-link {
    color: var(--header-bg, #0a0a14) !important;
  }
  [data-theme="dark"] .hidden-link:hover,
  [data-theme="dark"] .hidden-link:focus {
    color: #ec4899 !important;
  }

  /* 招待状オーバーレイ */
  #article-invitation-overlay {
    position: fixed; inset: 0;
    background: rgba(0,0,0,0.5);
    display: flex; align-items: center; justify-content: center;
    z-index: 9999;
  }
  .invitation-modal { max-width: 360px; width: 90%; }
  .invitation-letter {
    background: var(--card-bg, #fff);
    border-radius: 16px;
    padding: 32px 24px;
    text-align: center;
    box-shadow: 0 20px 60px rgba(0,0,0,0.3);
  }
  .letter-header { font-size: 1.2em; font-weight: bold; margin-bottom: 16px; }
  #article-invite-btn {
    background: #ec4899; color: white;
    border: none; border-radius: 24px;
    padding: 12px 32px; font-size: 1em;
    cursor: pointer; width: 100%; margin-top: 16px;
  }

  /* オーバーレイ */
  #drawer-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.5);
    z-index: 1000;
  }
  #drawer-overlay.open { display: block; }
</style>

<script>
  // ドロワー
  const hamburger = document.getElementById('hamburger-btn');
  const drawer = document.getElementById('mobile-drawer');
  const overlay = document.getElementById('drawer-overlay');
  const closeBtn = document.getElementById('drawer-close');

  function openDrawer() {
    drawer?.classList.add('open');
    overlay?.classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function closeDrawer() {
    drawer?.classList.remove('open');
    overlay?.classList.remove('open');
    document.body.style.overflow = '';
  }

  hamburger?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  overlay?.addEventListener('click', closeDrawer);

  // ダークモード トグル
  const themeToggle = document.getElementById('theme-toggle');

  function updateToggleIcon() {
    if (!themeToggle) return;
    const current = document.documentElement.getAttribute('data-theme');
    themeToggle.textContent = current === 'dark' ? '🌙' : '☀';
  }

  themeToggle?.addEventListener('click', () => {
    const current = document.documentElement.getAttribute('data-theme');
    const next = current === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
    updateToggleIcon();
  });

  updateToggleIcon();

  // 0.1%招待状オーバーレイ: 記事カードクリック時にサクラの部屋への招待状を表示
  (function() {
    function showArticleInvitation() {
      const invOverlay = document.createElement('div');
      invOverlay.id = 'article-invitation-overlay';
      invOverlay.innerHTML = `
        <div class="invitation-modal">
          <div class="invitation-letter">
            <div class="letter-header">✉️ 招待状が届きました</div>
            <div class="letter-body">
              <p>🌸 <strong>サクラの部屋</strong>へご招待</p>
              <p style="font-size:0.9em; color:var(--text-muted)">
                「あなたに会いたいな…こっそり教えてあげます」
              </p>
            </div>
            <button id="article-invite-btn">サクラの部屋へ</button>
            <button id="article-invite-close" style="background:transparent;color:var(--text-muted);margin-top:8px;font-size:0.8em;cursor:pointer;">今は行かない</button>
          </div>
        </div>
      `;
      document.body.appendChild(invOverlay);

      document.getElementById('article-invite-btn').addEventListener('click', () => {
        sessionStorage.setItem('sakura_room_via_redirect', 'true');
        window.location.href = '/sakura-room/';
      });

      document.getElementById('article-invite-close').addEventListener('click', () => {
        invOverlay.remove();
      });
    }

    document.addEventListener('click', (e) => {
      const link = e.target.closest('a');
      if (!link) return;
      const href = link.getAttribute('href') || '';
      const isArticleLink = href.includes('/posts/') || link.closest('.article-card');
      if (!isArticleLink) return;
      if (Math.random() < 0.3) {
        e.preventDefault();
        showArticleInvitation();
      }
    });
  })();

  // 隠しリンク（サクラの部屋）クリック時にフラグを立てる
  document.querySelectorAll('a.hidden-link[href="/sakura-room/"]').forEach(link => {
    link.addEventListener('click', () => {
      sessionStorage.setItem('sakura_room_via_link', 'true');
    });
  });

  // 🎨工房リンク（/prompt-builder/）クリック時にフラグを立てる
  document.querySelectorAll('a[href="/prompt-builder/"]').forEach(link => {
    link.addEventListener('click', () => {
      sessionStorage.setItem('prompt_builder_via_nav', 'true');
    });
  });
</script>

<!-- Cloudflare Web Analytics -->
<script defer src='https://static.cloudflareinsights.com/beacon.min.js'
  data-cf-beacon='{"token": "e38061c395ac4765a0b26d9395654415"}'></script>

</body>
</html>
